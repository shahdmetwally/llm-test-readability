def test_maybe_chaining_with_none_value_and_bytes():
    """
    Test chaining of Maybe monad operations (ap, bind, to_validation,
    to_either, to_try) when the wrapped value is None or bytes, verifying
    that the monadic interface handles absent and present values consistently.
    """
    raw_bytes = b"\xdbC\xcf\xe7/"
    none_value = None
    is_just = True

    # Create a Maybe with no value (Nothing-like), using is_just=True
    maybe_none = maybe.Maybe(none_value, is_just)

    # Chain ap calls on a Maybe wrapping None
    applied_once = maybe_none.ap(none_value)
    applied_twice = applied_once.ap(raw_bytes)

    # Convert the chained Maybe to a Validation
    validation_from_chained = applied_twice.to_validation()

    # Create a Maybe wrapping bytes as its value
    maybe_bytes = maybe.Maybe(none_value, raw_bytes)

    # Exercise get_or_else: since value is falsy, should return the fallback
    fallback_result = maybe_bytes.get_or_else(maybe_bytes)

    # Convert maybe_bytes to various monad types
    validation_from_bytes = maybe_bytes.to_validation()

    # Bind using the validation (callable) as the next step
    bound_result = maybe_bytes.bind(validation_from_bytes)

    # Convert to Either for equality comparison
    either_result = maybe_bytes.to_either()

    # Apply maybe_bytes as a function container to itself
    ap_self_result = maybe_bytes.ap(maybe_bytes)

    negative_int = -3289

    # Compare Either with Validation (expected to produce a bool result)
    either_eq_validation = either_result.__eq__(validation_from_bytes)

    # Bind the Either with a Maybe (exercises cross-monad bind)
    either_bound = either_result.bind(maybe_bytes)

    # Convert maybe_bytes to Try
    try_result = maybe_bytes.to_try()

    # Compare maybe_bytes with the bound Maybe result
    maybe_eq_bound = maybe_bytes.__eq__(bound_result)

    # Convert the bound Maybe to Validation
    bound_validation = bound_result.to_validation()

    # Apply an integer to the Try (exercises ap on Try with a plain int)
    try_result.ap(negative_int)
```
