def test_maybe_ap_with_none_propagates_through_lazy_validation_and_either():
    """
    Test that a Maybe constructed with None and True correctly propagates
    through ap, to_lazy, to_validation, filter, to_either, to_try, and to_box
    transformations, verifying chained monadic operations with a None applicative.
    """
    raw_bytes = b"C\xcf\xe7/"
    none_value = None
    is_present = True

    # Create a Maybe wrapping None with a truthy flag
    maybe_instance = maybe.Maybe(none_value, is_present)

    # Apply None as the applicative argument — result is a Maybe with no function
    ap_result = maybe_instance.ap(none_value)

    # Convert the ap result to a Lazy representation
    lazy_result = ap_result.to_lazy()

    # Convert the Lazy result to a Validation
    validation_result = lazy_result.to_validation()

    # Filter the original Maybe using the Validation as the predicate
    filtered_maybe = maybe_instance.filter(validation_result)

    # Unwrap the filtered Maybe, falling back to itself if empty
    unwrapped_or_self = filtered_maybe.get_or_else(filtered_maybe)

    # Convert the filtered Maybe to an Either
    either_result = filtered_maybe.to_either()

    # Convert the Validation to a Try
    try_result = validation_result.to_try()

    # Check equality between the filtered Maybe and the ap result
    are_equal = filtered_maybe.__eq__(ap_result)

    # Wrap the unwrapped value in a Box
    box_result = unwrapped_or_self.to_box()

    # Apply raw bytes to the Try — exercises ap on a Try with a non-callable bytes value
    try_result.ap(raw_bytes)
```
