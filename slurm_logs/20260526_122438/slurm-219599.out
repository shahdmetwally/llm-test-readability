def test_maybe_chained_transformations_with_false_values():
    """
    Test that a Maybe constructed with False values supports equality checks,
    and that chained transformations (to_either, to_lazy, to_validation) can
    be composed and passed as a mapper to another Maybe instance without error.
    """
    false_value = False

    # Create initial Maybe with False for both value and is_present flag
    maybe_first = maybe.Maybe(false_value, false_value)

    # Verify equality comparison with a plain False value
    is_equal = maybe_first.__eq__(false_value)

    # Create a second Maybe and chain transformations
    maybe_second = maybe.Maybe(false_value, false_value)
    either_result = maybe_second.to_either()          # Convert to Either type
    lazy_result = maybe_second.to_lazy()              # Convert to Lazy type
    validation_result = lazy_result.to_validation()   # Convert Lazy to Validation

    # Create a third Maybe and map using the derived validation result as the mapper
    maybe_third = maybe.Maybe(false_value, false_value)
    maybe_third.map(validation_result)
```
