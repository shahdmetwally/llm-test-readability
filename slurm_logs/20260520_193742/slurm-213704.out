import pytest
import validation as validation
import builtins as builtins

def test_validation_creation_with_docstring_text_checks_success_fail_and_maybe_conversion():
    """
    Test that a Validation object created with docstring-like text
    correctly reports success/failure state and supports conversion
    to a Maybe type via to_maybe().
    """
    # Use a docstring-style string as both the value and error message
    docstring_text = "\n        Create empty maybe.\n\n        :returns: Maybe[None]\n        "

    # Create a Validation instance with identical value and error text
    validation_instance = validation.Validation(docstring_text, docstring_text)

    # Check that the validation reports success
    is_success_result = validation_instance.is_success()

    # Check equality of the validation instance with itself
    is_equal_to_self = validation_instance.__eq__(validation_instance)

    # Check that the validation reports failure
    is_fail_result = validation_instance.is_fail()

    # Convert the failure result to a Maybe type
    is_fail_result.to_maybe()

def test_validation_eq_with_none_returns_result_with_is_success():
    """Test that comparing a Validation instance to None returns a result
    on which is_success() can be called without error."""

    # Inputs: a negative integer and a tuple used to construct the Validation
    none_value = None
    negative_int = -6891
    positive_int = 3125
    args_tuple = (positive_int,)

    # Create a Validation instance with the given integer and tuple
    validation_instance = validation.Validation(negative_int, args_tuple)

    # Compare the Validation instance to None using __eq__
    eq_result = validation_instance.__eq__(none_value)

    # Invoke is_success() on the comparison result
    eq_result.is_success()

def test_validation_str_representation_is_fail_with_empty_dicts():
    """Test that a Validation instance created with empty dicts returns a
    string representation whose is_fail() method can be called without error."""
    empty_dict = {}

    # Create a Validation instance with empty schema and data
    validation_instance = validation.Validation(empty_dict, empty_dict)

    # Obtain the string representation of the validation result
    str_representation = validation_instance.__str__()

    # Verify the fail-status check is callable on the string representation
    str_representation.is_fail()

def test_validation_with_empty_sets_converts_to_either_and_maybe():
    """Test that a Validation built from empty sets can be converted to Either and Maybe,
    and that chaining to_maybe() on the result is also valid."""
    empty_set = set()

    # Create a Validation with no successes and no failures
    empty_validation = validation.Validation(empty_set, empty_set)

    # Convert to Either and Maybe representations
    either_result = empty_validation.to_either()
    maybe_result = empty_validation.to_maybe()

    # Chain to_maybe() on the Maybe result to verify it is also supported
    maybe_result.to_maybe()

def test_validation_failure_supports_equality_either_and_maybe_conversion():
    """
    Test that a Validation created with a failure message supports
    equality comparison, conversion to Either, and that is_fail()
    result can be converted to Maybe.
    """
    # Use the docstring of 'Create empty maybe' as both the value and message
    failure_message = "\n        Create empty maybe.\n\n        :returns: Maybe[None]\n        "

    # Create a Validation instance with the failure message as both arguments
    validation_instance = validation.Validation(failure_message, failure_message)

    # Convert the validation to an Either type
    either_result = validation_instance.to_either()

    # Check equality of the validation with itself
    is_equal = validation_instance.__eq__(validation_instance)

    # Check if the validation represents a failure
    is_failure = validation_instance.is_fail()

    # Convert the failure result to a Maybe type
    is_failure.to_maybe()

def test_validation_with_empty_sets_chained_to_maybe():
    """Test that a Validation created from empty sets can be converted to Maybe,
    and that the resulting Maybe can also be converted to Maybe (chaining)."""
    empty_set = set()

    # Create a Validation with no successes and no failures
    validation_instance = validation.Validation(empty_set, empty_set)

    # Convert the Validation to a Maybe
    maybe_result = validation_instance.to_maybe()

    # Chain another to_maybe call on the resulting Maybe
    maybe_result.to_maybe()

def test_validation_init_with_none_arguments():
    """Test that Validation can be instantiated with None for both arguments."""
    # Both positional arguments are explicitly None
    none_value = None
    validation_0 = validation.Validation(none_value, none_value)

def test_validation_to_maybe_with_none_inputs():
    """Test that Validation.to_maybe() can be called when both fields are None."""
    # Create a Validation instance with no value and no error (both None)
    none_value = None
    validation_instance = validation.Validation(none_value, none_value)

    # Convert the None-initialised Validation to a Maybe type
    validation_instance.to_maybe()

def test_validation_is_fail_with_plain_object():
    """Test that Validation.is_fail() can be called when both arguments are plain objects."""
    # Create a base object to use as both the value and context
    plain_object = builtins.object()

    # Construct a Validation instance with the plain object for both arguments
    val = validation.Validation(plain_object, plain_object)

    # Verify that is_fail() can be invoked without error
    val.is_fail()

def test_validation_map_with_none_on_nested_structure():
    """Test that calling map(None) on a Validation wrapping a nested structure executes without error."""
    # Build a nested input: a tuple containing a dict (keyed by a tuple) and an int
    int_value = -895
    bool_value = True
    inner_tuple = (int_value, bool_value)
    nested_dict = {inner_tuple: inner_tuple}
    nested_structure = (nested_dict, nested_dict, int_value)

    # Create a Validation instance wrapping the nested structure with a truthy flag
    validation_instance = validation.Validation(nested_structure, bool_value)

    # Map None over the Validation — exercising map with no transformer
    validation_instance.map(None)

def test_validation_bind_with_none_value():
    """Test that Validation.bind() accepts None as a binding value without error."""

    # Use identical byte sequences for both constructor arguments
    raw_bytes = b"s\x8flul\xd1p\x86\xe0<q\xd9\xb2\xf6\x17EC\xaf\xd0"

    # Create a Validation instance with the raw bytes as both arguments
    val = validation.Validation(raw_bytes, raw_bytes)

    # Bind None to the validation object
    none_value = None
    val.bind(none_value)

def test_validation_ap_with_all_true_values():
    """Test that ap() can be called on a Validation instance constructed with all-True values."""
    is_valid = False
    flag = True

    # A list of four True flags used as both the validation errors and the applied value
    all_true_flags = [flag, flag, flag, flag]

    # Create a Validation instance that is marked invalid but carries the all-True list
    validation_instance = validation.Validation(is_valid, all_true_flags)

    # Apply the all-True list to the validation instance
    validation_instance.ap(all_true_flags)

def test_validation_with_both_flags_true_converts_to_successful_box():
    """Test that a Validation created with both flags set to True produces a successful Box."""
    is_valid = True

    # Create a Validation instance with both constructor flags set to True
    valid_validation = validation.Validation(is_valid, is_valid)

    # Convert the Validation to a Box and verify it represents a success
    result_box = valid_validation.to_box()
    result_box.is_success()

def test_validation_to_lazy_bind_none_then_to_lazy():
    """Test that a Validation created with empty lists can be converted to lazy,
    bound with None, and then converted to lazy again without error."""

    # Create an empty validation with no successes and no failures
    empty_list = []
    empty_validation = validation.Validation(empty_list, empty_list)

    # Convert the validation to a lazy representation
    lazy_validation = empty_validation.to_lazy()

    # Bind None to the lazy validation
    bound_lazy = lazy_validation.bind(None)

    # Convert the bound lazy validation to lazy again
    bound_lazy.to_lazy()

def test_validation_lazy_and_try_conversions_with_ap():
    """Test that a Validation can be converted to Lazy and Try,
    and that ap() can be applied with the original Validation."""

    # Create an empty Validation (both value and errors are empty dicts)
    empty_dict = {}
    empty_validation = validation.Validation(empty_dict, empty_dict)

    # Convert the Validation to its Lazy representation
    lazy_validation = empty_validation.to_lazy()

    # Convert the Lazy representation to a Try
    try_validation = lazy_validation.to_try()

    # Apply the original Validation as an applicative argument to the Lazy
    ap_result = lazy_validation.ap(empty_validation)

    # Check the success state of the Try conversion
    try_validation.is_success()

def test_validation_with_zero_value_in_list_is_success():
    """Test that a Validation created with a zero integer value and a single-element list
    can be converted to a Try and reports success."""
    zero_value = 0
    single_item_list = [zero_value]

    # Create a Validation with a zero integer and a list containing that value
    val = validation.Validation(zero_value, single_item_list)

    # Convert to Try and verify the result is a success
    try_result = val.to_try()
    try_result.is_success()

def test_validation_chained_operations_with_mixed_types():
    """
    Test that Validation objects can be constructed with mixed types (None, bytes, bool)
    and that chained operations (eq, to_box, to_either, to_try, to_lazy, is_fail, map)
    execute without error, covering interplay between multiple Validation instances.
    """
    # Arbitrary bytes value used as a payload/key in Validation construction
    raw_bytes = b"\xcc\xf7\x0e\x04\xc8Y\xc1 N\xbb\xa6\x85\x97\x90\x9e"
    none_value = None

    # A dict with mixed-type keys to serve as the 'value' argument
    mixed_dict = {none_value: raw_bytes, raw_bytes: raw_bytes}

    # Validation with None as the 'is_success' indicator and a mixed dict as value
    validation_none_key = validation.Validation(none_value, mixed_dict)

    # Test equality of a Validation instance with itself
    eq_result = validation_none_key.__eq__(validation_none_key)

    # Convert to Box; will be reused for further chained conversions
    boxed = validation_none_key.to_box()

    # A second Validation instance using raw bytes for both arguments
    validation_bytes = validation.Validation(raw_bytes, raw_bytes)

    # Chain: Box -> Either -> Try
    either_from_box = boxed.to_either()
    is_fail_result = validation_bytes.is_fail()
    try_from_either = either_from_box.to_try()

    # Validation whose 'is_success' flag is derived from is_fail_result (a bool)
    validation_from_bool = validation.Validation(is_fail_result, raw_bytes)

    # String representation of the bool-keyed Validation
    str_repr = validation_from_bool.__str__()

    # Convert bytes-based Validation to Lazy
    lazy_from_bytes_validation = validation_bytes.to_lazy()

    # Another bytes-based Validation, used as a nested value
    validation_bytes_nested = validation.Validation(raw_bytes, raw_bytes)

    # Re-derive Either from the original boxed value (second call, same source)
    either_from_box_again = boxed.to_either()

    # Convert the bool-keyed Validation to Lazy; used as constructor arg below
    lazy_from_bool_validation = validation_from_bool.to_lazy()

    # Validation whose value is the nested Validation object
    validation_nested = validation.Validation(lazy_from_bool_validation, validation_bytes_nested)

    # Check is_fail on the bytes-based Validation a second time
    is_fail_result_again = validation_bytes.is_fail()

    # Map the string representation over the eq_result (a Validation)
    eq_result.map(str_repr)

def test_validation_equality_and_maybe_conversion_with_none_key():
    """
    Test that Validation handles equality checks and to_maybe conversion
    when constructed with None as the value and a mixed-key dict as the error,
    and that bind can be called on a bytes-based Validation instance.
    """
    # Arbitrary bytes used as a stand-in value/error payload
    arbitrary_bytes = b"\xcc\xf7\x0e\x04\xc8Y\xc1 N\xbb\xa6\x85\x97\x90\x9e"
    none_value = None

    # Dict with None and bytes keys, used as the error container
    error_dict = {none_value: arbitrary_bytes, arbitrary_bytes: arbitrary_bytes}

    # Construct a Validation with None as the value and the mixed dict as the error
    validation_with_none = validation.Validation(none_value, error_dict)

    # Verify equality of the instance with itself
    eq_result = validation_with_none.__eq__(validation_with_none)

    # Convert to a Maybe representation
    maybe_result = validation_with_none.to_maybe()

    # Construct a second Validation using bytes for both value and error
    validation_with_bytes = validation.Validation(arbitrary_bytes, arbitrary_bytes)

    # Attempt to bind bytes directly (exercises the bind code path)
    validation_with_bytes.bind(arbitrary_bytes)

def test_validation_eq_with_mismatched_none_and_bytes_calls_to_box():
    """
    Test that comparing two Validation instances with swapped None/bytes
    arguments via __eq__ returns a result on which .to_box() can be called.
    """
    raw_bytes = b"\xcc\xf7\x0e\x04\xc8Y\xc1 N\xbb\xa6\x85\x97\x90\x9e"
    none_value = None

    # Build a dict keyed by both None and the bytes value
    mixed_dict = {none_value: raw_bytes, raw_bytes: raw_bytes}

    # First validation: None as primary, dict as secondary
    validation_with_none_primary = validation.Validation(none_value, mixed_dict)
    # Second validation: bytes as primary, None as secondary (arguments swapped)
    validation_with_bytes_primary = validation.Validation(raw_bytes, none_value)

    # Compare the two mismatched Validation instances
    eq_result = validation_with_none_primary.__eq__(validation_with_bytes_primary)

    # Ensure the equality result can be boxed without error
    eq_result.to_box()
