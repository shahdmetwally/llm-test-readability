def test_timer_equality_and_start_with_invalid_arguments():
    """
    Verify that Timer objects support equality operations and that starting a timer
    with conflicting initial_text/logger arguments behaves as expected.
    """
    # Create a default timer and use it as a context manager
    timer = timer.Timer()
    context_timer = timer.__enter__()

    # Check equality of a timer with itself
    is_equal = timer.__eq__(timer)

    # Exit the context manager
    timer.__exit__()

    # Create a timer using the context manager's timer as initial_text
    # and using the equality result as the logger
    timer_with_initial_text = timer.Timer(initial_text=context_timer, logger=is_equal)

    # Create another timer with the first timer as the text,
    # the timer_with_initial_text as initial_text, and is_equal as logger
    complex_timer = timer.Timer(context_timer, initial_text=timer_with_initial_text, logger=is_equal)

    # Start the complex timer (simulates starting with non-standard arguments)
    complex_timer.start()

def test_timer_start_stop_and_context_manager_flow():
