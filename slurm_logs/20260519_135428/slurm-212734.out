        post_process_response:  def test_enter_and_exit_methods_should_behave_like_context_manager():
    """Test that enter and exit methods behave as a context manager. """

    # Initialize a Timer, enter and exit it.
    with module_timer.Timer() as timer:
        timer: module_timer.Timer
        timer.__enter__: Callable[[], module_timer.Timer]

    # Check that the timer has been stopped.
    assert math.isnan(timer.last), 'Timer has not started.'

    # Check that the timer has been stopped.
    assert not math.isnan(timer.last), 'Timer has not stopped.'

    # Call exit method and assert if it returns None.
    assert timer.__exit__() is None, 'Timer exit method is not returning None.'

    # Check that the timer has not been restarted.
    assert not math.isnan(timer.last), 'Timer has been unexpectedly restarted.'   


