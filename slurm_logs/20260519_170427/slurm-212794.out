    namedtuple_from_tuple = namedtuple_utils.to_namedtuple(mixed_tuple)
    namedtuple_from_dict_fourth = namedtuple_utils.to_namedtuple(ordered_dict)

def test_to_namedtuple_with_invalid_string_keys_to_namedtuple():
    """Test that to_namedtuple handles an OrderedDict created with invalid string keys,
