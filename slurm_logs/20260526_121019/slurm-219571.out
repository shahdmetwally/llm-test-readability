def test_maybe_ap_with_none_value_chains_through_lazy_validation_and_either():
    """
    Test that a Maybe constructed with None and True correctly propagates
    through ap, to_lazy, to_validation, filter, get_or_else, to_either,
    to_try, and to_box transformations, including equality comparison.
    """
    raw_bytes = b"C\xcf\xe7/"
    none_value = None
    bool_flag = True

    # Create a Maybe wrapping None with a truthy flag
    maybe_instance = maybe.Maybe(none_value, bool_flag)

    # Apply None as a function via ap — results in another Maybe-like container
    ap_result = maybe_instance.ap(none_value)

    # Convert the ap result to a lazy representation
    lazy_result = ap_result.to_lazy()

    # Convert the lazy result to a validation container
    validation_result = lazy_result.to_validation()

    # Filter the original maybe using the validation result as a predicate
    filtered_maybe = maybe_instance.filter(validation_result)

    # Unwrap with a fallback of itself when empty
    get_or_else_result = filtered_maybe.get_or_else(filtered_maybe)

    # Convert the filtered maybe to an Either (Left/Right)
    either_result = filtered_maybe.to_either()

    # Convert the validation result to a Try container
    try_result = validation_result.to_try()

    # Check equality between filtered_maybe and the ap result
    are_equal = filtered_maybe.__eq__(ap_result)

    # Wrap the get_or_else result in a Box container
    box_result = get_or_else_result.to_box()

    # Apply raw bytes to the try container
    try_result.ap(raw_bytes)
```
Stream finished.
