    empty_tuple = ()
    nested_dict = {key_str: empty_tuple, empty_tuple: empty_tuple}
    inner_tuple = (key_str, nested_dict)
    input_list = [inner_tuple]

    # Convert the list to a namedtuple structure
    namedtuple_result = namedtupleutils.to_namedtuple(input_list)

    # Apply to_namedtuple again to verify idempotency (already a namedtuple)
    namedtuple_result_second = namedtupleutils.to_namedtuple(namedtuple_result)

    # Apply once more to further confirm stable idempotent behaviour
    namedtuple_result_third = namedtupleutils.to_namedtuple(namedtuple_result_second)

    # Verify that a plain integer is handled without error
    plain_int = 2
    namedtupleutils.to_namedtuple(plain_int)   


