def test_to_namedtuple_with_nested_dicts_and_bool_input() -> None:
    """
    Test that to_namedtuple can handle nested conversions:
    - A dict with a single key containing a docstring-like string
    - A tuple containing a namedtuple
    - A dict with mixed key types (namedtuple and bool)
    - A namedtuple input (should be idempotent)
    - A plain bool input (edge case)
    """
    # A long docstring used as a dictionary key/value
    str_0 = "Normalize a given path.\n\n    The given ``path`` will be normalized in the following process.\n\n    #. :obj:`bytes` will be converted to a :obj:`str` using the encoding\n       given by :obj:`getfilesystemencoding() <sys.getfilesystemencoding>`.\n    #. :obj:`PosixPath <pathlib.PosixPath>` and\n       :obj:`WindowsPath <pathlib.WindowsPath>` will be converted\n       to a :obj:`str` using the :obj:`as_posix() <pathlib.PurePath.as_posix>`\n       method.\n    #. An initial component of ``~`` will be replaced by that user's\n       home directory.\n    #. Any environment variables will be expanded.\n    #. Non absolute paths will have the current working directory from\n       :obj:`os.getcwd() <os.cwd>`prepended.  If needed, use\n       :obj:`os.chdir() <os.chdir>` to change the current working directory\n       before calling this function.\n    #. Redundant separators and up-level references will be normalized, so\n       that ``A//B``, ``A/B/``, ``A/./B`` and ``A/foo/../B`` all become\n       ``A/B``.\n\n    Args:\n        path (:obj:`str`, :obj:`bytes` or :obj:`Path <pathlib.Path>`):\n            The path to be normalized.\n\n    :rtype:\n        :obj:`Path <pathlib.Path>`\n\n        * :obj:`PosixPath <pathlib.PosixPath>` or\n          :obj:`WindowsPath <pathlib.WindowsPath>` depending on the system.\n\n        .. Note:: :obj:`Path <pathlib.Path>` objects are immutable. Therefore,\n           any given ``path`` of type :obj:`Path <pathlib.Path>` will not be\n           the same object returned.\n\n    Example:\n\n        >>> from flutils.pathutils import normalize_path\n        >>> normalize_path('~/tmp/foo/../bar')\n        PosixPath('/home/test_user/tmp/bar')\n\n    "
    
    # Create a dict with the same key repeated three times (effectively a single-entry dict)
    input_dict = {str_0: str_0, str_0: str_0, str_0: str_0}
    
    # Convert the dict to a namedtuple
    namedtuple_from_dict = module_0.to_namedtuple(input_dict)
    
    # Convert the same dict again (testing idempotency for identical inputs)
    namedtuple_from_dict_again = module_0.to_namedtuple(input_dict)
    
    # Package the second namedtuple into a tuple and convert that tuple
    tuple_wrapping_namedtuple = (namedtuple_from_dict_again,)
    namedtuple_from_tuple = module_0.to_namedtuple(tuple_wrapping_namedtuple)
    
    # Create a dict with mixed key types (namedtuple and bool), convert it
    bool_false = False
    mixed_key_dict = {namedtuple_from_tuple: namedtuple_from_dict_again, bool_false: namedtuple_from_dict_again}
    namedtuple_from_mixed_keys = module_0.to_namedtuple(mixed_key_dict)
    
    # Convert a namedtuple back to a namedtuple (idempotent operation)
    namedtuple_from_namedtuple = module_0.to_namedtuple(namedtuple_from_mixed_keys)
    
    # Convert the same namedtuple again
    namedtuple_from_namedtuple_again = module_0.to_namedtuple(namedtuple_from_mixed_keys)
    
    # Edge case: convert a plain bool to a namedtuple
    module_0.to_namedtuple(False)
```
