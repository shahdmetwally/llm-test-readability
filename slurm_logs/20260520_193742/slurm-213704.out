import pytest
import validation as validation
import builtins as builtins

def test_validation_with_identical_success_and_fail_messages_converts_to_maybe():
    """
    Test that a Validation created with identical success and fail messages
    correctly reports its success/fail state and can be converted to Maybe.
    """
    # Use the same string for both success and fail message fields
    empty_maybe_description = (
        "\n        Create empty maybe.\n\n        :returns: Maybe[None]\n        "
    )

    # Create a Validation instance with identical success and fail messages
    val = validation.Validation(empty_maybe_description, empty_maybe_description)

    # Check success state
    is_success = val.is_success()

    # Check equality with itself
    is_equal_to_self = val.__eq__(val)

    # Check fail state and convert result to Maybe
    fail_result = val.is_fail()
    fail_result.to_maybe()

def test_validation_eq_with_none_returns_result_with_is_success():
    """Test that comparing a Validation instance to None returns a result
    on which is_success() can be called without error."""

    # A None value used as the comparison target
    none_value = None

    # Construct a Validation with a negative integer and a single-element tuple
    negative_int = -6891
    positive_int = 3125
    single_element_tuple = (positive_int,)
    validation_instance = validation.Validation(negative_int, single_element_tuple)

    # Compare the Validation instance to None using __eq__
    eq_result = validation_instance.__eq__(none_value)

    # Call is_success() on the result of the equality comparison
    eq_result.is_success()

def test_validation_str_representation_is_fail_on_empty_dicts():
    """Test that __str__ on a Validation with empty dicts returns an object on which is_fail() can be called."""
    empty_dict = {}

    # Create a Validation instance using two empty dicts (no rules, no data)
    validation_instance = validation.Validation(empty_dict, empty_dict)

    # Obtain the string representation as a Validation result object
    str_result = validation_instance.__str__()

    # Check whether the result is a failure
    str_result.is_fail()

def test_validation_with_empty_sets_converts_to_either_and_maybe():
    """Test that a Validation built from empty sets can be converted to Either and Maybe types,
    and that calling to_maybe() on the resulting Maybe is a valid no-op chained call."""
    empty_set = set()

    # Create a Validation instance with no successes and no failures
    v = validation.Validation(empty_set, empty_set)

    # Convert to Either and Maybe representations
    either_result = v.to_either()
    maybe_result = v.to_maybe()

    # Verify that chaining to_maybe() on the Maybe result is also valid
    maybe_result.to_maybe()

def test_validation_equality_and_conversion_methods():
    """
    Test that a Validation object created with a failure message supports
    equality comparison, conversion to Either, and conversion to Maybe
    without errors.
    """
    # A descriptive string used as both the value and error of the Validation
    failure_message = "\n        Create empty maybe.\n\n        :returns: Maybe[None]\n        "

    # Create a Validation instance with the same string as value and error
    validation_instance = validation.Validation(failure_message, failure_message)

    # Convert to Either representation
    either_result = validation_instance.to_either()

    # Check equality of the validation instance with itself
    is_equal = validation_instance.__eq__(validation_instance)

    # Check if the validation represents a failure
    is_failure = validation_instance.is_fail()

    # Convert the failure result to a Maybe representation
    is_failure.to_maybe()

def test_validation_with_empty_sets_chained_to_maybe():
    """Test that a Validation constructed from empty sets can be converted
    to a Maybe value, and that the resulting Maybe can also be converted
    to a Maybe (chained call)."""
    empty_set = set()

    # Create a Validation instance with empty valid and invalid sets
    val = validation.Validation(empty_set, empty_set)

    # Convert the Validation to a Maybe
    maybe_value = val.to_maybe()

    # Chain a further to_maybe() call on the resulting Maybe
    maybe_value.to_maybe()

def test_validation_init_with_none_arguments():
    """Test that Validation can be instantiated with None for both arguments."""
    # Both schema and value are explicitly None
    none_value = None
    validation_0 = validation.Validation(none_value, none_value)

def test_validation_to_maybe_with_none_inputs():
    """Test that Validation.to_maybe() can be called when both fields are None."""
    # Create a Validation instance with no value and no error (both None)
    none_value = None
    validation_instance = validation.Validation(none_value, none_value)

    # Convert the None-valued Validation to a Maybe type
    validation_instance.to_maybe()

def test_validation_is_fail_with_same_object_for_both_args():
    """Test that Validation.is_fail() can be called when both constructor
    arguments are the same plain object instance."""
    # Create a plain base object to use as both validation arguments
    base_object = builtins.object()

    # Construct a Validation instance with the same object for both parameters
    val = validation.Validation(base_object, base_object)

    # Verify that is_fail() can be invoked without error
    val.is_fail()

def test_validation_map_with_none_on_nested_structure():
    """Test that calling map() with None on a Validation wrapping a nested structure executes without error."""

    # Build a nested input: a tuple containing a dict (keyed by a tuple) and an int
    value_int = -895
    value_bool = True

    inner_tuple = (value_int, value_bool)
    nested_dict = {inner_tuple: inner_tuple}
    outer_tuple = (nested_dict, nested_dict, value_int)

    # Construct a Validation instance with the nested structure and a truthy flag
    v = validation.Validation(outer_tuple, value_bool)

    # Map None over the Validation — exercises map() with a None mapper
    v.map(None)

def test_validation_bind_with_none_value():
    """Test that Validation.bind() accepts None as a bound value without error."""
    # Use identical byte sequences for both constructor arguments
    raw_bytes = b"s\x8flul\xd1p\x86\xe0<q\xd9\xb2\xf6\x17EC\xaf\xd0"
    validator = validation.Validation(raw_bytes, raw_bytes)

    # Bind None to the validator (testing null/unset binding behaviour)
    bound_value = None
    validator.bind(bound_value)

def test_validation_ap_with_all_true_values():
    """Test that Validation.ap() can be called with a list of True values on a Failure instance."""
    # Create a Failure validation (is_success=False)
    is_success = False
    all_true = True

    # Build a list of all-True values to use as both the error list and the ap argument
    true_values = [all_true, all_true, all_true, all_true]

    # Construct a Validation instance in the failure state with the true_values list
    failure_validation = validation.Validation(is_success, true_values)

    # Apply ap() with the same list of true values
    failure_validation.ap(true_values)

def test_validation_with_both_flags_true_converts_to_successful_box():
    """Test that a Validation created with both flags set to True can be converted
    to a box and reports success."""
    is_valid = True
    # Create a Validation instance where both parameters indicate a valid/success state
    valid_validation = validation.Validation(is_valid, is_valid)

    # Convert the validation result to a box representation
    box = valid_validation.to_box()

    # Verify the box reflects a successful outcome
    box.is_success()

def test_validation_to_lazy_bind_with_none_then_to_lazy():
    """Test that a Validation created with empty lists can be converted to lazy,
    bound with None, and then converted to lazy again without error."""
    none_value = None
    empty_list = []

    # Create a Validation with empty approved and rejected lists
    empty_validation = validation.Validation(empty_list, empty_list)

    # Convert the validation to a lazy form
    lazy_validation = empty_validation.to_lazy()

    # Bind None to the lazy validation
    bound_result = lazy_validation.bind(none_value)

    # Convert the bound result to lazy again
    bound_result.to_lazy()

def test_validation_lazy_and_try_conversions_with_ap():
    """Test that a Validation can be converted to lazy and try forms,
    and that ap() can be applied with another Validation without error."""

    # Create an empty Validation (no data, no errors)
    empty_dict = {}
    empty_validation = validation.Validation(empty_dict, empty_dict)

    # Convert the Validation to its lazy (deferred) representation
    lazy_validation = empty_validation.to_lazy()

    # Convert the lazy form to a Try (success/failure) representation
    try_validation = lazy_validation.to_try()

    # Apply the original Validation as an applicative over the lazy form
    ap_result = lazy_validation.ap(empty_validation)

    # Check that the try representation reports success
    try_validation.is_success()

def test_validation_with_zero_value_in_list_is_success():
    """Test that a Validation created with a zero value and a single-element list
    can be converted to a Try and reports success."""
    zero_value = 0
    single_item_list = [zero_value]

    # Create a Validation instance using the zero value and the list
    v = validation.Validation(zero_value, single_item_list)

    # Convert to a Try and verify the result is successful
    try_result = v.to_try()
    try_result.is_success()

def test_validation_chained_operations_with_mixed_types():
    """
    Test that Validation supports chaining of operations (eq, to_box, to_either,
    to_try, to_lazy, is_fail, __str__, map) across multiple instances constructed
    with mixed types (None, bytes, and derived values), without raising errors.
    """
    # Arbitrary bytes value used as a payload/error value throughout the test
    arbitrary_bytes = b"\xcc\xf7\x0e\x04\xc8Y\xc1 N\xbb\xa6\x85\x97\x90\x9e"

    none_value = None

    # Dict with mixed keys (None and bytes) mapping to bytes — used as a success value
    mixed_dict = {none_value: arbitrary_bytes, arbitrary_bytes: arbitrary_bytes}

    # Validation constructed with None as the fail indicator and a dict as value
    validation_none_dict = validation.Validation(none_value, mixed_dict)

    # Check equality of the validation with itself
    eq_result = validation_none_dict.__eq__(validation_none_dict)

    # Convert to Box and then to Either and Try for further chaining
    box_result = validation_none_dict.to_box()

    # Validation constructed with bytes as both fail and success values
    validation_bytes = validation.Validation(arbitrary_bytes, arbitrary_bytes)

    # Convert the box to an Either
    either_result = box_result.to_either()

    # Check if the bytes-based validation represents a failure
    is_fail_result = validation_bytes.is_fail()

    # Convert the Either to a Try
    try_result = either_result.to_try()

    # Validation constructed using the is_fail boolean result and bytes
    validation_from_fail = validation.Validation(is_fail_result, arbitrary_bytes)

    # Get string representation of the validation built from is_fail
    str_result = validation_from_fail.__str__()

    # Convert the bytes validation to a Lazy
    lazy_from_bytes = validation_bytes.to_lazy()

    # Another Validation with bytes for both arguments
    validation_bytes_2 = validation.Validation(arbitrary_bytes, arbitrary_bytes)

    # Re-convert the box to Either (second conversion, same source)
    either_result_2 = box_result.to_either()

    # Convert the fail-based validation to Lazy
    lazy_from_fail = validation_from_fail.to_lazy()

    # Validation constructed from a Lazy value and another Validation instance
    validation_from_lazy = validation.Validation(lazy_from_fail, validation_bytes_2)

    # Check is_fail on the bytes validation again
    is_fail_result_2 = validation_bytes.is_fail()

    # Map the string representation over the equality result
    eq_result.map(str_result)

def test_validation_equality_and_maybe_with_none_key_and_bytes_value():
    """
    Test Validation behaviour when constructed with None as the value and a dict
    (keyed by None and bytes) as the error. Verifies that __eq__ and to_maybe
    work on such an instance, and that bind can be called on a bytes-valued Validation.
    """
    # Raw bytes used as both a dict value and a Validation value
    raw_bytes = b"\xcc\xf7\x0e\x04\xc8Y\xc1 N\xbb\xa6\x85\x97\x90\x9e"

    none_value = None

    # Error dict maps None -> bytes and bytes -> bytes
    error_dict = {none_value: raw_bytes, raw_bytes: raw_bytes}

    # Construct a Validation with None as the wrapped value and the dict as the error
    validation_with_none = validation.Validation(none_value, error_dict)

    # Check self-equality
    eq_result = validation_with_none.__eq__(validation_with_none)

    # Convert to Maybe representation
    maybe_result = validation_with_none.to_maybe()

    # Construct a second Validation where both value and error are raw bytes
    validation_with_bytes = validation.Validation(raw_bytes, raw_bytes)

    # Call bind with raw_bytes as the binding function argument
    validation_with_bytes.bind(raw_bytes)

