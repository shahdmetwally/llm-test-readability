    """
    This test verifies YieldFromTransformer behavior on a while statement
    """
    import yield_from as yield_from_util
    import typed_ast.ast3 as ast

    none_val = None
    none_node = ast.NameConstant(value=none_val)

    yield_from_transformer = yield_from_util.YieldFromTransformer(none_node)

    node_list = [none_node, none_node]

    str_key = "YieldFromTransformer"
    string_node = ast.Str(s=str_key)

    dict_ = {string_node: yield_from_transformer}

    while_stmt = ast.While(test=node_list[0], body=node_list[1], orelse=None, lineno=None, col_offset=None, end_lineno=None, end_col_offset=None, **dict_)
    
    transformed_node = yield_from_transformer.visit(while_stmt)

    assert ast.dump(transformed_node) == ast.dump(while_stmt)   


