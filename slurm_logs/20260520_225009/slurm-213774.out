    """
    Test that the starting and stopping of the timer works correctly.
    """
    timer_instance = Timer()

    timer_instance.start()
    initialization_time = timer_instance.__str__()
    initialization_status = timer_instance.is_started()

    timer_instance.stop()
    stopping_time = timer_instance.__str__()
    stopping_status = timer_instance.is_stopped()

    timer_instance.__eq__(timer_instance)
    timer_instance.is_fail()
    timer_instance.to_maybe()

    assert initialization_status == True, "Timer initialization is not successful."
    assert initialization_time != "0.0000 seconds", "Timer initialization time value is incorrect."
    assert stopping_status == True, "Timer stopping is not successful."
    assert stopping_time != "0.0000 seconds", "Timer stopping time value is incorrect."   


