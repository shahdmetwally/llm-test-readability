import namedtupleutils as utils
import collections as collections

def test_empty_input_returns_named_tuple():
    # given
    list_0 = []
    list_1 = [list_0]
    
    # when
    var_0 = utils.to_namedtuple(list_1)
    none_type_0 = None
    
    # then NamedTuple instance is created and none type is handled correctly
