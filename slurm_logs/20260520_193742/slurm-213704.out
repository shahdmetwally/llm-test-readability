def test_validation_creation_with_docstring_text_checks_success_fail_and_maybe_conversion():
    """
    Test that a Validation object created with docstring-like text
    correctly reports success/failure state and supports conversion
    to a Maybe type via to_maybe().
    """
    # Use a docstring-style string as both the value and error message
    docstring_text = "\n        Create empty maybe.\n\n        :returns: Maybe[None]\n        "

    # Create a Validation instance with identical value and error text
    validation_instance = validation.Validation(docstring_text, docstring_text)

    # Check that the validation reports success
    is_success_result = validation_instance.is_success()

    # Check equality of the validation instance with itself
    is_equal_to_self = validation_instance.__eq__(validation_instance)

    # Check that the validation reports failure
    is_fail_result = validation_instance.is_fail()

    # Convert the failure result to a Maybe type
    is_fail_result.to_maybe()
```
