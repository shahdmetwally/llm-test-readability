def test_to_namedtuple_with_duplicate_keys_and_already_namedtuple_input():
    """Test that to_namedtuple handles a dict with duplicate keys and is idempotent on namedtuple input."""
    # A dict with duplicate keys reduces to a single unique key ("author")
    field_name = "author"
    input_dict = {field_name: field_name, field_name: field_name, field_name: field_name}

    # Convert the dict to a namedtuple
    namedtuple_result = namedtupleutils.to_namedtuple(input_dict)

    # Passing an already-converted namedtuple should also be handled gracefully
    idempotent_result = namedtupleutils.to_namedtuple(namedtuple_result)
```
