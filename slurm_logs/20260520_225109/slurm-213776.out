        post_process_response:  def test_unshift_and_append_and_find_1():
    """Tests unshift, append and find method of the ImmutableList"""

    # Create a boolean value for test data
    is_empty_boolean = False

    # Create an instance of ImmutableList with is_empty set to False
    immutable_list = my_immutable_list.ImmutableList(is_empty=is_empty_boolean)

    # Unshift (add item to start) a boolean value to the immutable list
    immutable_list = immutable_list.unshift(is_empty_boolean)

    # Append (add item to end) the initial empty immutable list instance to the list
    immutable_list = immutable_list.append(my_immutable_list.ImmutableList(is_empty=is_empty_boolean))

    # Find the boolean value in the resultant immutable list
    immutable_list.find(is_empty_boolean)   


