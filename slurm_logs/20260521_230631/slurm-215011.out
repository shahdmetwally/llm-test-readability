def test_maybe_filter_with_non_callable_predicate():
    """Test that Maybe.filter() handles a non-callable (integer) predicate gracefully."""
    # Setup: Create a Maybe with nested data and truthy flag
    default_value = 2281
    sample_string = "gZ(\\mOcN"
