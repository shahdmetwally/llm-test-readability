def test_immutable_list_reduce_with_converted_list():
    """
    Test that ImmutableList.to_list() can be used as both arguments to reduce(),
    and that constructing an ImmutableList with is_empty=True works alongside
    an ImmutableList constructed with only a tail keyword argument.
    """
    is_empty_flag = True
    empty_tail_dict = {}

    # Create an ImmutableList using only a tail (empty dict), no head
    immutable_list_tail_only = immutable_list.ImmutableList(tail=empty_tail_dict)

    # Create an ImmutableList with a head value and is_empty explicitly set to True
    immutable_list_with_head = immutable_list.ImmutableList(is_empty_flag, is_empty=is_empty_flag)

    # Convert the second list to a plain Python list
    converted_list = immutable_list_with_head.to_list()

    # Call reduce using the converted list as both the function and initial value
    immutable_list_with_head.reduce(converted_list, converted_list)
```
