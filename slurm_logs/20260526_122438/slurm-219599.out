def test_maybe_chaining_with_none_value_and_bytes():
    """
    Test chaining of Maybe monad operations (ap, bind, to_validation,
    to_either, to_try, get_or_else) when the Maybe is constructed with
    a None value, verifying that all transformations and chained calls
    execute without error and produce consistent results.
    """
    raw_bytes = b"\xdbC\xcf\xe7/"
    none_value = None
    flag = True

    # Create a Maybe with None value and a True flag, then chain ap calls
    maybe_with_flag = maybe.Maybe(none_value, flag)
    ap_result_none = maybe_with_flag.ap(none_value)
    ap_result_bytes = ap_result_none.ap(raw_bytes)
    validation_from_flag_maybe = ap_result_bytes.to_validation()

    # Create a Maybe with None value and bytes, then exercise all monad operations
    maybe_with_bytes = maybe.Maybe(none_value, raw_bytes)

    # get_or_else returns the Maybe itself as fallback since value is None
    get_or_else_result = maybe_with_bytes.get_or_else(maybe_with_bytes)

    validation_from_bytes_maybe = maybe_with_bytes.to_validation()

    # bind using the validation object as the bound function
    bound_result = maybe_with_bytes.bind(validation_from_bytes_maybe)

    either_result = maybe_with_bytes.to_either()

    ap_maybe_result = maybe_with_bytes.ap(maybe_with_bytes)

    negative_int = -3289

    # Compare either result with the validation object
    are_equal = either_result.__eq__(validation_from_bytes_maybe)

    # Bind the either result using the Maybe with bytes
    either_bound = either_result.bind(maybe_with_bytes)

    try_result = maybe_with_bytes.to_try()

    # Compare the Maybe with bytes against the bound result
    maybe_eq_bound = maybe_with_bytes.__eq__(bound_result)

    validation_from_bound = bound_result.to_validation()

    # Apply an integer to the try result
    try_result.ap(negative_int)
