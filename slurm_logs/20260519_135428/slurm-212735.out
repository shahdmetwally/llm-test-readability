def test_timer_context_manager_with_repr_as_initial_text():
    """Test that a Timer used as a context manager produces a valid repr,
    which is then passed as initial_text to new Timer instances, and that
    stop() can be called after __enter__ while other Timers are constructed."""

    # Start a timer using the context manager protocol
    timer_running = timer.Timer()
    timer_entered = timer_running.__enter__()

    int_val = -1092

    # Capture the repr of the running timer to use as initial_text for new timers
    repr_of_running = timer_entered.__repr__()

    float_arg_0 = timer.FloatArg()

    # Create a timer using the repr string as initial_text
    timer_with_repr_initial_text = timer.Timer(initial_text=repr_of_running)

    float_arg_1 = timer.FloatArg()

    # Compare the original timer against an integer (expected to be not equal)
    eq_result = timer_running.__eq__(int_val)

    # Stop the context-manager timer and capture elapsed time
    elapsed = timer_entered.stop()

    # Create another timer with a callable text formatter and repr as initial_text
    timer_with_float_arg_text = timer.Timer(text=float_arg_0, initial_text=repr_of_running)

    # Capture repr of both timers for inspection
    repr_of_original = timer_running.__repr__()
    repr_of_float_arg_timer = timer_with_float_arg_text.__repr__()

    # Start the timer that uses FloatArg text and repr-based initial_text
    timer_with_float_arg_text.start()
