    """Verify that a dictionary with a single key (appearing multiple times) 
    is correctly converted to a namedtuple, and that the resulting namedtuple 
    can also be converted without error."""
    key = "author"
    duplicate_key_dict = {key: key, key: key, key: key}
    namedtuple_result_1 = namedtuple_utils.to_namedtuple(duplicate_key_dict)
    namedtuple_result_2 = namedtuple_utils.to_namedtuple(namedtuple_result_1)
