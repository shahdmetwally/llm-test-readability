    def test_GET_no_data_no_auto_headers(self, httpbin):
        # https://github.com/httpie/cli/issues/62
        r = http('GET', httpbin + '/headers')
        assert HTTP_OK in r
        assert r.json['headers']['Accept'] == '*/*'
        assert 'Content-Type' not in r.json['headers']

