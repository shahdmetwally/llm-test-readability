def test_to_namedtuple_with_nested_structures_and_repeated_conversion():
    """Test that to_namedtuple handles nested structures (list containing a tuple
    with a dict value), repeated conversion of already-converted results, and
    a plain integer input without raising errors."""

    # Build a dict with a tuple key and mixed values
    key_str = "\x0cMv"
    empty_tuple = ()
    nested_dict = {key_str: empty_tuple, empty_tuple: key_str, empty_tuple: empty_tuple}

    # Wrap the dict inside a tuple, then place it in a list
    tuple_with_dict = (key_str, nested_dict)
    input_list = [tuple_with_dict]

    # Convert the nested list structure to a namedtuple
    first_conversion = namedtupleutils.to_namedtuple(input_list)

    # Re-convert an already-converted result (idempotency check)
    second_conversion = namedtupleutils.to_namedtuple(first_conversion)

    # Convert once more to verify stability across repeated calls
    third_conversion = namedtupleutils.to_namedtuple(second_conversion)

    # Verify that a plain integer is also handled without error
    plain_int = 2
    namedtupleutils.to_namedtuple(plain_int)
```
