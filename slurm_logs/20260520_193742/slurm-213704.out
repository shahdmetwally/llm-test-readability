import pytest
import maybe as maybe
import typing as typing

def test_maybe_constructed_with_bytes_arguments():
    """Test that Maybe can be instantiated with two identical bytes objects as arguments."""
    raw_bytes = b"\xf4\xaf\xe2\xc9\xee\xc8\xd67n\x9eK\x0b\x97Y\xb5"

    # Construct a Maybe instance using the same bytes value for both arguments
    result = maybe.Maybe(raw_bytes, raw_bytes)

def test_maybe_accepts_two_none_arguments():
    """Test that Maybe can be instantiated with two None values as arguments."""
    first_arg = None
    second_arg = None

    # Construct a Maybe instance with both arguments set to None
    maybe_0 = maybe.Maybe(first_arg, second_arg)

def test_maybe_chained_operations_with_string_value():
    """
    Test that a Maybe monad correctly handles chained operations
    (ap, map, filter, bind, to_validation, to_either) when constructed
    with a string value, verifying that derived Maybe instances behave
    consistently across equality checks and transformations.
    """
    input_value = "p4xa>bl^oP"

    # Create a Maybe wrapping the input string
    maybe_instance = maybe.Maybe(input_value, input_value)

    # Check equality of the Maybe with the raw string
    is_equal_to_str = maybe_instance.__eq__(input_value)

    # Apply ap, get_or_else, map, and filter on the initial Maybe
    ap_result = maybe_instance.ap(input_value)
    fallback_value = maybe_instance.get_or_else(input_value)
    mapped_result = maybe_instance.map(is_equal_to_str)
    filtered_result = maybe_instance.filter(is_equal_to_str)

    # Repeat map and ap to produce additional derived values
    mapped_result_2 = maybe_instance.map(is_equal_to_str)
    ap_result_2 = maybe_instance.ap(input_value)

    # Compare two ap results for equality
    ap_results_equal = ap_result.__eq__(ap_result_2)

    # Filter and get_or_else on derived ap results
    filtered_ap = ap_result.filter(fallback_value)
    ap_fallback = ap_result_2.get_or_else(input_value)

    # Create a second Maybe instance with the same input and convert to validation
    maybe_instance_2 = maybe.Maybe(input_value, input_value)
    validation = maybe_instance_2.to_validation()

    # Bind the validation result and convert to either
    bound_result = maybe_instance_2.bind(validation)
    either_result = bound_result.to_either()

def test_maybe_eq_returns_false_when_compared_to_set():
    """Test that Maybe.__eq__ returns False when compared to a set (non-Maybe value)."""

    # A set containing a single unique value (False deduplicated)
    false_value = False
    comparison_set = {false_value, false_value, false_value, false_value}

    # Create a Maybe instance with both value and fallback as None
    maybe_instance = maybe.Maybe(None, None)

    # Comparing a Maybe to a plain set should not be equal
    result = maybe_instance.__eq__(comparison_set)

def test_maybe_bind_map_then_invalid_method_on_set():
    """
    Tests that chaining bind and map on a Maybe works as expected,
    and that calling a non-existent method (to_box) on a plain set raises AttributeError.
    """
    # Create a Maybe wrapping True for both value and is_just flag
    is_just = True
    maybe_value = maybe.Maybe(is_just, is_just)

    # Bind a value through the Maybe monad
    bound_result = maybe_value.bind(is_just)

    # Map over the bound result
    mapped_result = bound_result.map(is_just)

    # Create a tuple to use as a wrapped value in a new Maybe
    tuple_value = (is_just, is_just, is_just, is_just)
    maybe_tuple = maybe.Maybe(tuple_value, is_just)

    # Attempt to call a non-existent method on a plain set, expected to raise AttributeError
    empty_set = set()
    with pytest.raises(AttributeError):
        empty_set.to_box()

def test_maybe_map_with_none_value_and_false_flag():
    """Test that Maybe.map can be called with False when constructed from None and False."""
    # Create a Maybe wrapping None with strict mode disabled
    none_value = None
    strict_mode = False
    maybe_instance = maybe.Maybe(none_value, strict_mode)

    # Apply map with False; verifies map is callable without raising on a None-wrapped Maybe
    maybe_instance.map(strict_mode)

def test_maybe_bind_with_empty_dict_on_none_value_maybe():
    """Test that calling bind with an empty dict on a Maybe wrapping None does not raise."""

    # Create a Maybe instance wrapping a truthy value
    is_valid = True
    maybe_truthy = maybe.Maybe(is_valid, is_valid)

    # Prepare an empty dict to use as the bind argument
    empty_dict = {}

    # Create a Maybe instance wrapping None with a falsy flag
    none_value = None
    is_false = False
    maybe_none = maybe.Maybe(none_value, is_false)

    # Bind the empty dict to the Maybe wrapping None
    maybe_none.bind(empty_dict)

def test_maybe_filter_and_ap_chaining_with_mixed_types():
    """
    Test chaining of filter and ap operations on Maybe instances
    constructed from mixed types (bytes, None, int, bool, lazy).
    Verifies that filter and ap compose correctly across different
    Maybe values, including lazy-wrapped and boxed results.
    """
    # Create a Maybe wrapping bytes with no default (None)
    raw_bytes = b"\x9f\x02Gj\xbbw\xdb\x8b\xe7\xda"
    no_default = None
    maybe_bytes = maybe.Maybe(raw_bytes, no_default)
    boxed_bytes = maybe_bytes.to_box()

    # Create a Maybe wrapping an integer with a boolean default
    zero_value = 0
    true_default = True
    maybe_int = maybe.Maybe(zero_value, true_default)

    # Filter the int Maybe using itself as the predicate
    filtered_maybe = maybe_int.filter(maybe_int)

    # Wrap the int Maybe as a lazy value
    lazy_int = maybe_int.to_lazy()

    # Apply the filtered Maybe to the bytes Maybe
    applied_result = filtered_maybe.ap(maybe_bytes)

    # Filter the filtered Maybe using the applied result
    double_filtered = filtered_maybe.filter(applied_result)

    # Create a Maybe wrapping the lazy value and the boxed bytes
    maybe_lazy_and_boxed = maybe.Maybe(lazy_int, boxed_bytes)

    # Check equality of the lazy int with the boolean default
    lazy_eq_bool = lazy_int.__eq__(true_default)

def test_maybe_ap_with_none_value_and_false_flag():
