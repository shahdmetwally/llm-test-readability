def test_to_namedtuple_with_nested_tuple_containing_set():
    """Test that to_namedtuple handles a tuple containing a set, and also handles a plain set input."""
    # A single float value used to construct both the set and the outer tuple
    sample_float = -67.0

    # A set with one unique value (duplicates collapse)
    sample_set = {sample_float, sample_float, sample_float, sample_float}

    # A tuple nesting the float and the set
    nested_tuple = (sample_float, sample_set)

    # Convert the nested tuple to a namedtuple
    namedtuple_from_nested_tuple = namedtupleutils.to_namedtuple(nested_tuple)

    # Also exercise to_namedtuple with a plain set as input
    namedtupleutils.to_namedtuple(sample_set)
```
