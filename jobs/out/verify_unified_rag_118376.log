    # Given a string for the timer name
    timer_name = "Timer started"

    # When a Timer object is created with that name
    timer = codetiming.Timer(timer_name)

    # And the timer is started
    timer.start()

    # Then the timer should be running
    assert timer._start_time is not None

    # And when the timer is stopped
    elapsed_time = timer.stop()

    # Then the elapsed time should be a float
    assert isinstance(elapsed_time, float)

    # And when the timer is entered
    entered_timer = timer.__enter__()

    # Then the entered timer should be the same as the original timer
    assert entered_timer is timer

    # And when a copy of the timer is made
    copied_timer = timer.copy()

    # Then the copied timer should be a different object from the original timer
    assert copied_timer is not timer   


