def test_maybe_conversions_with_none_and_tuple_values():
    """
    Test that Maybe instances constructed with None and tuple values
    can be converted to lazy, either, and try representations without error.
    Verifies chained conversions across multiple Maybe instances.
    """
    # Create a Maybe with both value and default set to None
    none_value = None
    maybe_none = maybe.Maybe(none_value, none_value)

    # Use the None-based Maybe as the value in a tuple
    tuple_value = (maybe_none,)

    # Convert the None-based Maybe to a lazy representation
    lazy_from_none_maybe = maybe_none.to_lazy()

    # Create a second Maybe using the tuple as value and False as default
    bool_default = False
    maybe_with_tuple = maybe.Maybe(tuple_value, bool_default)

    # Convert both Maybe instances to either representations
    either_from_none_maybe_first = maybe_none.to_either()
    try_from_tuple_maybe = maybe_with_tuple.to_try()
    either_from_none_maybe_second = maybe_none.to_either()
    either_from_tuple_maybe = maybe_with_tuple.to_either()

    # Convert the try result to a lazy representation
    try_from_tuple_maybe.to_lazy()
```
