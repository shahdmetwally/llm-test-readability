def test_to_namedtuple_with_nested_tuple_containing_set():
    """Test that to_namedtuple handles a tuple containing a set,
    and also handles a bare set as input, without raising errors."""

    # A single float value used to construct a deduplicated set
    float_value = -67.0

    # A set with duplicate entries of the same float (collapses to one element)
    float_set = {float_value, float_value, float_value, float_value}

    # A tuple nesting the float and the set together
    nested_tuple = (float_value, float_set)

    # Convert the nested tuple to a namedtuple
    var_0 = namedtupleutils.to_namedtuple(nested_tuple)

    # Also attempt conversion of a bare set
    namedtupleutils.to_namedtuple(float_set)
```
