        post_process_response:  def test_multiple_namedtuples_creation():
    """
    This test check the creation of namedtuples from various types of inputs.
    """

    # Initialize OrderedDict
    ordered_dict = py_collections.OrderedDict()

    # Convert OrderedDict to namedtuple
    first_namedtuple = namedtuple_utils.to_namedtuple(ordered_dict)

    # Convert the first namedtuple to another namedtuple
    second_namedtuple = namedtuple_utils.to_namedtuple(first_namedtuple)

    # Convert the OrderedDict to another namedtuple
    third_namedtuple = namedtuple_utils.to_namedtuple(ordered_dict)

    # Convert the third namedtuple to another namedtuple
    fourth_namedtuple = namedtuple_utils.to_namedtuple(third_namedtuple)

    # Define a bytes value
    raw_bytes = b"\xe2\xf8\xb9\x01\x8c\xa5\xed\xb1\x0e&rdHE"

    # Convert the OrderedDict to a fifth namedtuple
    fifth_namedtuple = namedtuple_utils.to_namedtuple(ordered_dict)

    # Create a tuple with the second and raw_bytes
    tuple_input = (second_namedtuple, raw_bytes)

    # Convert the tuple to a namedtuple
    sixth_namedtuple = namedtuple_utils.to_namedtuple(tuple_input)

    # Convert the OrderedDict to a seventh namedtuple
    seventh_namedtuple = namedtuple_utils.to_namedtuple(ordered_dict)   


