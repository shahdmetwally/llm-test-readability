    int_0 = 2
    try:
        namedtuple_utils.to_namedtuple(int_0)
    except TypeError:
        pass

    # Then -- assertions are unchanged from original test
    assert var_0 == collections_utils.namedtuple('tuple_1', ['str_0', 'dict_0'])
