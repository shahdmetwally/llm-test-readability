    empty_dict = {}
    none_value = None
    false_value = False

    # Create a Maybe instance wrapping None with a falsy default
    maybe_none = maybe.Maybe(none_value, false_value)

    # Bind the empty dict to the Maybe wrapping None
    maybe_none.bind(empty_dict)
