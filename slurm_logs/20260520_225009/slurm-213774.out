import codetiming as codetiming_module 

def test_timer_correctly_starts_and_stops():
    timer_module = codetiming_module.Timer(text="{name}: {milliseconds:.5f}")
    func_to_time = fixture_functions["func_to_time"]
    start_time = fixture_functions["start_time"]
    end_time = fixture_functions["end_time"]

    start_func_mock = mocker.Mock()
    end_func_mock = mocker.Mock()

    timer_module.start = start_func_mock
    timer_module.stop = end_func_mock
    timer_module._start_time = start_time
    timer_module._end_time = end_time
    timer_module.timer = mocker.Mock(return_value=end_time - start_time)

    with timer_module:
        func_to_time("arg1", kwarg1="kwarg1")

    start_func_mock.assert_called_once()
    end_func_mock.assert_called_once()   


