    initial_text = "Timer started"
    timer = timer.Timer(initial_text)

    # Start and stop the timer explicitly
    none_type = timer.start()
    elapsed = timer.stop()

    # Use the timer as a context manager (enter/exit)
    context_timer = timer.__enter__()
    timer.copy()
