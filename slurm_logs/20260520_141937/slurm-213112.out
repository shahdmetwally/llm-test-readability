```python
def test_immutable_list_to_list_and_reduce_with_empty_tail():
    """Test ImmutableList construction with tail/is_empty args, to_list conversion, and reduce using the list result as both arguments."""

    is_empty_flag = True
    empty_tail = {}

    # Construct a list with an empty dict as the tail (exercises tail= constructor path)
    list_with_empty_tail = immutable_list.ImmutableList(tail=empty_tail)

    # Construct a list with is_empty flag set via both positional and keyword argument
    list_with_is_empty_flag = immutable_list.ImmutableList(is_empty_flag, is_empty=is_empty_flag)

    # Convert to a plain Python list
    as_list = list_with_is_empty_flag.to_list()

    # Invoke reduce using the converted list as both the accumulator and the iterable
    list_with_is_empty_flag.reduce(as_list, as_list)
```
</final_code>
