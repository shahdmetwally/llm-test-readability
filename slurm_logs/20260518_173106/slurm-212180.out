        post_process_response:  class TestNamedtupleConversion(unittest.TestCase):
    def test_namedtuple_conversion(self):
        test_data = {'field1': 1, 'field2': 2}
        result = to_namedtuple(test_data.values())
        self.assertEqual(result.field1, test_data['field1'])
        self.assertEqual(result.field2, test_data['field2'])

class TestNamedtupleConversionOnBytes(unittest.TestCase):
    def test_namedtuple_conversion_on_bytes(self):
        test_data = {'field1': b'1', 'field2': b'2'}
        result = to_namedtuple(test_data.values())
        self.assertEqual(result.field1, test_data['field1'])
        self.assertEqual(result.field2, test_data['field2'])   


