    tuple_nt = module_under_test.to_namedtuple(tuple(normal_dict.items()))
    assert isinstance(tuple_nt, tuple)

    dict_nt = module_under_test.to_namedtuple(normal_dict)
    assert isinstance(dict_nt, tuple)

    dict_nt_again = module_under_test.to_namedtuple(dict_nt)
    assert isinstance(dict_nt_again, tuple)

    dict_nt_again_2 = module_under_test.to_namedtuple(dict_nt_again)
    assert isinstance(dict_nt_again_2, tuple)   


