def test_maybe_equality_and_chain_to_try_to_validation():
    """Test that a Maybe wrapping False is equal to itself,
    and that chaining to_try() followed by to_validation() executes without error."""

    # Create a Maybe instance wrapping False for both value and context
    is_false = False
    maybe_instance = maybe.Maybe(is_false, is_false)

    # Verify the Maybe instance is equal to itself
    is_equal = maybe_instance.__eq__(maybe_instance)

    # Convert to Try, then chain to Validation
    try_instance = maybe_instance.to_try()
    try_instance.to_validation()
