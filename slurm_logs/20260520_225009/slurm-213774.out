        post_process_response:  def test_timer_sets_last(capsys):
    """
    This test case validates that the Timer's .last setter works properly by
    measuring the time for a dummy function `waste_time`.
    """
    # Dummy function `waste_time` is called in `Timer` context.
    with Timer(logger=None) as t:
        waste_time()

    # Time is check with `pytest.approx` for inexact comparison.
    assert math.isnan(t.last)
    assert t.last == pytest.approx(0.0, abs=0.05)

    stdout, stderr = capsys.readouterr()
    assert stdout == ""
    assert stderr == ""   


