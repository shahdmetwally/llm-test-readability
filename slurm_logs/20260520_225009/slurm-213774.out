def copy_and_convert_to_int(input_dict, output_dict=None):
    if output_dict is None:
        output_dict = {}

    for key, value in input_dict.items():
        if isinstance(value, dict):
            output_dict[key] = copy_and_convert_to_int(value)
        else:
            output_dict[key] = int(value)

    return output_dict

