    def test_to_namedtuple_with_nested_tuple_containing_set():
        """Test that to_namedtuple handles a tuple containing a set,
        and also handles a bare set as input, without raising errors."""
    
        # A single float value used to construct a deduplicated set
        float_value = -67.0
    
        # A set with duplicate entries of the same float (collapses to one element)
