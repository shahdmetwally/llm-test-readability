def test_timer_start_with_logger_none_and_exit_without_stop():
    """
    Test that starting a Timer with logger=None does not raise,
    and that calling __exit__ on a Timer that was never stopped
    (via stop() or a context manager) raises TimerError.
    """
    # Create a Timer with no logger (logger=None suppresses output)
    timer_0 = timer.Timer(logger=None)

    # Start the timer – should succeed since it's not running
    none_type_1 = timer_0.start()

    # Create an empty dict and set a key to point to itself
    dict_0 = {}
    none_type_2 = None
    none_type_3 = timer_0.__exit__()

    # Set dict_0[none_type_2] = dict_0 (i.e., None -> dict_0)
    var_0 = dict_0.__setitem__(none_type_2, dict_0)
    var_1 = var_0.__repr__()

    # Attempting to start an already-started timer should raise TimerError
    var_0.start()
```
