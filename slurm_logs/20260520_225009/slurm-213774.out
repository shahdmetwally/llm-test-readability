    maybe_none = maybe.Maybe(None, True)
    var_applied = maybe_none.ap(None)
    var_lazy = var_applied.to_lazy()
    var_validation = var_lazy.to_validation()
    var_filtered = maybe_none.filter(var_validation)
    var_either = var_filtered.to_either()
    var_try = var_validation.to_try()
    is_equal = var_filtered.__eq__(var_applied)
    var_box = var_filtered.to_box()
    var_try_applied = var_try.ap(bytes)   


