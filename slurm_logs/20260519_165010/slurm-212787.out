    """Test that a Timer can be used as a context manager with __enter__ and __exit__."""
    # Create a timer instance
    timer = timer.Timer()
    
    # Start the timer (enter the context)
    entered_timer = timer.__enter__()
    
    # Stop the timer (exit the context)
    none_type = timer.__exit__()
