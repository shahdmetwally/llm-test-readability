def test_timer_start_stop_and_context_manager_initialization() -> None:
    """Test that a Timer can be started, stopped, and then entered as a context manager."""
    # Create a timer with the default "Timer started" initial text
    initial_text = "Timer started"
    timer = timer.Timer(initial_text)
    
    # Start and stop the timer
    timer.start()
    timer.stop()
    
    # Re-enter the timer as a context manager (start it again)
    timer.__enter__()
    
    # Copy the timer object
    timer.copy()
