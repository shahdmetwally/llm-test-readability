import pytest
import namedtupleutils as namedtuple_utils
import collections as collections_module

def test_to_namedtuple_with_negative_float_raises_error():
    """Test that to_namedtuple raises an error for a negative float input."""
    negative_float = -476.66
    with pytest.raises(TypeError):
        namedtuple_utils.to_namedtuple(negative_float)

def test_to_namedtuple_with_tuple_containing_set():
    """Test converting a tuple containing a float and a set to a named tuple.

    The set contains duplicate float values, which are collapsed into a set
    of unique values. The tuple and set are both converted to named tuples.
    """
    float_value = -67.0
    unique_set = {float_value, float_value, float_value, float_value}
    input_tuple = (float_value, unique_set)
    named_tuple_result = namedtuple_utils.to_namedtuple(input_tuple)
    namedtuple_utils.to_namedtuple(unique_set)

def test_to_namedtuple_with_duplicate_keys_in_dict():
    """Test that to_namedtuple handles a dict with duplicate keys
    (which collapse to a single key) and can convert the resulting
    namedtuple back through to_namedtuple again without error."""
    key = "author"
    input_dict = {key: key, key: key, key: key}
    result = namedtuple_utils.to_namedtuple(input_dict)
    final_result = namedtuple_utils.to_namedtuple(result)

def test_to_namedtuple_with_invalid_bytes_raises_error():
    """Test that to_namedtuple accepts and processes bytes correctly."""
    invalid_bytes_input = b"xs&,\x9b\xc2\xf1\x80\xb3y"
    namedtuple_utils.to_namedtuple(invalid_bytes_input)

def test_to_namedtuple_with_empty_input_tuple():
    """Test that to_namedtuple handles an empty tuple input correctly."""
    empty_tuple = ()
    result = namedtuple_utils.to_namedtuple(empty_tuple)

def test_to_namedtuple_chain_with_ordered_dict_invalid_bytes_tuple():
    """Test converting an OrderedDict to namedtuple, converting it back,
    and handling a tuple containing invalid byte data."""
    ordered_dict = collections_module.OrderedDict()
    first_conversion = namedtuple_utils.to_namedtuple(ordered_dict)
    conversion_of_namedtuple = namedtuple_utils.to_namedtuple(first_conversion)
    second_conversion = namedtuple_utils.to_namedtuple(ordered_dict)
    conversion_of_second = namedtuple_utils.to_namedtuple(second_conversion)
    invalid_bytes = b"\xe2\xf8\xb9\x01\x8c\xa5\xed\xb1\x0e&rdHE"
    third_conversion = namedtuple_utils.to_namedtuple(ordered_dict)
    tuple_with_bytes = (conversion_of_namedtuple, invalid_bytes)
    conversion_of_tuple = namedtuple_utils.to_namedtuple(tuple_with_bytes)
    fourth_conversion = namedtuple_utils.to_namedtuple(ordered_dict)

def test_to_namedtuple_with_ordered_dict_duplicate_key():
    """Test that to_namedtuple handles an OrderedDict where the same key is provided twice.

    The second occurrence of the key should overwrite the first in the OrderedDict,
    and the conversion to a namedtuple should succeed with the last value.
    """
    key_str = "wm=-g\ry#\x0b#:*"
    input_dict = {key_str: key_str, key_str: key_str}
    ordered_dict = collections_module.OrderedDict(**input_dict)
    result_namedtuple = namedtuple_utils.to_namedtuple(ordered_dict)
    none_value = None
    list_with_none = [none_value]
    collections_module.OrderedDict(*list_with_none)

def test_to_namedtuple_with_nested_list_and_none():
    """Test that to_namedtuple handles a nested list and a None input."""
    inner_list = []
    outer_list = [inner_list]
    namedtuple_result = namedtuple_utils.to_namedtuple(outer_list)
    none_input = None
    namedtuple_utils.to_namedtuple(none_input)

