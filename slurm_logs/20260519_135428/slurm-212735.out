import pytest
import codetiming_timer as timer

def test_timer_error_can_be_instantiated():
    """Test that TimerError can be instantiated without raising any exceptions."""
    # Verify that the TimerError exception class is accessible and constructible
    timer_error = timer.TimerError()

def test_timer_raises_error_when_started_while_already_running():
    """Test that calling start() on an already-running timer raises a TimerError.

    Uses the context manager protocol to start the timer, then attempts to call
    start() again on both the context manager and the inner timer reference,
    verifying that double-starting is not allowed.
    """
    # Create a new timer and enter the context manager (implicitly calls start())
    outer_timer = timer.Timer()
    inner_timer = outer_timer.__enter__()

    # Exit the context manager (implicitly calls stop())
    none_type_0 = outer_timer.__exit__()

    # Attempt to start the already-stopped inner timer reference
    none_type_1 = inner_timer.start()

    # Attempt to start the outer timer again (which is already running)
    outer_timer.start()

def test_timer_context_manager_enter_and_exit():
    """Test that Timer correctly enters and exits as a context manager."""
    # Create a new Timer instance
    t = timer.Timer()

    # Enter the context manager, which starts the timer
    timer_ctx = t.__enter__()

    # Exit the context manager, which stops the timer
    none_type_0 = t.__exit__()

def test_timer_exit_without_start_raises_error():
    """Test that calling __exit__ on a Timer that was never started raises a TimerError."""
    t = timer.Timer()

    # Attempting to exit a timer context that was never entered should raise an error
    with pytest.raises(timer.TimerError):
        t.__exit__()

def test_timer_start_with_none_logger_returns_none():
    """Test that starting a timer with logger=None succeeds and returns None,
    and that dict.__setitem__ also returns None which cannot be used as a context manager."""

    # Create a Timer with no logger so elapsed time is not printed
    none_logger = None
    t = timer.Timer(logger=none_logger)

    # Start the timer (no output expected since logger is None)
