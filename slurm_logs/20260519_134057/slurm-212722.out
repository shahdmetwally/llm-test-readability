    # Dict with mixed key types: a namedtuple key and a bool key
    dict_with_mixed_keys = {namedtuple_from_tuple: namedtuple_from_string_dict_2, bool_false: namedtuple_from_string_dict_2}
    namedtuple_from_mixed_dict = namedtupleutils.to_namedtuple(dict_with_mixed_keys)

    # Convert an already-converted namedtuple (idempotency check)
    namedtuple_from_namedtuple = namedtupleutils.to_namedtuple(namedtuple_from_mixed_dict)

    bool_false_2 = False

    # Convert the mixed-key dict namedtuple again
    namedtuple_from_mixed_dict_again = namedtupleutils.to_namedtuple(namedtuple_from_mixed_dict)

    # Convert a plain boolean — tests behaviour with a non-collection scalar input
    namedtupleutils.to_namedtuple(bool_false_2)

def test_to_namedtuple_with_nested_structures_and_repeated_conversions():
    """Test that to_namedtuple handles nested structures (list containing a tuple
    with a string key/dict), repeated conversions of already-converted results,
    and a plain integer input without raising errors."""

    # Build a dict with mixed key types (string and tuple) and a tuple value
    key_str = "\x0cMv"
    empty_tuple = ()
    mixed_dict = {key_str: empty_tuple, empty_tuple: key_str, empty_tuple: empty_tuple}

    # Nest the string and dict inside a tuple, then wrap in a list
    nested_tuple = (key_str, mixed_dict)
    list_of_tuples = [nested_tuple]

    # First conversion: list containing a nested tuple/dict structure
    namedtuple_result_1 = namedtupleutils.to_namedtuple(list_of_tuples)

    # Second conversion: re-convert the already-converted result
    namedtuple_result_2 = namedtupleutils.to_namedtuple(namedtuple_result_1)

    # Third conversion: re-convert again to verify idempotent-like behaviour
    namedtuple_result_3 = namedtupleutils.to_namedtuple(namedtuple_result_2)

    # Convert a plain integer (non-iterable scalar) — should be handled gracefully
    int_input = 2
    namedtupleutils.to_namedtuple(int_input)

def test_to_namedtuple_with_bytes_keyed_dict():
    """Test that to_namedtuple handles a dict with duplicate bytes keys without error."""
    # A bytes object used as both key and value in the input dict
    bytes_key = b"F\xdb\xfdf\x8a\xe4\n\xa2\x1d[\xdc*\xa3\xba\xf6s}"

    # Dict with duplicate bytes keys (Python will collapse to a single entry)
    bytes_keyed_dict = {bytes_key: bytes_key, bytes_key: bytes_key, bytes_key: bytes_key}

    # Attempt conversion; verifies the function accepts bytes-keyed dicts
    namedtupleutils.to_namedtuple(bytes_keyed_dict)
