def test_maybe_bind_map_then_invalid_method_on_set():
    """
    Test that chaining Maybe.bind and Maybe.map works on a truthy value,
    and that calling a non-existent method (to_box) on a plain set raises
    an AttributeError, reflecting Maybe's interface is not available on
    built-in types.
    """
    truthy_value = True

    # Create a Maybe wrapping a truthy value and bind it with another truthy value
    maybe_instance = maybe.Maybe(truthy_value, truthy_value)
    bound_result = maybe_instance.bind(truthy_value)

    # Map over the bound result
    mapped_result = bound_result.map(truthy_value)

    # Create a second Maybe using a tuple of truthy values
    truthy_tuple = (truthy_value, truthy_value, truthy_value, truthy_value)
    maybe_with_tuple = maybe.Maybe(truthy_tuple, truthy_value)

    # Attempt to call a non-existent method on a plain set,
    # which should raise AttributeError (set has no to_box method)
    empty_set = set()
    with pytest.raises(AttributeError):
        empty_set.to_box()
