import codetiming_timer as timer

def test_timer_start_and_stop():
    """
    Ensure that the Timer logger logs 'Timer started' and 'Timer <time> seconds' 
    when the timer is started and stopped.
    """
    # Rename local variables for clarity and domain alignment.
    initial_text = "Timer started"
    timer_instance = timer.Timer(initial_text)
    
    # Verify that the timer starts.
    timer_start = timer_instance.start()
    
    # Verify that the timer stops and logs elapsed time.
    time_seconds = timer_instance.stop()
    
    # Ensure that timer_instance is entered and that a copy of it is returned.
    assert timer_instance.__enter__() is timer_instance
    assert timer_instance.copy() is not timer_instance
    
    # Ensure that the initial text 'Timer started' and final text 'Timer <time> seconds' are present in the stdout.
    assert initial_text in capsys.readouterr().out.split('\n')
    assert f'Timer {time_seconds} seconds' in capsys.readouterr().out.split('\n')
    
    # Ensure that there are no additional lines in stdout.
    assert len(capsys.readouterr().out.split('\n')) == 2   


