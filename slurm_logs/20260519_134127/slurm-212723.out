    dict_with_mixed_keys = {namedtuple_from_tuple: second_namedtuple_from_dict, false_value: second_namedtuple_from_dict}

    # Convert the mixed-key dict to a namedtuple
    namedtuple_from_mixed_dict = namedtupleutils.to_namedtuple(dict_with_mixed_keys)

    # Convert the resulting namedtuple again (idempotency / nested conversion check)
    namedtuple_from_namedtuple = namedtupleutils.to_namedtuple(namedtuple_from_mixed_dict)

    false_value_2 = False

    # Re-convert the mixed dict namedtuple to verify stability
    namedtuple_restated = namedtupleutils.to_namedtuple(namedtuple_from_mixed_dict)

    # Convert a raw bool value — exercises primitive input handling
    namedtupleutils.to_namedtuple(false_value_2)

def test_to_namedtuple_with_nested_structures_and_repeated_conversion():
    """Test that to_namedtuple handles nested structures (list containing a tuple
    with a dict value), repeated conversion of already-converted results, and
    a plain integer input without raising errors."""

    # Build a dict with a tuple key and mixed values
    key_str = "\x0cMv"
    empty_tuple = ()
    nested_dict = {key_str: empty_tuple, empty_tuple: key_str, empty_tuple: empty_tuple}

    # Wrap the dict inside a tuple, then place it in a list
    tuple_with_dict = (key_str, nested_dict)
    input_list = [tuple_with_dict]

    # Convert the nested list structure to a namedtuple
    first_conversion = namedtupleutils.to_namedtuple(input_list)

    # Re-convert an already-converted result (idempotency check)
    second_conversion = namedtupleutils.to_namedtuple(first_conversion)

    # Convert once more to verify stability across repeated calls
    third_conversion = namedtupleutils.to_namedtuple(second_conversion)

    # Verify that a plain integer is also handled without error
    plain_int = 2
    namedtupleutils.to_namedtuple(plain_int)

def test_to_namedtuple_with_bytes_keyed_dict():
    """Test that to_namedtuple handles a dict with duplicate bytes keys without error."""
    # A bytes object used as both key and value in the input dictionary
    bytes_key = b"F\xdb\xfdf\x8a\xe4\n\xa2\x1d[\xdc*\xa3\xba\xf6s}"

    # Dict with repeated bytes keys (duplicates collapse to a single entry in Python)
    bytes_keyed_dict = {bytes_key: bytes_key, bytes_key: bytes_key, bytes_key: bytes_key}

    namedtupleutils.to_namedtuple(bytes_keyed_dict)
```
