    """Test that Timer starts and stops correctly"""
    timer_lib = pyutils.Timer
    # create a timer
    timer = timer_lib()
    # start the timer
    timer.start()
    # wait for some time
    time.sleep(0.1)
    # stop the timer
    timer.stop()
    # check that timer is stopped
    assert not timer.is_running(), "Timer should not be running after stop"   


