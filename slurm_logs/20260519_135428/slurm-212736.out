def test_timer_context_manager_enter_stop_and_repr():
    """Test that a Timer used as a context manager can be stopped, compared,
    and that repr works on both plain and configured Timer instances."""

    # Create a base timer and enter it as a context manager
    base_timer = timer.Timer()
    active_timer = base_timer.__enter__()

    # Values used in constructor arguments and comparisons
    int_value = -1092
    float_arg_0 = timer.FloatArg()

    # Create a second timer using the active context manager timer as initial_text
    timer_with_active_as_initial = timer.Timer(initial_text=active_timer)

    float_arg_1 = timer.FloatArg()

    # Compare base_timer to an integer (result used as initial_text below)
    eq_result = base_timer.__eq__(int_value)

