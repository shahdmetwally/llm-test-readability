    # Capture repr of both timers for reference
    repr_of_timer_0 = timer_0.__repr__()
    repr_of_timer_with_float_arg_text = timer_with_float_arg_text.__repr__()

    # Start the timer that uses FloatArg as its text formatter
    timer_with_float_arg_text.start()

def test_timer_start_stop_with_no_logger_then_invalid_operations():
    """
    Test that a Timer with logger=None can be started and stopped via
    __exit__, and that subsequent invalid operations on unrelated objects
    (a dict entry set to None and a None-keyed dict value) behave as expected.
    The final call to start() on the result of __setitem__ (None) exercises
    attribute access on that return value.
    """
    # Create a Timer with no logging output
    no_logger = None
    t = timer.Timer(logger=no_logger)

    # Start the timer (returns None)
    start_result = t.start()

    # Prepare a dict and a None value to use in subsequent operations
    empty_dict = {}
    none_value = None

    # Stop the timer via context manager exit protocol
    exit_result = t.__exit__()

    # Set a None key in the dict mapping to the dict itself
    setitem_result = empty_dict.__setitem__(none_value, empty_dict)

    # Get the repr of the setitem result (None.__repr__() -> 'None')
    repr_result = setitem_result.__repr__()

    # Attempt to call .start() on the setitem result (None)
    setitem_result.start()

def test_timer_start_with_nested_timer_configurations():
    """Test that starting a timer configured with another timer as initial_text and
    a non-callable logger does not raise errors, and that chained Timer construction
    using a running timer instance as arguments behaves consistently."""

    # Create a base timer and use it as a context manager
    base_timer = timer.Timer()
    running_timer = base_timer.__enter__()

    # Compare the timer to itself; result is used as a logger value below
    eq_result = base_timer.__eq__(base_timer)

    # Exit the context manager
    none_result = base_timer.__exit__()

    # Create a timer using the running timer instance as initial_text and eq_result as logger
    timer_with_timer_initial_text = timer.Timer(initial_text=running_timer, logger=eq_result)

    # Create another timer using the running timer as text, timer_with_timer_initial_text
    # as initial_text, and eq_result as logger
    timer_with_nested_config = timer.Timer(running_timer, initial_text=timer_with_timer_initial_text, logger=eq_result)

    # Start the nested-config timer to verify no error is raised
    timer_with_nested_config.start()

def test_timer_start_stop_then_enter_and_copy():
    """Test that a Timer can be started and stopped, then re-entered as a
    context manager and copied without error."""
    # Create a Timer with default initial text
    initial_text = "Timer started"
    t = timer.Timer(initial_text)

    # Start and stop the timer to record elapsed time
    none_type_0 = t.start()
    elapsed = t.stop()

    # Re-enter the timer as a context manager
    entered_timer = t.__enter__()

    # Copy the timer object (verifying copy is supported)
    t.copy()
```
