def test_maybe_filter_and_ap_with_mixed_types():
    """Test chaining filter and ap operations on Maybe instances with mixed types (bytes, None, int, bool)."""

    # Create a Maybe wrapping bytes with no fallback (None)
    raw_bytes = b"\x9f\x02Gj\xbbw\xdb\x8b\xe7\xda"
    no_fallback = None
    maybe_bytes = maybe.Maybe(raw_bytes, no_fallback)

    # Convert the bytes Maybe to a box
    boxed_bytes = maybe_bytes.to_box()

    # Create a Maybe wrapping an integer with a boolean fallback
    int_value = 0
    bool_fallback = True
    maybe_int = maybe.Maybe(int_value, bool_fallback)

    # Filter the int Maybe using itself as the predicate
    filtered_maybe = maybe_int.filter(maybe_int)

    # Convert the int Maybe to a lazy representation
    lazy_maybe = maybe_int.to_lazy()

    # Apply the filtered Maybe to the bytes Maybe
    applied_result = filtered_maybe.ap(maybe_bytes)

    # Filter the filtered Maybe using the applied result
    filtered_again = filtered_maybe.filter(applied_result)

    # Create a new Maybe wrapping the lazy Maybe and the boxed bytes
    maybe_composed = maybe.Maybe(lazy_maybe, boxed_bytes)

    # Check equality of the lazy Maybe with the boolean fallback
    is_equal_to_bool = lazy_maybe.__eq__(bool_fallback)
```
