def test_timer_context_manager_with_repr_as_initial_text():
    """Test that a Timer used as a context manager can provide its repr as initial_text
    for other Timer instances, and that stop() works correctly after context entry."""

    # Start a timer via context manager protocol
    timer_0 = timer.Timer()
    timer_1 = timer_0.__enter__()

    # An arbitrary integer used for equality comparison
    negative_int = -1092

    # Capture the repr of the running timer to use as initial_text for other timers
    timer_repr = timer_1.__repr__()

    # Create additional timers using the repr string as initial_text
    float_arg_0 = timer.FloatArg()
    timer_with_initial_text = timer.Timer(initial_text=timer_repr)

    float_arg_1 = timer.FloatArg()

    # Compare the original timer against a non-Timer value
    eq_result = timer_0.__eq__(negative_int)

    # Stop the context manager timer and capture elapsed time
    elapsed = timer_1.stop()

    # Create another timer with a callable text formatter and the repr as initial_text
    timer_with_float_arg_text = timer.Timer(text=float_arg_0, initial_text=timer_repr)

    # Capture repr of both timers for reference
    repr_of_timer_0 = timer_0.__repr__()
    repr_of_timer_with_float_arg_text = timer_with_float_arg_text.__repr__()

    # Start the timer that uses FloatArg as its text formatter
    timer_with_float_arg_text.start()
