import pytest
import codetiming_timer as timer

def test_timer_error_can_be_instantiated():
    """Test that TimerError can be instantiated without arguments."""
    # Verify that TimerError is a valid exception class that requires no arguments
    timer_error = timer.TimerError()

def test_starting_already_running_timer_raises_error():
    """Test that calling start() on a timer that is already running raises a TimerError.

    The timer is first used as a context manager (which calls start/stop),
    then start() is called again on the inner timer reference to verify that
    a double-start is detected and raises an error.
    """
    # Create a new timer instance
    timer_instance = timer.Timer()

    # Enter the context manager, which calls start() internally
    inner_timer = timer_instance.__enter__()

    # Exit the context manager, which calls stop() internally
    none_type_0 = timer_instance.__exit__()

    # Attempt to start the inner timer reference (already stopped, so this starts it)
    none_type_1 = inner_timer.start()

    # Attempt to start the outer timer again while it is already running — should raise TimerError
    timer_instance.start()

def test_timer_context_manager_enter_and_exit():
    """Test that Timer can be used as a context manager via __enter__ and __exit__."""
    # Create a new Timer instance
    t = timer.Timer()

    # Enter the context manager, which starts the timer and returns itself
    active_timer = t.__enter__()

    # Exit the context manager, which stops the timer
    result = t.__exit__()

def test_timer_exit_without_start_raises_error():
    """Test that calling __exit__ on a Timer that was never started raises a TimerError."""
    t = timer.Timer()

    # Attempting to exit a timer context that was never entered should raise an error
    with pytest.raises(timer.TimerError):
        t.__exit__()

def test_timer_start_with_no_logger_then_enter_on_none_raises():
    """Test that starting a Timer with logger=None succeeds,
    but calling __enter__() on None (the return value of dict.__setitem__)
    raises an AttributeError, as None has no __enter__ method."""
    # Create a timer that produces no output
    none_type_0 = None
    t = timer.Timer(logger=none_type_0)

    # Start the timer successfully (logger=None suppresses output)
    none_type_1 = t.start()

    # Build a dict and map a None key to the dict itself
    dict_0 = {}
    none_type_2 = None
    var_0 = dict_0.__setitem__(none_type_2, dict_0)  # returns None

    # Attempting __enter__() on None (var_0) will raise AttributeError
    with pytest.raises(AttributeError):
        var_0.__enter__()

def test_timer_context_manager_with_nested_timers_and_repr():
    """Test Timer context manager usage alongside nested Timer instantiation,
    equality comparison, stop, and repr calls across multiple timer instances."""

    # Start a timer using the context manager protocol
    base_timer = timer.Timer()
    active_timer = base_timer.__enter__()

    # Auxiliary values used to configure nested timers
    int_val = -1092
    float_arg_0 = timer.FloatArg()

    # Create a nested timer using the active context timer as initial_text
    nested_timer_with_initial_text = timer.Timer(initial_text=active_timer)

    float_arg_1 = timer.FloatArg()

    # Compare base timer with integer value
    eq_result = base_timer.__eq__(int_val)

    # Stop the active (context) timer and capture elapsed time
    elapsed = active_timer.stop()

    # Create another timer using float_arg as text and the equality result as initial_text
    timer_with_float_text = timer.Timer(text=float_arg_0, initial_text=eq_result)

    # Retrieve string representations of base and float-text timers
    base_timer_repr = base_timer.__repr__()
    float_text_timer_repr = timer_with_float_text.__repr__()

    # Start the float-text timer
    none_result = timer_with_float_text.start()

def test_timer_context_manager_with_repr_as_initial_text():
    """Test that a timer used as a context manager can produce a repr string,
    which is then passed as initial_text to new Timer instances, while also
    verifying stop() works correctly after context entry."""

    # Start a timer using the context manager protocol
    timer_running = timer.Timer()
    timer_context = timer_running.__enter__()

    # Arbitrary integer used for equality comparison
    int_val = -1092

    # Capture the repr of the running timer to use as initial_text
    repr_of_running_timer = timer_context.__repr__()

    # Create additional Timer instances using the repr string as initial_text
    float_arg_0 = timer.FloatArg()
    timer_with_repr_initial_text = timer.Timer(initial_text=repr_of_running_timer)

    float_arg_1 = timer.FloatArg()

    # Compare the original timer against an integer (exercises __eq__)
    eq_result = timer_running.__eq__(int_val)

    # Stop the context timer and capture elapsed time
    elapsed = timer_context.stop()

    # Create another Timer with a FloatArg text and the repr as initial_text
    timer_with_float_text = timer.Timer(text=float_arg_0, initial_text=repr_of_running_timer)

    # Capture repr of both timers after stop
    repr_after_stop = timer_running.__repr__()
    repr_float_text_timer = timer_with_float_text.__repr__()

    # Start the timer that has FloatArg text and repr-based initial_text
    timer_with_float_text.start()

def test_timer_start_stop_with_no_logger_then_operate_on_none_keyed_dict():
    """Test that Timer starts and exits without a logger (logger=None), and that
    calling .start() on the result of repr(None) raises AttributeError, since
    a string has no .start() method.
    """
    # Create and start a Timer with logging disabled
    t = timer.Timer(logger=None)
    t.start()

    # Exit the timer via __exit__ (simulating context manager exit)
    t.__exit__()

    # dict.__setitem__ returns None
    empty_dict = {}
    set_result = empty_dict.__setitem__(None, empty_dict)
    assert set_result is None

    # None.__repr__() returns the string "None"
    repr_result = set_result.__repr__()
    assert repr_result == "None"

    # Calling .start() on a string raises AttributeError
    with pytest.raises(AttributeError):
        repr_result.start()

def test_timer_start_with_nested_timer_as_initial_text_and_equality_as_logger():
    """Test that Timer can be constructed and started with another Timer instance as
    initial_text and the result of __eq__ as logger, without raising errors."""

    # Create a base timer and use it as a context manager
    base_timer = timer.Timer()
    inner_timer = base_timer.__enter__()

    # Evaluate equality of the timer with itself (produces a bool-like result)
    eq_result = base_timer.__eq__(base_timer)

    # Exit the context manager to stop the base timer
    none_result = base_timer.__exit__()

    # Construct a timer using the inner timer as initial_text and eq_result as logger
    timer_with_timer_initial_text = timer.Timer(initial_text=inner_timer, logger=eq_result)

    # Construct a second timer using inner_timer as text, timer_with_timer_initial_text
    # as initial_text, and eq_result as logger
    timer_with_nested_config = timer.Timer(
        inner_timer,
        initial_text=timer_with_timer_initial_text,
        logger=eq_result,
    )

    # Start the nested-config timer to verify no exception is raised on start
    timer_with_nested_config.start()

def test_timer_start_stop_then_enter_and_copy():
    """Test that a Timer can be started and stopped explicitly,
    then re-entered as a context manager and copied."""

    # Use a named timer with the default "Timer started" initial text
    initial_text = "Timer started"
    t = timer.Timer(initial_text)

    # Explicitly start and stop the timer to record elapsed time
    none_result = t.start()
    elapsed = t.stop()

    # Re-enter the timer as a context manager (without exiting)
    entered_timer = t.__enter__()

    # Copy the timer instance
    t.copy()
