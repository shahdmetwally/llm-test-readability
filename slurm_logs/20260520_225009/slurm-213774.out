class TestTimers(unittest.TestCase):
    def setUp(self):
        self.timers = Timers()

    def test_add(self):
        self.timers.add('test_timer', 0.5)
        self.assertEqual(self.timers['test_timer'], 0.5)

    def test_clear(self):
        self.timers.add('test_timer', 0.5)
        self.timers.clear()
        self.assertEqual(self.timers._timings, {})
        self.assertEqual(self.timers.data, {})

    def test_setitem(self):
        with self.assertRaises(TypeError):
            self.timers['test_timer'] = 0.5

    def test_apply(self):
        self.timers.add('test_timer', 0.5)
        self.assertEqual(self.timers.apply(sum, 'test_timer'), 0.5)

if __name__ == '__main__':
    unittest.main()   


