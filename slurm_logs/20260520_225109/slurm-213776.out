        post_process_response:  def test_pyopenssl_inject_success():
    """
    Test that the pyopenssl_inject function correctly
    injects `pyOpenSSL` module to make sure `requests`
    uses it.
    """
    # Create a fixture to simulate a successful http request.
    http_request_success_fixture = conftest.pyopenssl_inject()

    # Apply the fixture to the yield_from transformer.
    while_yield_from_transform = yield_from.visit(http_request_success_fixture)

    # Check the output of the transformed function.
    assert while_yield_from_transform == http_request_success_fixture   


