import sys

def test_cherrypick_module_loading():
    # Module name extracted from the namespace
    module_name = "mymodule.mysubmodulethree"

    # Get the module from the loaded system modules
    loaded_module = sys.modules.get(module_name)

    # If the module is not in the system modules it has not been loaded, hence a test assertion failure should be raised
    if loaded_module is None:
        pytest.fail('The module has not been loaded.')

    # If the module has been loaded, assert it is the same as the expected module
    assert loaded_module == namespace['__name__']   


