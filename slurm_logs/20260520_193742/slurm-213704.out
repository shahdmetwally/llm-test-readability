def test_validation_lazy_and_try_conversions_with_ap():
    """Test that a Validation can be converted to Lazy and Try,
    and that ap() can be applied with the original Validation."""

    # Create an empty Validation (both value and errors are empty dicts)
    empty_dict = {}
    empty_validation = validation.Validation(empty_dict, empty_dict)

    # Convert the Validation to its Lazy representation
    lazy_validation = empty_validation.to_lazy()

    # Convert the Lazy representation to a Try
    try_validation = lazy_validation.to_try()

    # Apply the original Validation as an applicative argument to the Lazy
    ap_result = lazy_validation.ap(empty_validation)

    # Check the success state of the Try conversion
    try_validation.is_success()
```
