    def test_immutable_list_operations_with_nested_unshift_and_reduce():
        """
        Test a sequence of ImmutableList operations: creating empty lists,
        using unshift to prepend elements (including nested lists), reducing
        with a list as the accumulator/function, checking length, equality,
        and constructing a list with a custom is_empty value before calling find.
        """
        # Create an empty ImmutableList
        empty_list = immutable_list.ImmutableList()
    
        # Prepend the empty list onto itself to produce a new list
        list_with_self = empty_list.unshift(empty_list)
    
        # Reduce the original empty list using the new list as both
        # the initial value and the reducer function
        reduce_result = empty_list.reduce(list_with_self, list_with_self)
    
        # Get the length of the unshifted list
        length = list_with_self.__len__()
    
        # Prepend list_with_self onto itself
        doubly_nested_list = list_with_self.unshift(list_with_self)
    
        # Check equality between the doubly-nested list and the original empty list
        are_equal = doubly_nested_list.__eq__(empty_list)
    
        # Construct a new ImmutableList using the previously computed length as is_empty
        list_with_is_empty = immutable_list.ImmutableList(is_empty=length)
    
        # Attempt to find the reduce result within itself
>       reduce_result.find(reduce_result)

