def test_maybe_chaining_with_none_value_and_bytes():
    """
    Test chaining of Maybe monad operations when the wrapped value is None,
    verifying that ap, bind, to_validation, to_either, and to_try compose
    correctly without raising errors, even with mixed argument types.
    """
    raw_bytes = b"\xdbC\xcf\xe7/"
    none_value = None
    flag = True

    # Create a Maybe wrapping None with a True flag, then chain ap calls
    maybe_none_flagged = maybe.Maybe(none_value, flag)
    after_ap_none = maybe_none_flagged.ap(none_value)
    after_ap_bytes = after_ap_none.ap(raw_bytes)
    validation_from_chained = after_ap_bytes.to_validation()

    # Create a Maybe wrapping None with raw bytes as the secondary value
    maybe_none_bytes = maybe.Maybe(none_value, raw_bytes)

    # Exercise get_or_else, to_validation, bind, to_either, and ap
    get_or_else_result = maybe_none_bytes.get_or_else(maybe_none_bytes)
    validation_from_bytes_maybe = maybe_none_bytes.to_validation()
    bound_result = maybe_none_bytes.bind(validation_from_bytes_maybe)
    either_result = maybe_none_bytes.to_either()
    ap_result = maybe_none_bytes.ap(maybe_none_bytes)

    negative_int = -3289

    # Compare either with validation (cross-type equality check)
    eq_either_vs_validation = either_result.__eq__(validation_from_bytes_maybe)

    # Bind either with a Maybe argument
    either_bound = either_result.bind(maybe_none_bytes)

    # Convert the bytes-wrapped Maybe to Try, then check equality and convert bound result
    try_result = maybe_none_bytes.to_try()
    eq_maybe_vs_bound = maybe_none_bytes.__eq__(bound_result)
    validation_from_bound = bound_result.to_validation()

    # Apply a negative integer to the Try result
    try_result.ap(negative_int)
```
