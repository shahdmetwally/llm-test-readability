def test_timer_context_manager_with_various_configurations():
    """
    Test that Timer works as a context manager and that multiple Timer instances
    can be created with different configurations (initial_text, text args),
    and that __repr__ and __eq__ behave correctly alongside start/stop operations.
    """
    # Create a default Timer and enter its context
    default_timer = timer.Timer()
    context_timer = default_timer.__enter__()

    # Values used to configure additional Timer instances
    int_val = -1092
    float_arg_0 = timer.FloatArg()

    # Create a Timer using the active context timer as initial_text
    timer_with_context_initial_text = timer.Timer(initial_text=context_timer)

    float_arg_1 = timer.FloatArg()

    # Equality check between the default timer and an integer
    eq_result = default_timer.__eq__(int_val)

    # Stop the context timer and capture the elapsed time
    elapsed = context_timer.stop()

    # Create a Timer using a FloatArg as text and the equality result as initial_text
    timer_with_float_text = timer.Timer(text=float_arg_0, initial_text=eq_result)

    # Get string representations of timers
    default_timer_repr = default_timer.__repr__()
    float_text_timer_repr = timer_with_float_text.__repr__()

    # Start the timer configured with float text
    none_result = timer_with_float_text.start()
