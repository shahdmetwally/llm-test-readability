import logging
from timer import Timer

def test_instantiate_timer_error_without_args():
    with pytest.raises(TypeError):
        t = Timer()

def test_timer_enter_start_exit_start():
    t = Timer("test1")
    with t:
        assert t.start is not None
        assert t.elapsed is not None
        assert t.__enter__() == t
        assert t.start == t.start

def test_enter_and_exit_methods_should_behave_like_context_manager():
    with Timer("test2") as t:
        assert hasattr(t, '__enter__')
        assert hasattr(t, '__exit__')

def test_unique_test_name_test_timer_exit_method():
    with Timer("test3") as t:
        assert t.__exit__ is not None
    assert t.__exit__(None, None, None) is None

def test_init_timer_without_logger_raises_error():
    with pytest.raises(TypeError):
        t = Timer("test4", None)

def test_timer_initialization_checks():
    t = Timer("test5", logging.getLogger())
    assert t.name == "test5"
    assert t.logger is not None
    assert t.start is None

def test_timer_start_enter_and_stop():
    t = Timer("test6", logging.getLogger())
    t.__enter__()
    assert t.start is not None
    t.__exit__(None, None, None)
    assert t.elapsed is not None

def test_timer_equality_and_correct_exit():
    with Timer("test7", logging.getLogger()) as t1:
        assert t1.__exit__(None, None, None) is None
    with Timer("test7", logging.getLogger()) as t2:
        assert t1 == t2
    assert t2.elapsed < 0

def test_instantiate_timer_with_args():
    t = Timer("test8", logging.getLogger())
    assert t.name == "test8"
    assert t.logger is not None

def test_unique_test_name_for_exit_method_in_timer():
    t = Timer("test9", logging.getLogger())
    assert hasattr(t, '__exit__')   


