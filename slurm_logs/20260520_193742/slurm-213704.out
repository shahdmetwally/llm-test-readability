def test_maybe_chaining_with_none_value_and_bytes():
    """
    Test chaining of Maybe monad operations where the value is None or bytes.
    Verifies that ap, bind, to_validation, to_either, to_try, and get_or_else
    behave correctly when composed together, including equality checks across
    different monad types.
    """
    raw_bytes = b"\xdbC\xcf\xe7/"
    none_value = None
    is_some = True

    # Create a Maybe with no value (None) and some flag True
    maybe_none = maybe.Maybe(none_value, is_some)

    # Chain ap calls: apply None then bytes to the Maybe
    after_ap_none = maybe_none.ap(none_value)
    after_ap_bytes = after_ap_none.ap(raw_bytes)

    # Convert the chained result to a Validation
    validation_from_chain = after_ap_bytes.to_validation()

    # Create a second Maybe wrapping the bytes value
