# TEST_CASE_01: Test the transformation of a float to NamedTuple through the transform_to_namedtuple utility
def test_transforming_float_to_namedtuple():
    # given
    input_float = -476.66

    # when
    result = transform_to_namedtuple(input_float)

    # then
    assert isinstance(result, tuple)
    assert result.value == input_float
    assert result.__class__.__name__ == 'Value'   


