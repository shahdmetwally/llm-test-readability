def test_maybe_bind_map_then_invalid_method_on_set():
    """
    Test that:
    - Maybe can be constructed with a bool value and bound/mapped successfully.
    - Maybe can also be constructed with a tuple value.
    - Calling an invalid method (to_box) on a plain set raises an AttributeError,
      reflecting that set objects do not support box-style operations.
    """
    # Use True as a simple truthy value for Maybe construction
    true_value = True

    # Create a Maybe wrapping a bool and bind/map over it
    maybe_bool = maybe.Maybe(true_value, true_value)
    bound_result = maybe_bool.bind(true_value)
    mapped_result = bound_result.map(true_value)

    # Create a Maybe wrapping a tuple of bool values
    tuple_value = (true_value, true_value, true_value, true_value)
    maybe_tuple = maybe.Maybe(tuple_value, true_value)

    # Attempt to call a non-existent method on a plain set,
