```python
def test_validation_methods_with_mixed_types_and_chaining():
    """Test that Validation supports mixed-type construction and method chaining without errors."""

    # --- Setup: define base values used across multiple Validation instances ---
    sample_bytes = b"\xcc\xf7\x0e\x04\xc8Y\xc1 N\xbb\xa6\x85\x97\x90\x9e"
    none_value = None
    mixed_key_dict = {none_value: sample_bytes, sample_bytes: sample_bytes}

    # --- Construct a Validation with None as the fail value and a dict as success ---
    validation_with_none_fail = validation.Validation(none_value, mixed_key_dict)

    # Test equality comparison with itself, then convert to box
    eq_result = validation_with_none_fail.__eq__(validation_with_none_fail)
    boxed = validation_with_none_fail.to_box()

    # --- Construct a Validation where both fail and success are bytes ---
    validation_with_bytes = validation.Validation(sample_bytes, sample_bytes)

    # Convert the boxed value to either, then check is_fail on the bytes validation
    either_from_boxed = boxed.to_either()
    is_fail_result = validation_with_bytes.is_fail()

    # Convert the either to a try
    try_result = either_from_boxed.to_try()

    # --- Construct a Validation where fail is a bool (result of is_fail) ---
    validation_with_bool_fail = validation.Validation(is_fail_result, sample_bytes)

    # Get string representation of the bool-fail validation
    str_repr = validation_with_bool_fail.__str__()

    # Convert the bytes validation to lazy (result unused — tests call does not raise)
    lazy_from_bytes_validation = validation_with_bytes.to_lazy()

    # --- Construct another bytes/bytes Validation (mirrors validation_with_bytes) ---
    validation_bytes_copy = validation.Validation(sample_bytes, sample_bytes)

    # Call to_either on boxed again (result unused — tests repeated call does not raise)
    either_from_boxed_again = boxed.to_either()

    # Convert the bool-fail validation to lazy
    lazy_from_bool_validation = validation_with_bool_fail.to_lazy()

    # --- Construct a Validation where fail is a lazy and success is a Validation object ---
    validation_with_lazy_fail = validation.Validation(lazy_from_bool_validation, validation_bytes_copy)

    # Check is_fail on the bytes validation a second time (result unused — tests idempotency)
    is_fail_result_2 = validation_with_bytes.is_fail()

    # Map the string representation over the eq result
    eq_result.map(str_repr)
```
</final_code>
