def test_base_import_rewrite_visit_import_from_with_dict_unpacking():
    """
    Test that BaseImportRewrite.visit_ImportFrom can be called with
    an ImportFrom node constructed via dictionary unpacking (both positional
    and keyword arguments derived from the same dict).
    """
    # Arbitrary string used as both a rewrite source and dict key/value
    rewrite_source = "\x0bQHzaZ?\tpM/wFtV"
    base_import_rewrite = base.BaseImportRewrite(rewrite_source)

    # A second string used as a dict value
    rewrite_target = "%WE}A)"

    # Build a dict whose keys/values are reused for both positional and
    # keyword argument unpacking when constructing the ImportFrom node
    import_from_kwargs = {
        rewrite_source: rewrite_target,
        rewrite_target: rewrite_target,
        rewrite_target: rewrite_target,
        rewrite_source: rewrite_target,
    }
    import_from_node = ast3.ImportFrom(*import_from_kwargs, **import_from_kwargs)

    # Exercise the visitor method with the constructed node
    base_import_rewrite.visit_ImportFrom(import_from_node)
```
