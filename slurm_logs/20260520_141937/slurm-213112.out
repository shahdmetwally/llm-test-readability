    def test_validation_eq_with_different_args_returns_boxable_result():
        """Test that __eq__ on two differently-constructed Validation instances returns a result that supports .to_box()."""
        # A raw bytes value and a None value used to construct Validation objects
        some_bytes = b"\xcc\xf7\x0e\x04\xc8Y\xc1 N\xbb\xa6\x85\x97\x90\x9e"
        none_value = None
    
        # A dict with mixed key types (None and bytes) mapping to the same bytes value
        mixed_key_dict = {none_value: some_bytes, some_bytes: some_bytes}
    
        # First Validation: keyed by None, data is the mixed dict
        validation_with_none_key = validation.Validation(none_value, mixed_key_dict)
    
        # Second Validation: keyed by bytes, data is None
        validation_with_bytes_key = validation.Validation(some_bytes, none_value)
    
        # Compare the two differently-constructed Validation instances
        eq_result = validation_with_none_key.__eq__(validation_with_bytes_key)
    
        # The equality result should be convertible to a box
>       eq_result.to_box()
