    """Test that ImmutableList correctly instantiates and reduces."""

    # Instantiate and test variables
    bool_true = True
    empty_dict = {}
    immutable_list_0 = ImmutableList(tail=empty_dict)
    immutable_list_1 = ImmutableList(contents=bool_true, is_empty=bool_true)
    
    # Reduce immutable_list_1
    var_0 = immutable_list_1.to_list()
    immutable_list_1.reduce(var_0, var_0)

    # Assert that the reduction was correct
    assert var_0 == [bool_true, immutable_list_0]   


