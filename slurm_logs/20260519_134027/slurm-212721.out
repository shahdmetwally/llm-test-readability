        post_process_response:  def test_namedtupleutils_to_namedtuple_functionality_1():
    """
    Test that to_namedtuple function 
    correctly creates a namedtuple from a dictionary.
    """
    
    # Input bytes
    bytes_0 = b"F\xdb\xfdf\x8a\xe4\n\xa2\x1d[\xdc*\xa3\xba\xf6s}"

    # Dictionary using above bytes
    test_dict = {bytes_0: bytes_0, 
                 bytes_0: bytes_0, 
                 bytes_0: bytes_0}

    # Call the function under test
    result = namedtuple_utils.to_namedtuple(test_dict)
    
    # Assertions for testing
    assert len(result._fields) == 3, "Failed to create correct number of fields."
    assert all([field in result._fields for field in test_dict.keys()]), "Missing fields in namedtuple."   


