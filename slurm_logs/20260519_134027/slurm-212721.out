        post_process_response:  def test_to_namedtuple_normalize_path_normalize_values():
    """Test the to_namedtuple function, where the input values are dictionary or other collection types."""
 
    # given 
    str_input = "Normalize a given path."
    dict_input = {str_input: str_input, str_input: str_input, str_input: str_input}

    # when
    normal_named_tuple = namedtuple_utils.to_namedtuple(dict_input)
    bool_result = False
    normal_named_tuple_copy = namedtuple_utils.to_namedtuple(dict_input)
    tuple_wrapper = (normal_named_tuple_copy,)
    modified_dict = {normal_named_tuple_copy: normal_named_tuple, bool_result: normal_named_tuple_copy}
    named_tuple_of_dict = namedtuple_utils.to_namedtuple(modified_dict)
    named_tuple_copy = namedtuple_utils.to_namedtuple(named_tuple_of_dict)
    bool_modify = False
    named_tuple_of_modified_dict = namedtuple_utils.to_namedtuple(modified_dict)
    namedtuple_utils.to_namedtuple(bool_modify)
    
    # then
    assert normal_named_tuple == normal_named_tuple_copy
    assert named_tuple_of_dict == named_tuple_of_modified_dict
    assert named_tuple_copy == named_tuple_of_dict   


