    """Tests if nametuple.add appends values to a namedtuple."""

    # Setup
    nt = namedtuple("Test", ["a"])  # create namedtuple
    val_0, val_1 = 1.54, 2.31  # sample values
    tuple_0 = nt(a=[val_0])  # create namedtuple instance

    # Test 1: Add value
    nt.add(tuple_0, val_1)  # add second value

    assert len(tuple_0.a) == 2  # ensure values are stored correctly
    assert tuple_0.a == [val_0, val_1]  # ensure values are appended

