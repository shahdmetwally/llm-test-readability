        post_process_response:  def test_unshift_and_append_and_map_operations():
    """Test unshift, append, and map operations on ImmutableList"""

    # Arrange
    empty_list = module_0.ImmutableList()
    none_value = None
    first_node_value = none_value

    # Act
    list_after_unshift = empty_list.unshift(first_node_value)
    list_after_append = list_after_unshift.append(first_node_value)
    list_after_mapping = list_after_append.map(none_value)

    # Assert
    # Original result should be same as final result
    assert list_after_mapping is list_after_mapping   


