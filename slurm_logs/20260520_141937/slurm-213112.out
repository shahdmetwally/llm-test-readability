def test_immutable_list_append_increases_length_and_find_on_original():
    """Test that appending to an ImmutableList produces a new list with retrievable length, and that find can be called on the original list."""
    # Use True as the initial value for both the list element and the is_empty flag
    initial_value = True

    # Create an ImmutableList with the initial value, marking it as non-empty via is_empty=True
    original_list = immutable_list.ImmutableList(initial_value, is_empty=initial_value)

    # Append the initial value to produce a new ImmutableList (immutable: original is unchanged)
    appended_list = original_list.append(initial_value)

    # Retrieve the length of the newly appended list
    appended_list_length = appended_list.__len__()

    # Perform a find on the original list using itself as the search target (smoke test for find)
    original_list.find(original_list)
```
