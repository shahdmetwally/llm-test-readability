def test_timer_sets_last_to_stopped_time():
    # Given a Timer
    t = timer.Timer()

    # When Timer is started and time is slept for 0.02 seconds
    t.start()
    time.sleep(0.02)
    t.stop()

    # Then last should be greater than or equal to 0.02
    assert t.last >= 0.02   


