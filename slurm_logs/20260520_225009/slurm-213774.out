import validation as validation_module
import builtins as builtins_module
import time

def test_timer_starts_stops_correctly():
    """
    Test that a timer starts and stops correctly.
    Given a "Timer" class,
    When "Timer.start()" method is called,
    Then "_start_time" variable should be set and the timer state should be "running".
    When "Timer.stop()" method is called,
    Then "_stop_time" variable should be set and the timer state should be "stopped".
    """
    timer_instance = validation_module.Validation()
    initial_start_time = timer_instance.start()
    assert timer_instance.get_state() == "running"

    time.sleep(0.02)
    final_stop_time = timer_instance.stop()
    assert timer_instance.get_state() == "stopped"

    assert isinstance(initial_start_time, float)
    assert isinstance(final_stop_time, float)   


