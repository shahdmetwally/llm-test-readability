def test_timer_start_returns_none_when_logger_is_none():
    """Test that Timer.start() returns None and is callable when logger is disabled."""
    # Create a timer with logging disabled (logger=None)
    no_logger = None
    silent_timer = timer.Timer(logger=no_logger)

    # Start the timer and capture the return value (expected to be None)
    start_result = silent_timer.start()

    # Construct an empty dict and insert a None key mapping to itself
    empty_dict = {}
    dict_key = None
    setitem_result = empty_dict.__setitem__(dict_key, empty_dict)

    # Attempt to use the result of __setitem__ as a context manager
    setitem_result.__enter__()
```
