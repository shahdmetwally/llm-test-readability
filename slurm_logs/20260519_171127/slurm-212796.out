import pytest
import namedtupleutils as namedtuple_utils
import collections as collections_module

def test_to_namedtuple_with_float(self):
    """Test that to_namedtuple raises an exception when called with a float."""
    float_value = -476.66
    with pytest.raises(TypeError):
        namedtuple_utils.to_namedtuple(float_value)

def test_to_namedtuple_with_tuple_containing_set_and_float():
    """Test that to_namedtuple handles a nested tuple containing a set and a float value."""
    float_value = -67.0
    set_with_float = {float_value, float_value, float_value, float_value}
    input_tuple = (float_value, set_with_float)
    namedtuple_result = namedtuple_utils.to_namedtuple(input_tuple)
    namedtuple_utils.to_namedtuple(set_with_float)

def test_to_namedtuple_with_duplicate_key_dict_and_conversion():
    """Verify that a dictionary with a single key (appearing multiple times) 
    is correctly converted to a namedtuple, and that the resulting namedtuple 
    can also be converted without error."""
    key = "author"
    duplicate_key_dict = {key: key, key: key, key: key}
    namedtuple_result_1 = namedtuple_utils.to_namedtuple(duplicate_key_dict)
    namedtuple_result_2 = namedtuple_utils.to_namedtuple(namedtuple_result_1)

def test_to_namedtuple_rejects_bytes_input():
    """Verify that to_namedtuple raises an appropriate exception for invalid input."""
    invalid_bytes_input = b"xs&,\x9b\xc2\xf1\x80\xb3y"
    with pytest.raises(TypeError):
        namedtuple_utils.to_namedtuple(invalid_bytes_input)

def test_to_namedtuple_with_empty_tuple():
    """Test that to_namedtuple handles an empty tuple correctly."""
    empty_tuple = ()
    result = namedtuple_utils.to_namedtuple(empty_tuple)

def test_to_namedtuple_round_trips_nested_ordered_dicts_and_tuples():
    """Verify that to_namedtuple handles nested OrderedDicts and mixed tuple contents correctly."""
    original_ordered_dict = collections_module.OrderedDict()
    first_namedtuple = namedtuple_utils.to_namedtuple(original_ordered_dict)
    first_roundtrip = namedtuple_utils.to_namedtuple(first_namedtuple)
    second_namedtuple = namedtuple_utils.to_namedtuple(original_ordered_dict)
    second_roundtrip = namedtuple_utils.to_namedtuple(second_namedtuple)
    bytes_data = b"\xe2\xf8\xb9\x01\x8c\xa5\xed\xb1\x0e&rdHE"
    third_namedtuple = namedtuple_utils.to_namedtuple(original_ordered_dict)
    tuple_with_namedtuple_and_bytes = (first_roundtrip, bytes_data)
    fourth_namedtuple = namedtuple_utils.to_namedtuple(tuple_with_namedtuple_and_bytes)
    fifth_namedtuple = namedtuple_utils.to_namedtuple(original_ordered_dict)

def test_to_namedtuple_with_ordereddict_self_referential_keys():
    """Test converting an OrderedDict with self-referential string keys to a namedtuple."""
    key_value = "wm=-g\ry#\x0b#:*"
    input_dict = {key_value: key_value, key_value: key_value}
