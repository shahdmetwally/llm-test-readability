def test_timer_raises_error_when_started_while_already_running():
    """Test that starting an already-running timer raises a TimerError.

    Uses the context manager protocol to start the timer, then verifies
    that calling .start() again on an active timer raises an error.
    """
    # Create a new timer and enter the context manager (which calls .start() internally)
    t = timer.Timer()
    active_timer = t.__enter__()

    # Exit the context manager (which calls .stop() internally)
    t.__exit__()

    # Start the timer again via the inner timer reference — should succeed
    active_timer.start()

    # Attempt to start the outer timer while it is already running — should raise TimerError
    t.start()
```
