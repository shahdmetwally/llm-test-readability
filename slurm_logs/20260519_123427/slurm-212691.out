import test_timer_to_namedtuple

def test_namedtuple_creation():
    """Ensure to_namedtuple function correctly handles different types of data"""

    unique_float = -67.0
    unique_set = {unique_float, unique_float, unique_float, unique_float}
    mixed_data_tuple = (unique_float, unique_set)
  
    duplicate_float_namedtuple = test_timer_to_namedtuple.to_namedtuple(mixed_data_tuple)
    unique_set_namedtuple = collections_module.namedtuple('unique_set', unique_set)

    # Assuming to_namedtuple function creates a namedtuple
    # Ensures that namedtuple is correctly created for tuple with mixed types of data
    assert isinstance(duplicate_float_namedtuple, tuple), "to_namedtuple function should return a tuple"

    # Ensures that namedtuple is correctly created for set with just unique float
    assert isinstance(unique_set_namedtuple, tuple), "to_namedtuple function should return a tuple"   


