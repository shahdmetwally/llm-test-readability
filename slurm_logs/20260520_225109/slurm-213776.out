        post_process_response:  def test_immutable_list_behaviors():
    """
    This test ensures the basic behaviors of the ImmutableList, such as appending to a list,
    reducing a list, checking equality with another list, unshifting a list, converting to string,
    creating an empty list, appending to the empty list, and finding a list in another list.
    """
    empty_list = my_immutable_list.ImmutableList()
    list_with_self = empty_list.append(empty_list)
    reduced_list = list_with_self.reduce(list_with_self, list_with_self)
    assert reduced_list.__eq__(empty_list)
    list_with_self = list_with_self.unshift(list_with_self)
    list_str = list_with_self.__str__()
    empty_list = my_immutable_list.ImmutableList(is_empty=list_str)
    empty_list = empty_list.append(empty_list)
    list_with_self.find(reduced_list)   


