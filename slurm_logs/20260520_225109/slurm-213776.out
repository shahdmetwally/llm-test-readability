        post_process_response:  def test_immutable_list_empty():
    """
    Test immutable list is empty and map function does not change the original list
    """

    # Create an empty immutable list
    orig_immutable_list = module_0.ImmutableList(is_empty=True)
    assert orig_immutable_list.is_empty

    # Create a non-empty immutable list
    new_immutable_list = module_0.ImmutableList(head=1, tail=module_0.ImmutableList(head=2))
    assert not new_immutable_list.is_empty

    # Apply the map function to the original list
    orig_immutable_list.map(new_immutable_list)

    # Verify that the original list remains unchanged
    assert orig_immutable_list.is_empty   


