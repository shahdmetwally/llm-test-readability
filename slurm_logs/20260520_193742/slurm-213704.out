def test_maybe_get_or_else_and_filter_with_generic():
    """
    Test that Maybe.get_or_else returns the wrapped value when present,
    and that Maybe.filter can be called with a retrieved value.
    Also verifies to_box() and filter() on a Maybe wrapping a Generic instance.
    """
    default_int = 2281
    key_str = "gZ(\\mOcN"

    # Build a tuple payload containing strings and dicts
    inner_dict = {key_str: key_str}
    payload_tuple = (key_str, key_str, inner_dict, inner_dict)

    # Create a Maybe with a truthy presence flag, then retrieve or fall back to default
    is_present = True
    maybe_with_tuple = maybe.Maybe(payload_tuple, is_present)
    retrieved_value = maybe_with_tuple.get_or_else(default_int)

    # Create a Generic instance to wrap in a second Maybe
    generic_instance = typing.Generic()

    # Convert the first Maybe to a box representation
    is_absent = False
    boxed_value = maybe_with_tuple.to_box()

    # Create a Maybe wrapping the Generic instance with a falsy presence flag
    maybe_with_generic = maybe.Maybe(generic_instance, is_absent)

    # Filter the generic Maybe using the value retrieved from the first Maybe
    maybe_with_generic.filter(retrieved_value)

def test_maybe_to_validation_and_bind_with_various_types():
    """
    Test that Maybe instances with different value/fallback combinations
    correctly support to_validation(), get_or_else(), to_try(), and bind().
    Covers bool+None, int+empty-tuple, and float+float combinations.
    """
    # Create a Maybe with a truthy bool value and no fallback
    bool_value = True
    no_fallback = None
    maybe_bool = maybe.Maybe(bool_value, no_fallback)
    validation_from_bool = maybe_bool.to_validation()

    # Create a Maybe with a negative int value and an empty tuple as fallback
    int_value = -1784
    empty_tuple = ()
    maybe_int = maybe.Maybe(int_value, empty_tuple)

    # Convert to validation, resolve with fallback, and convert to try
    validation_from_int = maybe_int.to_validation()
    result_get_or_else = maybe_int.get_or_else(int_value)
    try_from_int = maybe_int.to_try()

    # Create a Maybe with float value and float fallback
    float_value = -286.64
    maybe_float = maybe.Maybe(float_value, float_value)

    # Bind the try result onto the int Maybe
    maybe_int.bind(try_from_int)

def test_maybe_map_with_none_value_and_to_either_with_int_value():
    """
    Test that Maybe.map() can be called with a set when wrapping None,
    and that Maybe.to_either() works correctly when wrapping an integer value.
    """
    # Create a Maybe wrapping None with is_some=True
    none_value = None
    is_some = True
    maybe_with_none = maybe.Maybe(none_value, is_some)

    # Attempt to map over the Maybe using a set as the mapping function
    mapping_set = {is_some}
    map_result = maybe_with_none.map(mapping_set)

    # Create a Maybe wrapping a negative integer with is_some=True
    int_value = -1095
    is_some_2 = True
    maybe_with_int = maybe.Maybe(int_value, is_some_2)

    # Convert the Maybe to an Either representation
    either_result = maybe_with_int.to_either()

def test_maybe_none_and_composite_interoperability_conversions():
    """
    Test that Maybe instances constructed with None and composite values
    can be converted to lazy, either, and try representations without error.
    Verifies interoperability of to_lazy(), to_either(), and to_try() on
    both a None-based Maybe and a tuple-based Maybe.
    """
    # Create a Maybe wrapping two None values
    none_value = None
    maybe_none = maybe.Maybe(none_value, none_value)

    # Use the None-based Maybe as part of a tuple payload
    maybe_tuple_payload = (maybe_none,)

    # Convert the None-based Maybe to a lazy representation
    lazy_from_none_maybe = maybe_none.to_lazy()

    # Create a Maybe wrapping a tuple and a False flag
    bool_false = False
    maybe_composite = maybe.Maybe(maybe_tuple_payload, bool_false)

    # Convert the None-based Maybe to an either representation
    either_from_none_maybe = maybe_none.to_either()

    # Convert the composite Maybe to a try representation
    try_from_composite = maybe_composite.to_try()

    # Convert the None-based Maybe to either again (second call)
    either_from_none_maybe_again = maybe_none.to_either()

    # Convert the composite Maybe to an either representation
    either_from_composite = maybe_composite.to_either()

    # Convert the try result of the composite Maybe to a lazy representation
    try_from_composite.to_lazy()

def test_maybe_to_try_then_to_box():
    """Test that a Maybe created with (True, False) can be converted to a Try
    and then subsequently converted to a Box without error."""
    is_just = True
    is_nothing = False

    # Construct a Maybe with a truthy 'just' value and a falsy 'nothing' value
    maybe_value = maybe.Maybe(is_just, is_nothing)
