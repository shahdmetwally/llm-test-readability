import pytest
import codetiming_timer as timer

def test_timer_error_can_be_instantiated():
    """Test that TimerError can be instantiated without raising any exceptions."""
    # Verify that TimerError is a valid, constructible exception class
    timer_error = timer.TimerError()

def test_timer_raises_error_when_started_while_already_running():
    """Test that starting an already-running timer raises a TimerError.

    Uses the context manager protocol to start the timer, then verifies
    that calling .start() again on an active timer raises an error.
    """
    # Create a new timer and enter the context manager (which calls .start() internally)
    t = timer.Timer()
    active_timer = t.__enter__()

    # Exit the context manager (which calls .stop() internally)
    t.__exit__()

    # Start the timer again via the inner timer reference — should succeed
    active_timer.start()

    # Attempt to start the outer timer while it is already running — should raise TimerError
    with pytest.raises(timer.TimerError):
        t.start()

def test_timer_context_manager_enter_and_exit():
    """Test that Timer correctly supports the context manager protocol via __enter__ and __exit__."""
    # Create a new Timer instance
    timer_instance = timer.Timer()

    # Enter the context manager, which starts the timer and returns the Timer instance
    active_timer = timer_instance.__enter__()

    # Exit the context manager, which stops the timer
    result = timer_instance.__exit__()

def test_timer_exit_without_start_raises_error():
    """Test that calling __exit__ on a Timer that was never started raises a TimerError."""
    t = timer.Timer()

    # Attempting to exit a timer context that was never started should raise an error
    with pytest.raises(timer.TimerError):
        t.__exit__()

def test_timer_start_with_no_logger_then_invalid_context_manager():
    """Test that starting a timer with logger=None succeeds, and that using a
    plain dict as a context manager raises an AttributeError (dicts do not
    support the context manager protocol)."""
    # Create a Timer instance with logging disabled
    no_logger = None
    t = timer.Timer(logger=no_logger)

    # Start the timer (should succeed silently since logger=None)
    result_of_start = t.start()

    # Attempt to use a plain dict as a context manager, which is invalid
    empty_dict = {}
    none_value = None

    # Set a None key in the dict (populates it, but __setitem__ returns None)
    set_item_result = empty_dict.__setitem__(none_value, empty_dict)

    # Calling __enter__ on None (the return value of __setitem__) will raise AttributeError
    with pytest.raises(AttributeError):
        set_item_result.__enter__()

def test_timer_context_manager_enter_stop_and_repr():
    """Test that a Timer used as a context manager can be stopped, compared,
    and that repr works on both plain and configured Timer instances."""

    # Create a base timer and enter it as a context manager
