timer_1 = timer_0.__enter__()   # starts timer, returns self (timer_1 is same as timer_0)
none_type_0 = timer_0.__exit__() # stops the timer
none_type_1 = timer_1.start()   # starts again on the same object (timer_1 == timer_0)
