    def test_to_namedtuple_with_duplicate_keys_in_dict_should_not_raise_error():
        """Verify that converting an OrderedDict created from a dict with duplicate keys works correctly."""
        # A string that, when coerced into a dict, forces duplicate key entries
        duplicate_key_string = "wm=-g\ry#\x0b#:*"
    
