    # A flat dict with identical keys/values (duplicate keys collapse to one entry)
    flat_dict = {path_normalization_docstring: path_normalization_docstring, path_normalization_docstring: path_normalization_docstring, path_normalization_docstring: path_normalization_docstring}

    # Convert a simple flat dict to a namedtuple
    namedtuple_from_flat_dict = namedtupleutils.to_namedtuple(flat_dict)

    bool_false = False

    # Convert the same flat dict again to produce a second namedtuple
    second_namedtuple_from_flat_dict = namedtupleutils.to_namedtuple(flat_dict)

    # Wrap that namedtuple in a tuple, then convert the tuple to a namedtuple
    tuple_wrapping_namedtuple = (second_namedtuple_from_flat_dict,)
    namedtuple_from_tuple = namedtupleutils.to_namedtuple(tuple_wrapping_namedtuple)

    # Build a dict keyed by a namedtuple and a bool, then convert to a namedtuple
    mixed_key_dict = {namedtuple_from_tuple: second_namedtuple_from_flat_dict, bool_false: second_namedtuple_from_flat_dict}
    namedtuple_from_mixed_dict = namedtupleutils.to_namedtuple(mixed_key_dict)

    # Convert an already-namedtuple value to a namedtuple (idempotency check)
    namedtuple_from_namedtuple = namedtupleutils.to_namedtuple(namedtuple_from_mixed_dict)

    bool_false_2 = False

    # Re-convert the mixed-key namedtuple (another redundant conversion for coverage)
    namedtupleutils.to_namedtuple(namedtuple_from_mixed_dict)

    # Convert a plain bool — exercises the primitive/non-iterable code path
    namedtupleutils.to_namedtuple(bool_false_2)

def test_to_namedtuple_with_nested_structures_and_repeated_conversions():
    """Test that to_namedtuple handles nested structures (list containing a tuple with a dict),
    repeated conversions of already-converted results, and a plain integer input."""

    # Build a nested input: a list containing a tuple of (string, dict)
    key_str = "\x0cMv"
    empty_tuple = ()
    nested_dict = {key_str: empty_tuple, empty_tuple: key_str, empty_tuple: empty_tuple}
    inner_tuple = (key_str, nested_dict)
    input_list = [inner_tuple]

    # Convert the nested list structure to a namedtuple
    converted_once = namedtupleutils.to_namedtuple(input_list)

    # Convert the already-converted result again (idempotency check)
    converted_twice = namedtupleutils.to_namedtuple(converted_once)

    # Convert a third time to further verify repeated conversion stability
    converted_thrice = namedtupleutils.to_namedtuple(converted_twice)

    # Verify that a plain integer can also be passed without error
    plain_int = 2
    namedtupleutils.to_namedtuple(plain_int)

