def test_filter_on_none_value_maybe_returns_lazy_and_filters_again():
    """
    Test that filtering a Maybe wrapping None with a tuple value produces a
    lazy representation, and that filtering another None-valued Maybe with
    that lazy result does not raise an error.
    """
    sentinel_int = -283
