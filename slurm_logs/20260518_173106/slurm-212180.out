        post_process_response:  def test_namedtuple_conversion_on_bytes():
    """
    This test checks that the 'to_namedtuple' function converts a bytes object correctly to a named tuple.
    """
    # Given some bytes.
    input_bytes = b"xs&,\x9b\xc2\xf1\x80\xb3y"

    # When the 'to_namedtuple' function is called with the given bytes.
    result = tup_util.to_namedtuple(input_bytes)

    # Then the returned result is a namedtuple.
    assert isinstance(result, col.namedtuple)

    # And the namedtuple contains the same data as the bytes.
    assert tuple(result) == tuple(input_bytes)   


