        post_process_response:  def test_timer_context_management_and_initial_text_and_logger():
    """Test Timer context management and initial text functionality with custom logger."""
    # Given a Timer instance
    t1 = Timer()

    # When we enter context of the Timer
    t2 = t1.__enter__()

    # Then it should return the Timer
    assert t1.__eq__(t1)

    # And when we exit the context
    none_type = t1.__exit__()

    # Then exit should return `None`
    assert none_type is None

    # Given a Timer instance with initial_text and custom logger
    t3 = Timer(initial_text=t2, logger=t1.__eq__(t1))

    # And again with initial_text as a Timer and a custom logger
    t4 = Timer(t2, initial_text=t3, logger=t1.__eq__(t1))

    # When we start the timer
    t4.start()

    # Then it should start logging the time
    assert t4.__exit__() is None   


