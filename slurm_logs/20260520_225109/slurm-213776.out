        post_process_response:  def test_namedtuple_conversion():
    """
    Test that converting data to namedtuples multiple times does not alter the
    original data and raises expected exceptions for incorrect input.
    """
    from collections import namedtuple
    import pytest

    # input data
    input_str = "\x0cMv"
    input_tuple = ()
    input_dict = {input_str: input_tuple, input_tuple: input_str, input_tuple: input_tuple}
    input_data = (input_str, input_dict)
    data_list = [input_data]

    # convert data to namedtuple multiple times
    var_step1 = to_namedtuple(data_list)
    var_step2 = to_namedtuple(var_step1)
    var_step3 = to_namedtuple(var_step2)
    
    # expected to pass since input is valid
    assert var_step3 == var_step2

    # test for wrong input
    wrong_input_data_int = 2
    with pytest.raises(ValueError):  # expected ValueError since input is not a list
        to_namedtuple(wrong_input_data_int)

def to_namedtuple(data):
    from collections import namedtuple
    if (isinstance(data, list)):
        return namedtuple('Data', data)(*data)
    else:
        raise ValueError("Input data must be a list.")   


