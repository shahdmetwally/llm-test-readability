```python
def test_maybe_monad_operations_chaining():
    """Test chaining of Maybe monad operations including ap, to_validation, bind, to_either, and to_try."""
    raw_bytes = b"\xdbC\xcf\xe7/"
    none_value = None
    bool_true = True

    # Create first Maybe with None value and True flag
    first_maybe = module_0.Maybe(none_value, bool_true)
    ap_result_1 = first_maybe.ap(none_value)
    ap_result_2 = ap_result_1.ap(raw_bytes)
    validation_1 = ap_result_2.to_validation()

    # Create second Maybe with None value and raw_bytes
    second_maybe = module_0.Maybe(none_value, raw_bytes)
    get_or_else_result = second_maybe.get_or_else(second_maybe)
    validation_2 = second_maybe.to_validation()
    bind_result = second_maybe.bind(validation_2)
    either_result = second_maybe.to_either()
    ap_result_3 = second_maybe.ap(second_maybe)

    # Test equality and further chaining
    negative_int = -3289
    eq_result_1 = either_result.__eq__(validation_2)
    bind_result_2 = either_result.bind(second_maybe)
    try_result = second_maybe.to_try()
    eq_result_2 = second_maybe.__eq__(bind_result)
    validation_3 = bind_result.to_validation()
    try_result.ap(negative_int)
```
