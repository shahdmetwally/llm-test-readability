        post_process_response:  def test_empty_list_append_operation_new():
    """
    Test the 'append' operation on empty list. It should return a list 
    identical to the one used in 'append' operation.
    """
    empty_list = immutable_list.ImmutableList()  # An empty list
    list_for_append = immutable_list.ImmutableList()  # Create a list for append operation
    list_after_append = empty_list.append(list_for_append)  # Append the empty list with list_for_append
    assert list_after_append.to_list() == list_for_append.to_list()  # The output should be list_for_append

    empty_list_after_append = list_after_append.append(none_value)  # Try appending None to the list
    assert empty_list_after_append.to_list() == list_after_append.to_list() + [none_value]  # The output should be the list after append with None   


