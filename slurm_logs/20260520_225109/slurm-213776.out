        post_process_response:  def test_immutable_list_operations_new():
    """Test immutable list operations such as unshift, reduce, equality check, and len function."""

    # Create an empty ImmutableList
    empty_list = immutable_list.ImmutableList()

    # Unshift an item into the list
    unshifted_list = immutable_list.unshift(empty_list)

    # Reduce the unshifted list
    reduced_list = immutable_list.reduce(unshifted_list, unshifted_list)

    # Calculate the length of the list
    len_reduced_list = immutable_list.__len__(unshifted_list)

    # Unshift a second item into the list
    second_unshifted_list = immutable_list.unshift(unshifted_list)

    # Check equality with the empty list
    is_equal = immutable_list.__eq__(empty_list)

    # Create a new list with a custom empty flag
    custom_empty_list = immutable_list.ImmutableList(is_empty=len_reduced_list)

    # Find an item in the list
    var_0 = immutable_list.find(second_unshifted_list)

    # Test the final state
    assert var_0 == reduced_list   


