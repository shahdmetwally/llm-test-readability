def test_validation_chained_operations_with_mixed_types():
    """
    Test that Validation objects can be constructed with mixed types (None, bytes, bool)
    and that chained operations (eq, to_box, to_either, to_try, to_lazy, is_fail, map)
    execute without error, covering interplay between multiple Validation instances.
    """
    # Arbitrary bytes value used as a payload/key in Validation construction
    raw_bytes = b"\xcc\xf7\x0e\x04\xc8Y\xc1 N\xbb\xa6\x85\x97\x90\x9e"
    none_value = None

    # A dict with mixed-type keys to serve as the 'value' argument
    mixed_dict = {none_value: raw_bytes, raw_bytes: raw_bytes}

    # Validation with None as the 'is_success' indicator and a mixed dict as value
    validation_none_key = validation.Validation(none_value, mixed_dict)

    # Test equality of a Validation instance with itself
    eq_result = validation_none_key.__eq__(validation_none_key)

    # Convert to Box; will be reused for further chained conversions
    boxed = validation_none_key.to_box()

    # A second Validation instance using raw bytes for both arguments
    validation_bytes = validation.Validation(raw_bytes, raw_bytes)

    # Chain: Box -> Either -> Try
    either_from_box = boxed.to_either()
    is_fail_result = validation_bytes.is_fail()
    try_from_either = either_from_box.to_try()

    # Validation whose 'is_success' flag is derived from is_fail_result (a bool)
    validation_from_bool = validation.Validation(is_fail_result, raw_bytes)

    # String representation of the bool-keyed Validation
    str_repr = validation_from_bool.__str__()

    # Convert bytes-based Validation to Lazy
    lazy_from_bytes_validation = validation_bytes.to_lazy()

    # Another bytes-based Validation, used as a nested value
    validation_bytes_nested = validation.Validation(raw_bytes, raw_bytes)

    # Re-derive Either from the original boxed value (second call, same source)
    either_from_box_again = boxed.to_either()

    # Convert the bool-keyed Validation to Lazy; used as constructor arg below
    lazy_from_bool_validation = validation_from_bool.to_lazy()

    # Validation whose value is the nested Validation object
    validation_nested = validation.Validation(lazy_from_bool_validation, validation_bytes_nested)

    # Check is_fail on the bytes-based Validation a second time
    is_fail_result_again = validation_bytes.is_fail()

    # Map the string representation over the eq_result (a Validation)
    eq_result.map(str_repr)
```
