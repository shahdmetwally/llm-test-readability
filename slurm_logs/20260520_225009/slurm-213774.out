    def setUpClass(cls):
        cls.task_monitor = TaskMonitor()

    def test_timer_starts_and_stops(self):
        with patch('builtins.input', side_effect=["n"]):
            self.task_monitor.start_timer("test_task")
            time.sleep(1)
            self.task_monitor.stop_timer("test_task")
        self.assertIsNotNone(self.task_monitor.execution_times["test_task"])

    def test_verify_output_and_reset_capture(self):
        with patch('sys.stdout', new_callable=StringIO) as fake_out, patch('sys.stderr', new_callable=StringIO) as fake_err:
            self.task_monitor.capture_output(True, "filename.txt")
            print("This line should be in the captured output")
            self.task_monitor.reset_capture()
            err_message = "This line should not be in the captured output"
            try:
                raise Exception(err_message)
            except Exception as e:
                error = str(e)
            self.assertNotEqual(fake_out.getvalue(), "This line should be in the captured output")
            self.assertNotEqual(fake_err.getvalue(), err_message)   


