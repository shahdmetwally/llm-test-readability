        post_process_response:  class TestImportInterceptor:

    def test_repopulate_modules_by_filename(self):
        interceptor = ImportInterceptor()
        interceptor.repopulate_modules_by_filename()
        assert 'importlib' not in interceptor.module_by_filename_cache
        assert 'six.py' not in interceptor.module_by_filename_cache

    def test_should_ignore_filename(self):
        interceptor = ImportInterceptor()
        assert interceptor.should_ignore_filename('importlib')
        assert interceptor.should_ignore_filename('six.py')
        assert not interceptor.should_ignore_filename('importlib_test.py')
        assert not interceptor.should_ignore_filename('/usr/lib/python3.8/site-packages/six.py')

    def test_find_spec(self):
        interceptor = ImportInterceptor()
        spec = interceptor.find_spec('test_import_interceptor', None)
        assert spec.has_location('/usr/lib/python3.8/site-packages/test_import_interceptor.py')   


