```python
def test_maybe_false_values_chain_through_transformations():
    """Test that Maybe(False, False) supports equality, conversion to Either/Lazy/Validation, and map chaining."""

    false_value = False

    # Verify equality comparison works on a Maybe constructed with False values
    maybe_with_false = maybe.Maybe(false_value, false_value)
    eq_result = maybe_with_false.__eq__(false_value)

    # Build a second Maybe and chain it through to_either, to_lazy, and to_validation
    maybe_for_chaining = maybe.Maybe(false_value, false_value)
    either_result = maybe_for_chaining.to_either()
    lazy_result = maybe_for_chaining.to_lazy()
    validation_result = lazy_result.to_validation()

    # Verify that a third Maybe can have map called with the validation result
    maybe_for_map = maybe.Maybe(false_value, false_value)
    maybe_for_map.map(validation_result)
```
