def test_to_namedtuple_with_ordered_dict_containing_same_key_twice():
    """Test that to_namedtuple handles an OrderedDict where the same key is provided twice.

    The second occurrence of the key should overwrite the first in the OrderedDict,
    and the conversion to a namedtuple should succeed with the last value.
    """
    key_str = "wm=-g\ry#\x0b#:*"
    input_dict = {key_str: key_str, key_str: key_str}
