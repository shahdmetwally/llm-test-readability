    """Test to_namedtuple method with set input returns correct result."""
    float_input = -67.0
    set_input = {float_input, float_input, float_input, float_input}
    tuple_input = (float_input, set_input)
    expected_namedtuple = utils.to_namedtuple(tuple_input)  # expected: namedtuple('nt_0', 'f0 nt_1')

    try:
        result_namedtuple = utils.to_namedtuple(set_input)  # should raise TypeError
    except TypeError:
        result_namedtuple = None

    assert isinstance(expected_namedtuple, collections.namedtuple)
    assert result_namedtuple is None
    assert expected_namedtuple.f0 == float_input
    assert expected_namedtuple.nt_1 == set_input
