    """Test that calling __exit__ on a Timer without context manager does not raise an error."""
    # Arrange
    float_arg_0 = timer.FloatArg()
    timer_error_0 = timer.TimerError()
    timer_0 = timer.Timer()

    # Act
    timer_0.__exit__()

