        post_process_response:  def test_immutable_list_find_method():
    """
    This test is used to check if the 'find' method of ImmutableList works as expected.
    This test checks if the 'find' method can find an existing element correctly.
    """
    # given
    is_empty_value = False
    immutable_list = ImmutableList(is_empty_value, is_empty=is_empty_value)
    to_list_result = immutable_list.to_list()

    # when
    find_result = immutable_list.find(to_list_result)

    # then
    # The 'find' method should return the to_list_result since it's part of the list
    assert find_result == to_list_result
    with pytest.raises(ValueError):
        immutable_list.find('Non-existing element')   


