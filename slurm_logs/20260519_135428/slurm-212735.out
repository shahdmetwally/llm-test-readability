def test_timer_start_stop_with_no_logger_then_setitem_and_repr_on_result():
    """Test that Timer with logger=None can be started and stopped via context manager exit,
    and that dict __setitem__ returns None whose repr is the string 'None'."""

    # Create a Timer with no logging output
    t = timer.Timer(logger=None)

    # Start the timer manually
    t.start()

    # Stop the timer using the context manager exit protocol
    t.__exit__()

    # Set a dict entry mapping None key -> the dict itself
    # __setitem__ always returns None
    test_dict = {}
    setitem_result = test_dict.__setitem__(None, test_dict)
    assert setitem_result is None

    # Verify that repr of None is the string 'None'
    repr_result = setitem_result.__repr__()
    assert repr_result == 'None'

def test_timer_start_with_nested_timer_references():
    """Test that Timer can be started when its initial_text and logger arguments
    reference other Timer instances, including one that has already completed
    a full enter/exit cycle."""

    # Create and run a base timer through a full context-manager cycle
    base_timer = timer.Timer()
    entered_timer = base_timer.__enter__()
    eq_result = base_timer.__eq__(base_timer)  # Evaluate equality before exit
    base_timer.__exit__()

    # Create a second timer using the entered timer as initial_text and eq_result as logger
    timer_with_timer_initial_text = timer.Timer(initial_text=entered_timer, logger=eq_result)

    # Create a third timer using entered_timer as the first positional arg,
    # timer_with_timer_initial_text as initial_text, and eq_result as logger
    timer_with_nested_references = timer.Timer(
        entered_timer,
        initial_text=timer_with_timer_initial_text,
        logger=eq_result,
    )

    # Start the timer that references other timer objects in its configuration
    timer_with_nested_references.start()

def test_timer_start_stop_then_enter_and_copy():
    """Test that a Timer can be started and stopped explicitly,
    then re-entered as a context manager, followed by a copy operation."""

    # Use a named timer with the default "Timer started" initial text
    initial_text = "Timer started"
    t = timer.Timer(initial_text)

    # Start and stop the timer explicitly to verify basic lifecycle
    none_type_0 = t.start()
    elapsed = t.stop()

    # Re-enter the timer as a context manager (without exiting)
    entered_timer = t.__enter__()

    # Copy the timer object state
    t.copy()
```
