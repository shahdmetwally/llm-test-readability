        post_process_response:  from collections import namedtuple

class TestNamedTuple:
    def setUp(self):
        self.Point = namedtuple('Point', 'x y')

    def test_to_namedtuple_converts_input_into_namedtuple(self):
        point = self.Point(1, 2)
        assert point.x == 1
        assert point.y == 2

    def test_namedtuple_to_namedtuple_conversion_succeeds_1(self):
        p1 = self.Point(1, 2)
        p2 = self.Point(*p1)
        assert p2.x == 1
        assert p2.y == 2

    def test_namedtuple_to_namedtuple_conversion_succeeds_2(self):
        p1 = self.Point('test_namedtuple_to_namedtuple_conversion_succeeds_2', 2)
        p2 = self.Point(*p1)
        assert p2.x == 'test_namedtuple_to_namedtuple_conversion_succeeds_2'
        assert p2.y == 2

    def test_namedtuple_to_namedtuple_conversion_succeeds_3(self):
        p1 = self.Point([1, 2, 3], 2)
        p2 = self.Point(*p1)
        assert p2.x == [1, 2, 3]
        assert p2.y == 2

    def test_namedtuple_add_method_1(self):
        p1 = self.Point(1,2)
        p2 = self.Point(3,4)
        result = p1 + p2
        assert (result[0], result[1]) == (4,6)

    def test_namedtuple_clear_method_1(self):
        p1 = self.Point(1,2)
        p2 = p1._replace(x=0, y=0)
        assert p2 == self.Point(0,0)   


