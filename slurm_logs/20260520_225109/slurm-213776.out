    """
    Test initial_text when set to True.
    This should output an initial message indicating the name of the timer.
    """

    # Given the timer when initial_text is set to True,
    # the output message should contain the timer's name.
    timer_name = "test_timer"
    timer = codetiming_timer.Timer(name=timer_name, text=TIME_MESSAGE, initial_text=True)
    timer.start()
    waste_time()
    timer_elapsed_time = timer.stop()

    # Then the elapsed time should be logged along with the initial text.
    assert timer_elapsed_time == TIME_MESSAGE.format(timer_elapsed_time)
    assert len(timer.logger.messages.split("\n")) == 2
    assert "Timer {name} started".format(name=timer_name) in timer.logger.messages
    assert timer.logger.messages.split("\n")[1] == TIME_MESSAGE.format(timer_elapsed_time)   


