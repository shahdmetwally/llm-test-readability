def test_immutable_list_reduce_with_to_list_result_as_both_arguments():
    """Test that reduce() can be called using the to_list() result as both arguments on a non-empty ImmutableList."""
    true_flag = True
    empty_dict = {}

    # Construct a list with an empty dict as its tail (used as part of setup)
    list_with_empty_dict_tail = immutable_list.ImmutableList(tail=empty_dict)

    # Construct a non-empty ImmutableList with is_empty explicitly set to True
    non_empty_immutable_list = immutable_list.ImmutableList(true_flag, is_empty=true_flag)

    # Convert the ImmutableList to a plain Python list
    list_representation = non_empty_immutable_list.to_list()

    # Call reduce using the list representation as both arguments
    non_empty_immutable_list.reduce(list_representation, list_representation)
```
</final_code>
