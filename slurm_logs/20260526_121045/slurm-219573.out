def test_maybe_chained_ap_bind_and_conversions_with_none_value():
    """
    Test chaining of ap, bind, and conversion methods (to_validation, to_either, to_try)
    on Maybe instances constructed with None and bytes values.
    Verifies that method chaining works correctly when Maybe wraps None or a bytes value.
    """
    raw_bytes = b"\xdbC\xcf\xe7/"
    none_value = None
    bool_true = True

    # Create a Maybe wrapping None with a True flag, then chain ap calls
    maybe_none_true = maybe.Maybe(none_value, bool_true)
    ap_result_0 = maybe_none_true.ap(none_value)       # ap with None
    ap_result_1 = ap_result_0.ap(raw_bytes)             # ap with bytes
    validation_0 = ap_result_1.to_validation()          # convert to Validation

    # Create a Maybe wrapping None with a bytes value
    maybe_none_bytes = maybe.Maybe(none_value, raw_bytes)

    # Exercise get_or_else, to_validation, bind, to_either, and ap on maybe_none_bytes
    get_or_else_result = maybe_none_bytes.get_or_else(maybe_none_bytes)
    validation_1 = maybe_none_bytes.to_validation()
    bind_result = maybe_none_bytes.bind(validation_1)   # bind using the validation
    either_result = maybe_none_bytes.to_either()        # convert to Either
    ap_result_2 = maybe_none_bytes.ap(maybe_none_bytes) # ap with itself

    negative_int = -3289

    # Equality check between Either and Validation
    eq_either_validation = either_result.__eq__(validation_1)

    # Bind on the Either result using maybe_none_bytes
    either_bind_result = either_result.bind(maybe_none_bytes)

    # Convert maybe_none_bytes to Try, then check equality and convert bind result
    try_result = maybe_none_bytes.to_try()
    eq_maybe_bind = maybe_none_bytes.__eq__(bind_result)
    validation_2 = bind_result.to_validation()

    # ap on the Try result with a negative integer
    try_result.ap(negative_int)
