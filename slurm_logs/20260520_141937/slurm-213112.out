    converter_plugin = base_plugin.ConverterPlugin(raw_bytes_input)

    # Instantiate TransportPlugin and invoke get_adapter() — should not raise
    transport_plugin = base_plugin.TransportPlugin()
    transport_plugin.get_adapter()
