        post_process_response:  def test_maybe_instance_created_correctly():
    bytes_0 = b"\x9f\x02Gj\xbbw\xdb\x8b\xe7\xda"
    none_type_0 = None
    maybe_0 = m.Maybe(bytes_0, none_type_0)
    box_0 = maybe_0.to_box()
    int_0 = 0
    bool_0 = True
    maybe_1 = m.Maybe(int_0, bool_0)
    filtered_1 = maybe_1.filter(bool_0)
    lazy_1 = maybe_1.to_lazy()
    ap_1 = filtered_1.ap(maybe_0)
    filtered_2 = filtered_1.filter(ap_1)
    maybe_2 = m.Maybe(lazy_1, box_0)
    equal_bool_1 = lazy_1.__eq__(bool_0)

    assert maybe_0.val == bytes_0
    assert maybe_0.is_just == True
    assert box_0.val == bytes_0
    assert bool_0 == False
    assert filtered_1.val == None
    assert filtered_1.is_nothing == True
    assert Try(lambda: lazy_1.val).is_success == False
    assert ap_1.val == None
    assert filtered_2.val == None
    assert filtered_2.is_nothing == True
    assert box_0.val == bytes_0
    assert equal_bool_1 == True   


