def test_to_namedtuple_with_nested_mixed_types_should_preserve_structure():
    """Test that to_namedtuple handles nested structures with string keys, empty tuples,
    and dicts containing mixed types, and that repeated conversion is idempotent."""
    # Input values
    string_key = "\x0cMv"
    empty_tuple = ()
    
    # Dict with mixed key/value types (string, tuple)
    mixed_dict = {string_key: empty_tuple, empty_tuple: string_key, empty_tuple: empty_tuple}
    
    # Nest inside list via tuple
    nested_tuple = (string_key, mixed_dict)
    input_list = [nested_tuple]
    
    # Convert to namedtuple and back multiple times
    first_conversion = namedtuple_utils.to_namedtuple(input_list)
    second_conversion = namedtuple_utils.to_namedtuple(first_conversion)
    third_conversion = namedtuple_utils.to_namedtuple(second_conversion)
    
    # Test edge case: conversion of a plain integer
    plain_integer = 2
    namedtuple_utils.to_namedtuple(plain_integer)
