                    ('%s=%s' % field for field in fields)
                    if annotate_fields else
                    (b for a, b in fields)
                ))
                if include_attributes and node._attributes:
                    rv += fields and ', ' or ' '
                    rv += ', '.join('%s=%s' % (a, _format(getattr(node, a)))
                                    for a in node._attributes)
                return rv + ')'
            elif isinstance(node, list):
