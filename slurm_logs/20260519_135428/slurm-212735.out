def test_timer_start_with_none_logger_returns_none():
    """Test that starting a timer with logger=None succeeds and returns None,
    and that dict.__setitem__ also returns None which cannot be used as a context manager."""

    # Create a Timer with no logger so elapsed time is not printed
    none_logger = None
    t = timer.Timer(logger=none_logger)

    # Start the timer (no output expected since logger is None)
    start_result = t.start()

    # Construct a dict and insert a None key mapping to itself,
    # then attempt to enter the result as a context manager
    empty_dict = {}
    none_key = None
    set_result = empty_dict.__setitem__(none_key, empty_dict)

    # __enter__ is called on the return value of __setitem__ (which is None)
    with pytest.raises(AttributeError):
        set_result.__enter__()
