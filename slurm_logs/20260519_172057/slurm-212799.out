import pytest
import codetiming_timer as timer

def test_timer_error_instantiation():
    """Test that a TimerError instance can be created."""
    timer_error = timer.TimerError()

def test_timer_restart_after_context_manager_exit_raises_error():
    """Test that starting a timer after using it as a context manager raises TimerError."""
    timer_0 = timer.Timer()
    timer_1 = timer_0.__enter__()
    none_type_0 = timer_0.__exit__()
    none_type_1 = timer_1.start()
    timer_0.start()

def test_timer_context_manager_behavior():
    """Test that a Timer can be used as a context manager via __enter__ and __exit__."""
    # Create a Timer instance
    timer_0 = timer.Timer()

    # Enter the context, starting the timer
    timer_1 = timer_0.__enter__()

    # Exit the context, stopping the timer and recording elapsed time
    none_type_0 = timer_0.__exit__()

def test_stopping_unstarted_timer_using_exit_raises_error() -> None:
    """Test that stopping a timer that was never started raises a TimerError."""
    # Create a timer without starting it
    timer_0 = timer.Timer()

    # Attempting to stop an unstarted timer should raise a TimerError
    with pytest.raises(timer.TimerError):
        timer_0.__exit__(None, None, None)

def test_timer_without_logger_does_not_print():
    """Test that a timer with logger=None does not produce output."""
    # Create timer with no logger
    timer_0 = timer.Timer(logger=None)

    # Start the timer (should not produce any output)
    none_type_1 = timer_0.start()

    # Waste some time with an empty dict operation
    dict_0 = {}
    none_type_2 = None
    var_0 = dict_0.__setitem__(none_type_2, dict_0)

    # Use the return value as a context manager
    var_0.__enter__()

def test_timer_context_manager_with_invalid_initial_text_and_equality() -> None:
    """Test Timer context manager usage combined with a Timer used as initial_text (invalid type) and equality comparison."""
    timer_0 = timer.Timer()
    timer_1 = timer_0.__enter__()  # Start timer via context manager
    int_0 = -1092
    float_arg_0 = timer.FloatArg()
    timer_2 = timer.Timer(initial_text=timer_1)  # initial_text receives a Timer instance (invalid type)
    float_arg_1 = timer.FloatArg()
