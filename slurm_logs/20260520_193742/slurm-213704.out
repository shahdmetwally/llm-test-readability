def test_validation_with_empty_sets_converts_to_either_and_maybe():
    """Test that a Validation built from empty sets can be converted to Either and Maybe types,
    and that calling to_maybe() on the resulting Maybe is a valid no-op chained call."""
    empty_set = set()

    # Create a Validation instance with no successes and no failures
    v = validation.Validation(empty_set, empty_set)

    # Convert to Either and Maybe representations
    either_result = v.to_either()
    maybe_result = v.to_maybe()

    # Verify that chaining to_maybe() on the Maybe result is also valid
    maybe_result.to_maybe()
```
