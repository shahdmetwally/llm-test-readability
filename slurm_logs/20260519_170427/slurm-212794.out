import pytest
import namedtupleutils as namedtuple_utils
import collections as collections_module

def test_to_namedtuple_with_negative_float():
    """Test that to_namedtuple raises an error or handles a negative float input appropriately."""
    # A negative float value to be passed to to_namedtuple
    negative_float = -476.66
    namedtuple_utils.to_namedtuple(negative_float)

def test_to_namedtuple_with_tuple_containing_set_and_negative_float():
    """Test to_namedtuple with a tuple containing a negative float and a set of floats."""
    value = -67.0
    set_of_floats = {value, value, value, value}
    input_tuple = (value, set_of_floats)
    result = namedtuple_utils.to_namedtuple(input_tuple)
    namedtuple_utils.to_namedtuple(set_of_floats)

def test_to_namedtuple_with_repeated_single_key_dict():
    """Test converting a dictionary with a single repeated key to a namedtuple,
    then converting the result back to a namedtuple again."""
    key = "author"
    # Create a dict with a single key (duplicate keys collapse to one)
    input_dict = {key: key, key: key, key: key}
    first_namedtuple = namedtuple_utils.to_namedtuple(input_dict)
    second_namedtuple = namedtuple_utils.to_namedtuple(first_namedtuple)

def test_to_namedtuple_rejects_bytes_input():
    """Verify that passing a bytes object to to_namedtuple raises an error."""
    bytes_input = b"xs&,\x9b\xc2\xf1\x80\xb3y"
    with pytest.raises(TypeError):
        namedtuple_utils.to_namedtuple(bytes_input)

def test_to_namedtuple_with_empty_tuple(self):
    """Test that to_namedtuple returns an empty namedtuple when given an empty tuple."""
    empty_tuple = ()
    result = namedtuple_utils.to_namedtuple(empty_tuple)

def test_to_namedtuple_with_ordered_dict_and_tuple():
    """Verify that to_namedtuple handles OrderedDict, its namedtuple conversion,
    and tuples containing namedtuples and bytes."""
    ordered_dict = collections_module.OrderedDict()
    namedtuple_from_dict = namedtuple_utils.to_namedtuple(ordered_dict)
    namedtuple_from_namedtuple = namedtuple_utils.to_namedtuple(namedtuple_from_dict)
