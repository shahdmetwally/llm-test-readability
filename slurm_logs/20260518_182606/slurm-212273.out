    # ARRANGE
    ordered_dict_keys = "wm=-g\ry#\x0b#:*"  # string contains escape sequences
    ordered_dict_values = ["wm=-g\ry#\x0b#:*", "wm=-g\ry#\x0b#:*"]  # list containing the 'ordered_dict_keys'
    ordered_dict = utils.OrderedDict(zip(ordered_dict_keys, ordered_dict_values))  # ordered dict created with zip

    # ACT
    named_tuple = utils.to_namedtuple(ordered_dict)  # named tuple is converted from ordered dict
    
    # ASSERT
    assert named_tuple is not None  # validate named tuple is not None
    assert named_tuple._fields == tuple(ordered_dict.keys())  # validate named tuple fields are same as ordered dict keys
    assert named_tuple._asdict() == ordered_dict  # validate named tuple dict representation is same as ordered dict

    # ACT
    ordered_dict_with_none_type = utils.OrderedDict([(None, None)])  # ordered dict created with NoneType values

    # ASSERT
    assert ordered_dict_with_none_type is not None  # validate ordered dict is not None
    assert ordered_dict_with_none_type.get(None) is None  # validate ordered dict with NoneType key is NoneType   


