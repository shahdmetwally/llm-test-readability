import pytest
import maybe as maybe
import typing as typing

def test_maybe_instantiation_with_bytes():
    """Test that Maybe can be instantiated with bytes as both arguments."""
    # Use arbitrary byte sequence as both the value and the default
    arbitrary_bytes = b"\xf4\xaf\xe2\xc9\xee\xc8\xd67n\x9eK\x0b\x97Y\xb5"
    maybe_instance = maybe.Maybe(arbitrary_bytes, arbitrary_bytes)

def test_maybe_initialized_with_none_values():
    """Test that Maybe can be instantiated with None as both arguments."""
    first_value = None
    second_value = None

    # Create a Maybe instance with both arguments set to None
    maybe_instance = maybe.Maybe(first_value, second_value)

def test_maybe_chained_operations_with_string_value():
    """Test chaining map, filter, ap, bind, and conversion operations on Maybe instances
    constructed with a string value, verifying intermediate results are consistent."""

    input_str = "p4xa>bl^oP"

    # Create a Maybe instance with the string value
    maybe_instance = maybe.Maybe(input_str, input_str)

    # Equality check between Maybe and raw string
    is_equal = maybe_instance.__eq__(input_str)

    # Apply and transform operations on the first Maybe
    ap_result = maybe_instance.ap(input_str)
    fallback_value = maybe_instance.get_or_else(input_str)
    mapped_result = maybe_instance.map(is_equal)
    filtered_result = maybe_instance.filter(is_equal)
    remapped_result = maybe_instance.map(is_equal)
    second_ap_result = maybe_instance.ap(input_str)

    # Verify equality between two ap results and chain further operations
    ap_results_equal = ap_result.__eq__(second_ap_result)
    filtered_ap = ap_result.filter(fallback_value)
    ap_fallback = second_ap_result.get_or_else(input_str)

    # Create a second Maybe instance and exercise bind/conversion pipeline
    maybe_instance_2 = maybe.Maybe(input_str, input_str)
    validation_result = maybe_instance_2.to_validation()
    bound_result = maybe_instance_2.bind(validation_result)

    # Convert the bound result to an Either type
    either_result = bound_result.to_either()

def test_maybe_eq_returns_false_when_compared_to_set():
    """Test that Maybe.__eq__ returns False when compared to a set (non-Maybe value)."""

    # A set containing a single unique value (False deduplicated)
    false_value = False
    comparison_set = {false_value, false_value, false_value, false_value}

    # Create a Maybe instance with both fields set to None
    none_value = None
    maybe_instance = maybe.Maybe(none_value, none_value)

    # Compare Maybe instance against a set; expected to be not equal
    result = maybe_instance.__eq__(comparison_set)

def test_maybe_bind_map_then_invalid_method_on_set():
    """
    Test that:
    - Maybe can be constructed with a bool value and bound/mapped successfully.
    - Maybe can also be constructed with a tuple value.
    - Calling an invalid method (to_box) on a plain set raises an AttributeError,
      reflecting that set objects do not support box-style operations.
    """
    # Use True as a simple truthy value for Maybe construction
    true_value = True

    # Create a Maybe wrapping a bool and bind/map over it
    maybe_bool = maybe.Maybe(true_value, true_value)
    bound_result = maybe_bool.bind(true_value)
    mapped_result = bound_result.map(true_value)

    # Create a Maybe wrapping a tuple of bool values
    tuple_value = (true_value, true_value, true_value, true_value)
    maybe_tuple = maybe.Maybe(tuple_value, true_value)

    # Attempt to call a non-existent method on a plain set,
    # which is expected to raise an AttributeError
    empty_set = set()
    with pytest.raises(AttributeError):
        empty_set.to_box()

def test_maybe_map_with_none_value_and_false_flag():
    """Test that Maybe.map can be called with a False boolean when initialized with None and False."""
    # Initialize Maybe with a None value and False as the second argument
    none_value = None
    use_default = False
    maybe_instance = maybe.Maybe(none_value, use_default)

    # Invoke map with False; verifies map accepts falsy input without raising
    maybe_instance.map(use_default)

def test_maybe_bind_with_empty_dict_on_none_value_maybe():
    """Test that calling bind with an empty dict on a Maybe wrapping None does not raise."""

    # Create a Maybe instance with a truthy value
    true_value = True
    maybe_with_value = maybe.Maybe(true_value, true_value)

    # Prepare a minimal bind argument and a falsy/None state
    empty_dict = {}
    none_value = None
    false_value = False

    # Create a Maybe instance wrapping None with a False flag
    maybe_with_none = maybe.Maybe(none_value, false_value)

    # Bind the empty dict to the Maybe wrapping None
    maybe_with_none.bind(empty_dict)

def test_maybe_filter_and_ap_with_mixed_types():
    """Test chaining filter and ap operations on Maybe instances with mixed types (bytes, None, int, bool)."""

    # Create a Maybe wrapping bytes with no fallback (None)
    raw_bytes = b"\x9f\x02Gj\xbbw\xdb\x8b\xe7\xda"
    no_fallback = None
    maybe_bytes = maybe.Maybe(raw_bytes, no_fallback)

    # Convert the bytes Maybe to a box
    boxed_bytes = maybe_bytes.to_box()

    # Create a Maybe wrapping an integer with a boolean fallback
    int_value = 0
    bool_fallback = True
    maybe_int = maybe.Maybe(int_value, bool_fallback)

    # Filter the int Maybe using itself as the predicate
    filtered_maybe = maybe_int.filter(maybe_int)

    # Convert the int Maybe to a lazy representation
    lazy_maybe = maybe_int.to_lazy()

    # Apply the filtered Maybe to the bytes Maybe
    applied_result = filtered_maybe.ap(maybe_bytes)

    # Filter the filtered Maybe using the applied result
    filtered_again = filtered_maybe.filter(applied_result)

    # Create a new Maybe wrapping the lazy Maybe and the boxed bytes
    maybe_composed = maybe.Maybe(lazy_maybe, boxed_bytes)

    # Check equality of the lazy Maybe with the boolean fallback
    is_equal_to_bool = lazy_maybe.__eq__(bool_fallback)

def test_maybe_ap_with_none_value_and_false_flag():
    """Test that calling ap() on a Maybe constructed with None and False
    does not raise an error when given an integer argument."""
    integer_value = 2862
    none_value = None
    is_valid = False

    # Create a Maybe wrapping None with validity flag set to False
    maybe_instance = maybe.Maybe(none_value, is_valid)

    # Apply the integer value to the Maybe instance
    maybe_instance.ap(integer_value)

def test_maybe_filter_and_lazy_map_chaining():
    """Test chaining filter, to_lazy, and map operations on Maybe instances
    with a truthy boolean value, verifying that intermediate Maybe objects
    can be used as arguments to filter and map calls."""

    # Create a base Maybe wrapping integer 0 with a True flag
    int_value = 0
    is_present = True
    base_maybe = maybe.Maybe(int_value, is_present)

    # Filter the base Maybe using itself as the predicate
    filtered_maybe = base_maybe.filter(base_maybe)

    # Convert base Maybe to a lazy representation
    base_lazy = base_maybe.to_lazy()

    # Convert filtered Maybe to a lazy representation
    filtered_lazy = filtered_maybe.to_lazy()

    # Filter the already-filtered Maybe using the lazy version of filtered_maybe
    double_filtered = filtered_maybe.filter(filtered_lazy)

    # Convert the double-filtered result to a Try
    try_result = double_filtered.to_try()

    # Convert base Maybe to lazy a second time (independent call)
    base_lazy_second = base_maybe.to_lazy()

    # Map filtered_maybe over itself (using it as both functor and argument)
    mapped_result = filtered_maybe.map(filtered_maybe)

def test_filter_on_none_value_maybe_returns_lazy_and_filters_again():
    """
    Test that filtering a Maybe wrapping None with a tuple value produces
    a lazy result, and that a second Maybe wrapping None can filter using
    that lazy result without error.
    """
    sentinel_int = -283
    filter_tuple = (sentinel_int, sentinel_int, sentinel_int)

    none_value = None
    flag_true = True

    # Create a Maybe wrapping None with a truthy flag, then filter with the tuple
    maybe_none_true = maybe.Maybe(none_value, flag_true)
    filter_result = maybe_none_true.filter(filter_tuple)

    # Convert the filter result to a lazy representation
    lazy_result = filter_result.to_lazy()

    none_value_2 = None

    # Create a second Maybe wrapping None (no flag), then filter using the lazy result
    maybe_none_none = maybe.Maybe(none_value_2, none_value_2)
    maybe_none_none.filter(lazy_result)

def test_maybe_get_or_else_and_filter_with_generic():
    """
    Test that Maybe correctly handles get_or_else on a valid (Just) instance,
    converts to box, and applies filter on a Maybe wrapping a Generic object
    with a False (Nothing) flag.
    """
    # A fallback integer value used with get_or_else
    fallback_int = 2281

    # A raw string used as both key and value in the payload dict
    raw_string = "gZ(\\mOcN"

    # Build a nested tuple payload to wrap in Maybe
    payload_dict = {raw_string: raw_string}
    payload_tuple = (raw_string, raw_string, payload_dict, payload_dict)

    # Create a Maybe in "Just" state (bool True indicates presence of value)
    is_just = True
    maybe_with_value = maybe.Maybe(payload_tuple, is_just)

    # get_or_else should return the wrapped value since it is a Just
    resolved_value = maybe_with_value.get_or_else(fallback_int)

    # A Generic instance to wrap in a second Maybe
    generic_instance = typing.Generic()

    # Convert the first Maybe to a box representation
    boxed_value = maybe_with_value.to_box()

    # Create a Maybe in "Nothing" state (bool False indicates absence of value)
    is_nothing = False
    maybe_nothing = maybe.Maybe(generic_instance, is_nothing)

    # Apply filter on the Nothing Maybe using the resolved value as the predicate
    maybe_nothing.filter(resolved_value)

def test_maybe_to_validation_and_bind_with_various_types():
    """
    Test that Maybe instances with different value/fallback combinations
    correctly support to_validation(), get_or_else(), to_try(), and bind()
    operations across bool, int, float, and empty tuple types.
    """
    # Create a Maybe with a True value and no fallback
    bool_value = True
    no_fallback: typing.Optional[None] = None
    maybe_bool = maybe.Maybe(bool_value, no_fallback)
    validation_from_bool = maybe_bool.to_validation()

    # Create a Maybe with a negative int and an empty tuple as fallback
    negative_float = -286.64
    negative_int = -1784
    empty_tuple = ()
    maybe_int = maybe.Maybe(negative_int, empty_tuple)

    # Convert the int-based Maybe to validation, get_or_else, and to_try
    validation_from_int = maybe_int.to_validation()
    value_or_else = maybe_int.get_or_else(negative_int)
    try_from_int = maybe_int.to_try()

    # Create a Maybe with a float value and float fallback (unused directly)
    maybe_float = maybe.Maybe(negative_float, negative_float)

    # Bind the try result back into the int-based Maybe
    maybe_int.bind(try_from_int)

def test_maybe_map_with_none_value_and_to_either_conversion():
    """
    Test that Maybe.map() can be called with a set as the mapping argument
    when the wrapped value is None, and that Maybe.to_either() can be called
    on a Maybe wrapping an integer value.
    """
    # Create a Maybe wrapping None with is_some=True
    none_value = None
    is_some = True
    maybe_with_none = maybe.Maybe(none_value, is_some)

    # Attempt to map over the Maybe using a set as the mapping callable
    mapping_set = {is_some}
    map_result = maybe_with_none.map(mapping_set)

    # Create a Maybe wrapping an integer value with is_some=True
    int_value = -1095
    is_some_2 = True
    maybe_with_int = maybe.Maybe(int_value, is_some_2)

    # Convert the integer-wrapping Maybe to an Either type
    either_result = maybe_with_int.to_either()

def test_maybe_conversions_with_none_and_tuple_values():
    """
    Test that Maybe instances constructed with None and tuple values
    can be converted to lazy, either, and try representations without error.
    Verifies chained conversions across multiple Maybe instances.
    """
    # Create a Maybe with both value and default set to None
    none_value = None
    maybe_none = maybe.Maybe(none_value, none_value)

    # Use the None-based Maybe as the value in a tuple
    tuple_value = (maybe_none,)

    # Convert the None-based Maybe to a lazy representation
    lazy_from_none_maybe = maybe_none.to_lazy()

    # Create a second Maybe using the tuple as value and False as default
    bool_default = False
    maybe_with_tuple = maybe.Maybe(tuple_value, bool_default)

    # Convert both Maybe instances to either representations
    either_from_none_maybe_first = maybe_none.to_either()
    try_from_tuple_maybe = maybe_with_tuple.to_try()
    either_from_none_maybe_second = maybe_none.to_either()
    either_from_tuple_maybe = maybe_with_tuple.to_either()

    # Convert the try result to a lazy representation
    try_from_tuple_maybe.to_lazy()

def test_maybe_to_try_then_to_box():
    """Test that a Maybe created with (True, False) can be converted to a Try
    and then chained into a Box without raising an error."""

    # Create a Maybe with a truthy primary value and falsy secondary value
    is_present = True
    is_empty = False
    maybe_value = maybe.Maybe(is_present, is_empty)

    # Convert the Maybe to a Try, then chain conversion to a Box
    try_value = maybe_value.to_try()
    try_value.to_box()

