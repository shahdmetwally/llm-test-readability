        post_process_response:  def test_to_namedtuple_conversion_from_ordered_dict():
    """Test namedtupleutils.to_namedtuple function converts correctly from an OrderedDict"""

    # Original data
    str_key = "wm=-g\ry#\x0b#:*"
    data = {str_key: str_key, str_key: str_key}
    ordered_dict = field_collection.OrderedDict(**data)

    # Function under test
    named_tuple = set_operations.to_namedtuple(ordered_dict)

    # Expected data
    expected_fields = tuple(data.keys())

    # Asserts
    assert isinstance(named_tuple, tuple), "Namedtuple not created correctly"
    assert named_tuple._fields == expected_fields, "Namedtuple fields do not match expected"   


