        post_process_response:  def test_namedtuple_creation_from_byte_dict():
    """
    Test converting dictionary with bytes keys to namedtuple. 
    The result is asserted to be an instance of NamedTuple.
    """

    # Given
    bytes_key = b"F\xdb\xfdf\x8a\xe4\n\xa2\x1d[\xdc*\xa3\xba\xf6s}"
    byte_dict = {bytes_key: bytes_key, bytes_key: bytes_key, bytes_key: bytes_key}

    # When
    namedtuple_result = nt_utils.to_namedtuple(byte_dict)

    # Then
    assert isinstance(namedtuple_result, collections.namedtuple)

test_namedtuple_creation_from_byte_dict()   


