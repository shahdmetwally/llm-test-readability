    def test_validation_chained_operations_with_mixed_types():
        """
        Test that Validation objects can be constructed with mixed types (None, bytes, bool)
        and that chained operations (eq, to_box, to_either, to_try, to_lazy, is_fail, map)
        execute without error, covering interplay between multiple Validation instances.
        """
        # Arbitrary bytes value used as a payload/key in Validation construction
        raw_bytes = b"\xcc\xf7\x0e\x04\xc8Y\xc1 N\xbb\xa6\x85\x97\x90\x9e"
        none_value = None
    
        # A dict with mixed-type keys to serve as the 'value' argument
        mixed_dict = {none_value: raw_bytes, raw_bytes: raw_bytes}
    
        # Validation with None as the 'is_success' indicator and a mixed dict as value
        validation_none_key = validation.Validation(none_value, mixed_dict)
    
        # Test equality of a Validation instance with itself
        eq_result = validation_none_key.__eq__(validation_none_key)
    
        # Convert to Box; will be reused for further chained conversions
