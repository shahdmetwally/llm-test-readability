    """Test Maybe's map function on identity function"""

    # Boolean values for test case
    is_truthy = True
    is_falsy = False

    # Create a new Maybe instance with truthy and falsy values
    maybe = module_0_maybe_alias.Maybe(is_truthy, is_falsy)

    # Bind the value of the Maybe instance to a variable
    # This is essentially checking if the value is not None
    bound_result = maybe.bind(is_truthy)

    # Map the bound result to another variable, this is essentially applying a function to the Maybe
    # Since we're applying the identity function which does nothing but return its argument, the result should be the same as the bound result
    mapped_result = bound_result.map(lambda x: x)

    # Create a new tuple and Maybe instance
