```python
def test_maybe_monad_chained_operations_with_none_and_bytes():
    """Test that Maybe monad chained operations (ap, bind, to_validation, to_either, to_try,
    get_or_else) execute correctly when constructed with None and bytes values."""

    # --- Setup: define primitive inputs ---
    bytes_value = b"\xdbC\xcf\xe7/"
    none_value = None
    initial_bool = True
    negative_int = -3289

    # --- Construct Maybe(None, True) and exercise ap chain ---
    maybe_none_true = module_0.Maybe(none_value, initial_bool)
    ap_none_result = maybe_none_true.ap(none_value)
    ap_bytes_result = ap_none_result.ap(bytes_value)
    validation_from_ap_chain = ap_bytes_result.to_validation()  # convert chained ap result to Validation

    # --- Construct Maybe(None, bytes) and exercise core operations ---
