def test_timer_equality_and_initial_text_with_invalid_args():
    """Test that a Timer can be created with an initial_text value
    that is a Timer instance, and that equality comparison and
    context manager entry/exit work correctly.

    This test exercises edge cases where:
    - initial_text is set to a Timer object
    - logger is set to the result of an equality check
    - A Timer is created with positional timer argument and
      initial_text set to another Timer instance
    """
    timer = timer.Timer()

    # Enter the context manager (sets up timers internally)
    entered_timer = timer.__enter__()

    # Equality comparison between timer and itself
    equality_result = timer.__eq__(timer)

    # Exit the context manager (cleans up any internal state)
    timer.__exit__()

    # Create a Timer with initial_text set to the Timer that was
    # returned from __enter__, and logger set to the equality result
    timer_with_initial_text = timer.Timer(initial_text=entered_timer, logger=equality_result)

    # Create another Timer with a positional initial_text arg,
    # initial_text set to the first timer_with_initial_text,
    # and logger set to the equality result
    nested_timer = timer.Timer(entered_timer, initial_text=timer_with_initial_text, logger=equality_result)

    # Start the nested timer
    nested_timer.start()

def test_timer_start_stop_and_context_manager_flow_with_initial_text_true() -> None:
    """Test that starting, stopping, and entering a Timer with initial_text=True works correctly."""
    # Initialize timer with "Timer started" as initial text
    initial_text = "Timer started"
    timer = timer.Timer(initial_text)
    
    # Start the timer
    none_return = timer.start()
    
    # Stop the timer
    elapsed_time = timer.stop()
    
    # Enter the timer as a context manager (second start)
    context_manager_timer = timer.__enter__()
    
    # Attempt to copy the timer
    timer.copy()
