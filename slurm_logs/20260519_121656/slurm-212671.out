    """Test the to_namedtuple utility function with a duplicate key case."""

    string_data = "wm=-g\ry#\x0b#:*"
    data_dict = {string_data: string_data, string_data: string_data}
    ordered_dict = module_1.OrderedDict(**data_dict)
    result_namedtuple = nt_utils.to_namedtuple(ordered_dict)

    assert result_namedtuple._fields == tuple(data_dict.keys())  # check correct fields were created.
    
    none_obj = None
    list_data = [none_obj]
    module_1.OrderedDict(*list_data)  # test module functionality works as expected.
    
