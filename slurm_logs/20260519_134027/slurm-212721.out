        post_process_response:  def test_create_namedtuple_from_large_dictionary():
    # Prepare input data
    key = "wm=-g\ry#\x0b#:*"
    dict_data = {key: key, key: key}
    ordered_dict = py_collections.OrderedDict(**dict_data)

    # Create namedtuple
    name = 'Test'
    namedtuple = namedtuple_utils.to_namedtuple(namedtuple_name=name, ordered_dict=ordered_dict)

    # Assert that namedtuple has expected data
    assert namedtuple._asdict() == dict_data

    # Create an ordered dict with no data 
    empty_list = [None]
    empty_dict = py_collections.OrderedDict(*empty_list)

    # Create namedtuple
    another_name = "AnotherTest"
    empty_namedtuple = namedtuple_utils.to_namedtuple(namedtuple_name=another_name, ordered_dict=empty_dict)

    # Assert that namedtuple is empty
    assert len(empty_namedtuple._asdict()) == 0   


