def test_to_namedtuple_with_tuple_containing_set():
    """Test converting a tuple containing a float and a set to a named tuple.

    The set contains duplicate float values, which are collapsed into a set
    of unique values. The tuple and set are both converted to named tuples.
    """
    float_value = -67.0
    unique_set = {float_value, float_value, float_value, float_value}
    input_tuple = (float_value, unique_set)
    named_tuple_result = namedtuple_utils.to_namedtuple(input_tuple)
    namedtuple_utils.to_namedtuple(unique_set)
