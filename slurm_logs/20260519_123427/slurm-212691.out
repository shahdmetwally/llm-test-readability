    """
    Test that bytes values are correctly stored and retrieved from a dictionary.
    """
    import collections as collections_module
    bytes_collection = b"F\xdb\xfdf\x8a\xe4\n\xa2\x1d[\xdc*\xa3\xba\xf6s}"
