        post_process_response:  def test_timer_start_and_stop_functionality():
    time_waste_instance = Timer(text=TIME_MESSAGE)
    Capsys = Capturing()
    result_0 = time_waste_instance.start()
    expected_time_waste_execution_result = None
    expected_time_message = TIME_MESSAGE
    time_waste_time_message = time_waste_instance.text
    unittest_stderr = Capsys.write(time_waste_time_message)

    assert result_0 == expected_time_waste_execution_result
    assert RE_TIME_MESSAGE.match(time_waste_time_message) # Check for time format
    assert RE_TIME_MESSAGE.match(unittest_stderr) # Check if stderr has been printed or ignored
    time.sleep(0.1)
    result_1 = time_waste_instance.stop()
    Capsys.__init__()
    assert isinstance(result_1, float) # Check for return type
    assert time_waste_instance.text == TIME_MESSAGE # Check if timer is in initial state after stop   


