import pytest
import maybe as maybe
import typing as typing

def test_maybe_constructed_with_bytes_arguments():
    """Test that Maybe can be instantiated with two identical bytes objects as arguments."""
    raw_bytes = b"\xf4\xaf\xe2\xc9\xee\xc8\xd67n\x9eK\x0b\x97Y\xb5"

    # Construct a Maybe instance using the same bytes value for both arguments
    result = maybe.Maybe(raw_bytes, raw_bytes)

def test_maybe_initializes_with_two_none_values():
    """Test that Maybe can be instantiated with two None arguments."""
    first_value = None
    second_value = None

    # Construct a Maybe instance with both arguments set to None
    maybe_0 = maybe.Maybe(first_value, second_value)

def test_maybe_chained_operations_with_string_value():
    """Test chaining map, filter, ap, bind, and conversion operations on Maybe instances with a string value."""

    # Create a Maybe instance wrapping a string value
    test_value = "p4xa>bl^oP"
    maybe_instance = maybe.Maybe(test_value, test_value)

    # Check equality of Maybe with the raw string value
    is_equal = maybe_instance.__eq__(test_value)

    # Apply ap, get_or_else, map, and filter on the initial Maybe
    ap_result = maybe_instance.ap(test_value)
    unwrapped_value = maybe_instance.get_or_else(test_value)
    mapped_result = maybe_instance.map(is_equal)
    filtered_result = maybe_instance.filter(is_equal)

    # Repeat map and ap to verify consistent behaviour across repeated calls
    mapped_result_again = maybe_instance.map(is_equal)
    ap_result_again = maybe_instance.ap(test_value)

    # Compare two ap results for equality
    ap_results_equal = ap_result.__eq__(ap_result_again)

    # Chain filter and get_or_else on the ap results
    filtered_from_ap = ap_result.filter(unwrapped_value)
    unwrapped_from_ap_again = ap_result_again.get_or_else(test_value)

    # Create a second Maybe instance and exercise bind and conversion methods
    maybe_instance_2 = maybe.Maybe(test_value, test_value)
    validation_result = maybe_instance_2.to_validation()
    bound_result = maybe_instance_2.bind(validation_result)

    # Convert the bound result to an Either
    either_result = bound_result.to_either()

def test_maybe_eq_returns_false_when_comparing_with_set():
    """Test that Maybe.__eq__ returns False when compared against a set (non-Maybe value)."""
    # A set containing a single unique value (False deduplicated)
    false_value = False
    comparison_set = {false_value, false_value, false_value, false_value}

    # Create a Maybe instance wrapping None for both value and fallback
    none_value = None
    maybe_instance = maybe.Maybe(none_value, none_value)

    # Compare Maybe instance against a set; expected to be unequal (not a Maybe)
    result = maybe_instance.__eq__(comparison_set)

def test_maybe_bind_map_then_invalid_method_on_set():
    """
    Test that Maybe can be constructed with a bool value, supports bind and map chaining,
    and that calling a non-existent method (to_box) on a plain set raises AttributeError.
    """
    # Use True as a simple truthy value for Maybe construction
    is_present = True

    # Create a Maybe wrapping a bool value with a truthy condition
    maybe_value = maybe.Maybe(is_present, is_present)

    # Bind the maybe with a bool (exercises the bind pathway)
    bound_value = maybe_value.bind(is_present)

    # Map over the bound result using the same bool
    mapped_value = bound_value.map(is_present)

    # Construct a tuple of bool values to use as the next Maybe's wrapped value
    bool_tuple = (is_present, is_present, is_present, is_present)

    # Create another Maybe wrapping the tuple with a truthy condition
    maybe_tuple = maybe.Maybe(bool_tuple, is_present)

    # Create an empty set and attempt to call a non-existent method,
    # which should raise AttributeError (set has no to_box method)
    empty_set = set()
    with pytest.raises(AttributeError):
        empty_set.to_box()

def test_maybe_map_with_none_value_and_false_flag():
    """Test that Maybe.map can be called with False when initialized with None and False."""
    # Initialize Maybe with a None value and False to indicate no value is present
    none_value = None
    has_value = False
    maybe_instance = maybe.Maybe(none_value, has_value)

    # Attempt to map over the Maybe instance using False as the mapping function
    maybe_instance.map(has_value)

def test_maybe_bind_with_empty_dict_on_none_value_maybe():
    """Test that calling bind() with an empty dict on a Maybe wrapping None does not raise errors."""

    # Create a Maybe with a truthy value (both just and default are True)
    true_value = True
    maybe_with_true = maybe.Maybe(true_value, true_value)

    # Prepare an empty dict to use as the bind argument
    empty_dict = {}

    # Create a Maybe wrapping None with a False default
    none_value = None
    false_default = False
    maybe_with_none = maybe.Maybe(none_value, false_default)

    # Bind the empty dict to the Maybe that wraps None
    maybe_with_none.bind(empty_dict)

def test_maybe_filter_and_ap_with_mixed_types():
    """
    Test that Maybe correctly handles filter and ap operations
    when constructed with mixed types (bytes/None and int/bool),
    including chaining ap on a filtered Maybe and converting to lazy/box forms.
    """
    # Create a Maybe wrapping bytes with no fallback (None)
    raw_bytes = b"\x9f\x02Gj\xbbw\xdb\x8b\xe7\xda"
    no_fallback = None
    maybe_bytes = maybe.Maybe(raw_bytes, no_fallback)
    boxed_bytes = maybe_bytes.to_box()

    # Create a Maybe wrapping an integer with a bool fallback
    int_value = 0
    bool_fallback = True
    maybe_int = maybe.Maybe(int_value, bool_fallback)

    # Filter the int Maybe using itself as the predicate
    filtered_int = maybe_int.filter(maybe_int)

    # Convert the int Maybe to a lazy representation
    lazy_int = maybe_int.to_lazy()

    # Apply the filtered Maybe to the bytes Maybe
    applied_result = filtered_int.ap(maybe_bytes)

    # Filter the filtered Maybe using the applied result as predicate
    double_filtered = filtered_int.filter(applied_result)

    # Wrap the lazy int and boxed bytes together in a new Maybe
    maybe_combined = maybe.Maybe(lazy_int, boxed_bytes)

    # Check equality of the lazy int with the bool fallback
    is_equal_to_bool = lazy_int.__eq__(bool_fallback)

def test_maybe_ap_with_none_value_and_false_flag():
    """Test that calling `ap` on a Maybe wrapping None (with False flag) with an integer does not raise unexpectedly."""
    int_value = 2862
    none_value = None
    is_valid = False

    # Construct a Maybe instance wrapping None with the False flag
    maybe_instance = maybe.Maybe(none_value, is_valid)

    # Apply the integer value via `ap` on the Nothing-like Maybe
    maybe_instance.ap(int_value)

def test_maybe_filter_and_lazy_map_chaining():
    """Test chaining filter, to_lazy, and map operations on Maybe instances
    created with a falsy integer value and a True flag."""

    # Create a base Maybe wrapping 0 with a True flag
    int_value = 0
    flag = True
    maybe_instance = maybe.Maybe(int_value, flag)

    # Apply filter using the Maybe instance itself as the predicate
    filtered_maybe = maybe_instance.filter(maybe_instance)

    # Convert the original Maybe to a lazy representation
    lazy_from_original = maybe_instance.to_lazy()

    # Convert the filtered Maybe to a lazy representation
    lazy_from_filtered = filtered_maybe.to_lazy()

    # Apply filter on the filtered Maybe using the lazy version as predicate
    double_filtered = filtered_maybe.filter(lazy_from_filtered)

    # Convert the double-filtered result to a Try
    try_result = double_filtered.to_try()

    # Convert the original Maybe to lazy again (independent of prior lazy)
    lazy_from_original_again = maybe_instance.to_lazy()

    # Map the filtered Maybe over itself
    mapped_result = filtered_maybe.map(filtered_maybe)

def test_filter_on_maybe_with_none_value_returns_lazy():
    """Test that filtering a Maybe wrapping None with a tuple value yields a lazy Maybe,
    and that filtering a second Maybe(None, None) with that lazy result completes without error."""

    # Set up a tuple to use as the filter argument
    sentinel_int = -283
    filter_arg = (sentinel_int, sentinel_int, sentinel_int)

    # Create a Maybe with a None value and True as the second argument
    maybe_with_none = maybe.Maybe(None, True)

    # Filter the Maybe using the tuple; result is still a Maybe-like object
    filtered_result = maybe_with_none.filter(filter_arg)

    # Convert the filtered result to a lazy representation
    lazy_result = filtered_result.to_lazy()

    # Create a second Maybe with both arguments as None
    maybe_both_none = maybe.Maybe(None, None)

    # Filter the second Maybe using the lazy result; exercises the lazy filter path
    maybe_both_none.filter(lazy_result)

def test_maybe_get_or_else_and_filter_with_generic():
    """
    Test that Maybe.get_or_else returns a value from a present Maybe,
    and that Maybe.filter can be applied to an absent Maybe wrapping a Generic object.
    """
    # A fallback integer used with get_or_else
    fallback_int = 2281

    # A string used as both key and value in a dict payload
    payload_str = "gZ(\\mOcN"
    payload_dict = {payload_str: payload_str}

    # Construct a tuple payload for a present Maybe (bool True = value is present)
    present_payload = (payload_str, payload_str, payload_dict, payload_dict)
    is_present = True
    present_maybe = maybe.Maybe(present_payload, is_present)

    # get_or_else should return the wrapped value since Maybe is present
    resolved_value = present_maybe.get_or_else(fallback_int)

    # Create a Generic instance to use as the payload for an absent Maybe
    generic_instance = typing.Generic()

    # Convert the present Maybe to a box representation
    is_absent = False
    boxed_value = present_maybe.to_box()

    # Construct an absent Maybe wrapping the Generic instance
    absent_maybe = maybe.Maybe(generic_instance, is_absent)

    # Apply filter using the resolved value from the present Maybe
    absent_maybe.filter(resolved_value)

def test_maybe_to_validation_and_chained_operations():
    """
    Test that Maybe instances correctly support to_validation(), get_or_else(),
    to_try(), and bind() across multiple configurations, including a truthy value
    with no fallback, a negative int with an empty tuple fallback, and a float
    with a float fallback.
    """
    # Create a Maybe with a truthy value and no fallback (None)
    is_valid = True
    no_fallback = None
    maybe_truthy = maybe.Maybe(is_valid, no_fallback)
    validation_from_truthy = maybe_truthy.to_validation()

    # Create a Maybe with a negative int value and an empty tuple as fallback
    negative_int = -1784
    empty_tuple = ()
    maybe_int = maybe.Maybe(negative_int, empty_tuple)

    # Convert to validation, retrieve with fallback, and convert to try
    validation_from_int = maybe_int.to_validation()
    value_or_else = maybe_int.get_or_else(negative_int)
    try_result = maybe_int.to_try()

    # Create a Maybe with float value and float fallback (unused directly)
    float_val = -286.64
    maybe_float = maybe.Maybe(float_val, float_val)

    # Bind the try result onto the int-based Maybe
    maybe_int.bind(try_result)

def test_maybe_map_with_set_and_to_either_conversion():
    """Test that Maybe.map with a set argument and Maybe.to_either() can be
    called without raising errors, covering both a None-valued and an
    int-valued Maybe instance."""

    # Create a Maybe wrapping None with has_value=True, then map over it with a set
    none_value = None
    has_value_true = True
    maybe_none = maybe.Maybe(none_value, has_value_true)
    set_arg = {has_value_true}
    map_result = maybe_none.map(set_arg)

    # Create a Maybe wrapping a negative int, then convert it to an Either
    int_value = -1095
    has_value_true_2 = True
    maybe_int = maybe.Maybe(int_value, has_value_true_2)
    either_result = maybe_int.to_either()

def test_maybe_conversions_with_none_and_composite_values():
    """
    Test that Maybe instances constructed with None and composite values
    can be converted to lazy, either, and try representations without error.
    Verifies chaining of to_lazy(), to_either(), and to_try() across
    multiple Maybe instances, including converting a Try result to lazy.
    """
    # Create a Maybe wrapping two None values
    none_value = None
    maybe_with_none = maybe.Maybe(none_value, none_value)

    # Use the None-based Maybe as a tuple element for a composite Maybe
    tuple_of_maybe = (maybe_with_none,)
    bool_false = False
    maybe_with_tuple = maybe.Maybe(tuple_of_maybe, bool_false)

    # Convert the None-based Maybe to lazy form
    lazy_from_none_maybe = maybe_with_none.to_lazy()

    # Convert both Maybe instances to Either representations
    either_from_none_maybe_first = maybe_with_none.to_either()
    either_from_none_maybe_second = maybe_with_none.to_either()
    either_from_tuple_maybe = maybe_with_tuple.to_either()

    # Convert the composite Maybe to a Try representation
    try_from_tuple_maybe = maybe_with
