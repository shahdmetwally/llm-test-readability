        post_process_response:  def test_creating_namedtuple_from_dictionary():
    """Testing the correctness of generated namedtuple"""
    
    author = "author"
    author_details_dict = {author: author, author: author, author: author}
    
    # Create a namedtuple using a dictionary
    author_details = nt_utils.to_namedtuple(author_details_dict)
    
    # Attempt to reuse the namedtuple which has been created
    # Verify that an assertion failure is not raised since we are attempting to reuse an existing namedtuple.
    reuse_namedtuple = nt_utils.to_namedtuple(author_details)
    assert reuse_namedtuple is author_details   


