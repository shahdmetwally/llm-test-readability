import pytest
import maybe as maybe
import typing as typing

def test_maybe_construction_with_bytes_value():
    """Test that Maybe can be constructed with identical bytes values for both arguments."""
    raw_bytes = b"\xf4\xaf\xe2\xc9\xee\xc8\xd67n\x9eK\x0b\x97Y\xb5"

    # Construct a Maybe instance using the same bytes object for both arguments
    result = maybe.Maybe(raw_bytes, raw_bytes)

def test_maybe_initialized_with_none_values():
    """Test that Maybe can be instantiated with None as both arguments."""
    # Both value and fallback are None — verifies Maybe accepts null inputs
    value = None
    fallback = None
    maybe_instance = maybe.Maybe(value, fallback)

def test_maybe_chained_operations_with_string_value():
    """Test chaining map, filter, ap, bind, and conversion operations on Maybe instances
    constructed with a string value, verifying equality and transformation behaviour."""

    seed_value = "p4xa>bl^oP"

    # Create a Maybe instance from the seed string value
    maybe_instance = maybe.Maybe(seed_value, seed_value)

    # Check equality of the Maybe instance against the raw string
    is_equal = maybe_instance.__eq__(seed_value)

    # Apply ap, get_or_else, map, and filter operations on the primary Maybe
    ap_result = maybe_instance.ap(seed_value)
    unwrapped_value = maybe_instance.get_or_else(seed_value)
    mapped_result = maybe_instance.map(ap_result)
    filtered_result = maybe_instance.filter(ap_result)

    # Further map and ap calls to exercise repeated chaining
    remapped_result = maybe_instance.map(ap_result)
    reap_result = maybe_instance.ap(seed_value)

    # Verify equality between two ap results derived from the same inputs
    ap_results_equal = ap_result.__eq__(reap_result)

    # Chain filter and get_or_else on the ap results
    filtered_ap = ap_result.filter(unwrapped_value)
    fallback_value = reap_result.get_or_else(seed_value)

    # Create a second independent Maybe instance from the same seed value
    maybe_instance_2 = maybe.Maybe(seed_value, seed_value)

    # Convert to validation and bind the result
    validation_result = maybe_instance_2.to_validation()
    bound_result = maybe_instance_2.bind(validation_result)

    # Convert the bound result to an Either
    either_result = bound_result.to_either()

def test_maybe_eq_returns_false_when_compared_to_set():
    """Test that Maybe.__eq__ returns False when compared to a set (non-Maybe value)."""

    # A set containing a single unique value (False deduplicated)
    false_value = False
    comparison_set = {false_value, false_value, false_value, false_value}

    # Create a Maybe instance with both value and default set to None
    none_value = None
    maybe_instance = maybe.Maybe(none_value, none_value)

    # Compare the Maybe instance against a set; expected to be unequal
    result = maybe_instance.__eq__(comparison_set)

def test_maybe_bind_map_then_invalid_method_on_set():
    """
    Test that chaining Maybe.bind and Maybe.map works on a truthy value,
    and that calling a non-existent method (to_box) on a plain set raises
    an AttributeError, reflecting Maybe's interface is not available on
    built-in types.
    """
    truthy_value = True

    # Create a Maybe wrapping a truthy value and bind it with another truthy value
    maybe_instance = maybe.Maybe(truthy_value, truthy_value)
    bound_result = maybe_instance.bind(truthy_value)

    # Map over the bound result
    mapped_result = bound_result.map(truthy_value)

    # Create a second Maybe using a tuple of truthy values
    truthy_tuple = (truthy_value, truthy_value, truthy_value, truthy_value)
    maybe_with_tuple = maybe.Maybe(truthy_tuple, truthy_value)

    # Attempt to call a non-existent method on a plain set,
    # which should raise AttributeError (set has no to_box method)
    empty_set = set()
    with pytest.raises(AttributeError):
        empty_set.to_box()

def test_maybe_map_with_none_value_and_false_flag():
    """Test that Maybe.map can be called with a False boolean when initialized with None and False."""
    # Create a Maybe instance with no value (None) and disabled flag (False)
    none_value = None
    enabled = False
    maybe_instance = maybe.Maybe(none_value, enabled)

    # Apply map with False; verifies map is callable in this state without error
    maybe_instance.map(enabled)

def test_maybe_bind_with_empty_dict_on_none_value_maybe():
    """Test that calling bind with an empty dict on a Maybe wrapping None does not raise."""

    # Create a Maybe with a truthy value (acts as a valid/present value)
    present_value = True
    maybe_with_value = maybe.Maybe(present_value, present_value)

    # Prepare an empty dict to use as the bind argument
    empty_dict = {}
    none_value = None
    absent_flag = False

    # Create a Maybe wrapping None (absent/empty value)
    maybe_with_none = maybe.Maybe(none_value, absent_flag)

    # Bind the empty dict to the Maybe wrapping None
    maybe_with_none.bind(empty_dict)

def test_maybe_filter_and_ap_with_mixed_types():
    """
    Test chaining of Maybe operations (filter, ap, to_box, to_lazy) with
    mixed value types (bytes, None, int, bool) to verify correct behaviour
    across multiple Maybe instances.
    """
    # Create a Maybe wrapping bytes with no fallback (None)
    bytes_value = b"\x9f\x02Gj\xbbw\xdb\x8b\xe7\xda"
    none_value = None
    maybe_bytes = maybe.Maybe(bytes_value, none_value)

    # Box the bytes Maybe for later use
    boxed_bytes = maybe_bytes.to_box()

    # Create a Maybe wrapping an int with a bool fallback
    int_value = 0
    bool_value = True
    maybe_int = maybe.Maybe(int_value, bool_value)

    # Filter the int Maybe using itself as the predicate
    filtered_maybe = maybe_int.filter(maybe_int)

    # Lift the int Maybe into a lazy representation
    lazy_maybe = maybe_int.to_lazy()

    # Apply the filtered Maybe to the bytes Maybe
    applied_result = filtered_maybe.ap(maybe_bytes)

    # Filter the already-filtered Maybe using the applied result
    double_filtered = filtered_maybe.filter(applied_result)

    # Construct a new Maybe combining the lazy value and the boxed bytes
    maybe_combined = maybe.Maybe(lazy_maybe, boxed_bytes)

    # Check equality of the lazy Maybe against the bool fallback value
    eq_result = lazy_maybe.__eq__(bool_value)

def test_maybe_ap_with_none_value_and_false_flag():
    """Test that calling ap() on a Maybe wrapping None (with strict=False) does not raise an error."""
    arbitrary_int = 2862
    no_value = None
    is_strict = False

    # Create a Maybe instance wrapping None, with strict mode disabled
    maybe_instance = maybe.Maybe(no_value, is_strict)

    # Apply ap() with an integer argument; behaviour under test is ap on a Nothing-like Maybe
    maybe_instance.ap(arbitrary_int)

def test_maybe_filter_and_lazy_map_chaining():
    """Test chaining filter, to_lazy, and map operations on Maybe instances."""
    # Create a Maybe wrapping integer 0 with a truthy flag
    int_value = 0
    is_present = True
    maybe_instance = maybe.Maybe(int_value, is_present)

    # Filter the Maybe using itself as the predicate
    filtered_maybe = maybe_instance.filter(maybe_instance)

    # Convert the original Maybe to a lazy representation
    lazy_from_original = maybe_instance.to_lazy()

    # Convert the filtered Maybe to a lazy representation
    lazy_from_filtered = filtered_maybe.to_lazy()

    # Filter the filtered Maybe using the lazy version as predicate
    double_filtered = filtered_maybe.filter(lazy_from_filtered)

    # Convert the double-filtered result to a Try
    try_result = double_filtered.to_try()

    # Convert the original Maybe to lazy again (independent operation)
    lazy_from_original_again = maybe_instance.to_lazy()

    # Map the filtered Maybe over itself
    mapped_result = filtered_maybe.map(filtered_maybe)

def test_filter_on_none_value_maybe_returns_lazy_and_filters_again():
    """
    Test that filtering a Maybe wrapping None with a tuple value produces a
    lazy representation, and that filtering another None-valued Maybe with
    that lazy result does not raise an error.
    """
    sentinel_int = -283
    filter_tuple = (sentinel_int, sentinel_int, sentinel_int)

    # Create a Maybe with a None value but truthy flag, then filter with the tuple
    maybe_none_true = maybe.Maybe(None, True)
    filtered_result = maybe_none_true.filter(filter_tuple)

    # Convert the filtered result to a lazy representation
    lazy_result = filtered_result.to_lazy()

    # Create a second Maybe with both value and flag as None, then filter with the lazy result
    maybe_none_none = maybe.Maybe(None, None)
    maybe_none_none.filter(lazy_result)

def test_maybe_get_or_else_and_filter_with_generic():
    """
    Test that Maybe wrapping a tuple value returns the correct get_or_else result,
    and that a second Maybe wrapping a Generic object can be filtered using that result.
    """
    # A fallback integer used when the Maybe has no value to provide
    fallback_int = 2281

    # A string used as both key and value in the nested dict and tuple
    raw_str = "gZ(\\mOcN"
    nested_dict = {raw_str: raw_str}

    # A tuple containing the string and dict entries, used as the Maybe's value
    maybe_value_tuple = (raw_str, raw_str, nested_dict, nested_dict)

    # Create a Maybe with a valid (truthy) presence flag
    is_present = True
    maybe_tuple = maybe.Maybe(maybe_value_tuple, is_present)

    # Retrieve the value from the Maybe, falling back to fallback_int if absent
    resolved_value = maybe_tuple.get_or_else(fallback_int)

    # A generic object to be wrapped in a second Maybe
    generic_obj = typing.Generic()

    # Create a second Maybe wrapping the Generic object, marked as absent
    is_absent = False
    maybe_box = maybe_tuple.to_box()
    maybe_generic = maybe.Maybe(generic_obj, is_absent)

    # Filter the absent Maybe using the resolved value from the first Maybe
    maybe_generic.filter(resolved_value)

def test_maybe_to_validation_and_bind_with_various_types():
    """
    Tests Maybe construction and chaining of to_validation, get_or_else,
    to_try, and bind across instances holding different value types
    (bool/None, int/empty tuple, float/float).
    """
    # Create a Maybe with a truthy value and no fallback
    bool_value = True
    no_fallback = None
    maybe_bool = maybe.Maybe(bool_value, no_fallback)
    validation_from_bool = maybe_bool.to_validation()

    # Create a Maybe with a negative int and an empty tuple as the second arg
    float_value = -286.64
    int_value = -1784
    empty_tuple = ()
    maybe_int = maybe.Maybe(int_value, empty_tuple)

    # Convert to validation, retrieve value with fallback, and convert to Try
    validation_from_int = maybe_int.to_validation()
    value_or_else = maybe_int.get_or_else(int_value)
    try_from_int = maybe_int.to_try()

    # Create a Maybe with float values, then bind the Try result onto maybe_int
    maybe_float = maybe.Maybe(float_value, float_value)
    maybe_int.bind(try_from_int)

def test_maybe_map_with_none_value_and_to_either_with_int_value():
    """
    Test that Maybe.map() can be called with a set as the mapping argument
    when the wrapped value is None, and that Maybe.to_either() works correctly
    when the wrapped value is a negative integer.
    """
    # Create a Maybe wrapping None with has_value=True
    none_value = None
    has_value_true = True
    maybe_with_none = maybe.Maybe(none_value, has_value_true)

    # Attempt to map over the Maybe using a set as the mapping function
    mapping_set = {has_value_true}
    map_result = maybe_with_none.map(mapping_set)

    # Create a Maybe wrapping a negative integer with has_value=True
    negative_int = -1095
    has_value_true_1 = True
    maybe_with_int = maybe.Maybe(negative_int, has_value_true_1)

    # Convert the Maybe wrapping a negative integer to an Either
    either_result = maybe_with_int.to_either()

def test_maybe_chained_conversions_with_none_and_false():
    """
    Test chained conversions (to_lazy, to_either, to_try) on Maybe instances
    constructed with None values and a False flag, verifying that conversion
    methods can be called in sequence without errors.
    """
    # Create a Maybe wrapping None for both value and context
    none_value = None
    maybe_none = maybe.Maybe(none_value, none_value)

    # Wrap the first Maybe instance in a tuple to use as a value
    tuple_containing_maybe = (maybe_none,)

    # Convert the None-based Maybe to a lazy representation
    lazy_from_none_maybe = maybe_none.to_lazy()

    # Create a second Maybe with the tuple as value and False as the flag
    bool_false = False
    maybe_with_tuple = maybe.Maybe(tuple_containing_maybe, bool_false)

    # Convert the None-based Maybe to an Either type
    either_from_none_maybe = maybe_none.to_either()

    # Convert the tuple-based Maybe to a Try type
    try_from_tuple_maybe = maybe_with_tuple.to_try()

    # Convert the None-based Maybe to Either again (second call)
    either_from_none_maybe_second = maybe_none.to_either()

    # Convert the tuple-based Maybe to an Either type
    either_from_tuple_maybe = maybe_with_tuple.to_either()

    # Convert the Try result (from tuple-based Maybe) to a lazy representation
    try_from_tuple_maybe.to_lazy()

