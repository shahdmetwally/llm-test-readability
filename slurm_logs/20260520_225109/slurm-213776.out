    # And we create another 'Maybe' object with input integer and input bool value
    maybe_other_data = module_0_maybe_alias.Maybe(input_int, input_bool)
    
    # Then we box the first 'Maybe' object
    boxed_input_data = maybe_input_data.to_box()

    # And we filter the second 'Maybe' object
    filtered_other_data = maybe_other_data.filter(maybe_other_data)

    # And we make filtering of the second 'Maybe' lazy
    lazy_filtered_data = maybe_other_data.to_lazy()

    # And we apply operation to the filtered 'Maybe' object with the first 'Maybe' object
    maybe_applied_data = filtered_other_data.ap(maybe_input_data)

    # And we filter the resultant 'Maybe' object after applying operation
    filtered_applied_data = filtered_other_data.filter(maybe_applied_data)

    # And we create a 'Maybe' object with a result of first boxing operation and result of filtering operation
    maybe_boxed = module_0_maybe_alias.Maybe(lazy_filtered_data, boxed_input_data)

    # Then we verify if the value is equal to bool value
    is_equal = lazy_filtered_data == input_bool

    # This assertion must hold
    assert is_equal   


