        post_process_response:  import pytest
import module as module_0
import immutable_list as immutable_list

def test_case_unshift_on_immutable_list():
    """Testing the unshift operation on ImmutableList"""

    # Instantiate parameters
    none_type = None

    # Instantiate ImmutableList objects with none_type values
    immutable_list_0 = module_0.ImmutableList(none_type, none_type) 
    immutable_list_1 = immutable_list_0.unshift(none_type)

    # Check that the unshift operation changes the last element of the list
    assert immutable_list_1.last == none_type

    # Check that the unshift operation does not change the initial list
    assert immutable_list_1.initial == immutable_list_0.initial

    # Check that unshift operation produces a new list
    assert immutable_list_0 is not immutable_list_1

    # Check that the unshift operation creates an ImmutableList object when applicable
    assert isinstance(immutable_list_1, module_0.ImmutableList)   


