import pytest
import namedtupleutils as namedtuple_utils
import collections as collections_module

def test_to_namedtuple_with_negative_float():
    """Test that to_namedtuple handles a negative float value without error."""
    negative_float = -476.66
    namedtuple_utils.to_namedtuple(negative_float)

def test_to_namedtuple_with_tuple_containing_set_of_floats():
    """Test that to_namedtuple can handle a tuple containing a set of floats."""
    float_value = -67.0
    set_of_floats = {float_value, float_value, float_value, float_value}
    tuple_containing_set = (float_value, set_of_floats)
    var_0 = namedtuple_utils.to_namedtuple(tuple_containing_set)
    namedtuple_utils.to_namedtuple(set_of_floats)

def test_namedtuple_round_trip_preserves_structure():
    """Test that converting a dict to a namedtuple and back yields the same structure."""
    key = "author"
    # Create a dict with duplicate keys (last value wins in Python)
    input_dict = {key: key, key: key, key: key}
    namedtuple_result = namedtuple_utils.to_namedtuple(input_dict)
    second_conversion_result = namedtuple_utils.to_namedtuple(namedtuple_result)

