def test_immutable_list_reduce_on_list_with_head_and_is_empty_true():
    """
    Test that calling reduce() on an ImmutableList constructed with a value
    and is_empty=True uses the result of to_list() as both arguments.
    Also exercises constructing an ImmutableList with only a tail keyword argument.
    """
    is_empty_flag = True
    empty_tail = {}

    # Create an ImmutableList with only a tail (no head); serves as a secondary fixture
    immutable_list_with_tail_only = immutable_list.ImmutableList(tail=empty_tail)

    # Create an ImmutableList with a head value and is_empty explicitly set to True
    immutable_list_with_head = immutable_list.ImmutableList(is_empty_flag, is_empty=is_empty_flag)

    # Convert the list to a plain Python list to use as reduce arguments
    converted_list = immutable_list_with_head.to_list()

    # Call reduce using the converted list as both the initial value and the function
    immutable_list_with_head.reduce(converted_list, converted_list)
```
Stream finished.
