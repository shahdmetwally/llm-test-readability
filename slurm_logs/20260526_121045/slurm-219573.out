    # Apply None as the function argument; result is a new Maybe-like container
    ap_result = maybe_instance.ap(none_value)

    # Convert through lazy and validation representations
    lazy_result = ap_result.to_lazy()
    validation_result = lazy_result.to_validation()

    # Filter the original Maybe using the validation result as a predicate
    filtered_result = maybe_instance.filter(validation_result)

    # Retrieve the value or fall back to the filtered result itself
    unwrapped_or_fallback = filtered_result.get_or_else(filtered_result)

    # Convert the filtered Maybe to an Either
    either_result = filtered_result.to_either()

    # Convert the validation result to a Try
    try_result = validation_result.to_try()

    # Check equality between the filtered result and the ap result
    are_equal = filtered_result.__eq__(ap_result)

    # Wrap the fallback value in a Box
    boxed_value = unwrapped_or_fallback.to_box()

    # Apply raw bytes to the Try container (exercises ap on Try with a non-callable)
    try_result.ap(raw_bytes)   


