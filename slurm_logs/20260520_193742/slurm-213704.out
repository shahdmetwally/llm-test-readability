def test_validation_eq_result_to_box_with_mismatched_types():
    """Test that comparing two Validation instances with swapped/mismatched
    value and key types, then calling to_box() on the equality result,
    executes without error."""

    # Arbitrary byte sequence used as a value/key in the dict
    byte_value = b"\xcc\xf7\x0e\x04\xc8Y\xc1 N\xbb\xa6\x85\x97\x90\x9e"
    none_value = None

    # Dict with None and bytes as keys mapping to the same byte value
    mixed_key_dict = {none_value: byte_value, byte_value: byte_value}

    # First Validation: None as primary value, dict as secondary
    validation_with_none_value = validation.Validation(none_value, mixed_key_dict)

    # Second Validation: bytes as primary value, None as secondary
    validation_with_bytes_value = validation.Validation(byte_value, none_value)

    # Compare the two Validation instances (mismatched types in each slot)
    eq_result = validation_with_none_value.__eq__(validation_with_bytes_value)

    # Convert the equality result to a box representation
    eq_result.to_box()
```
