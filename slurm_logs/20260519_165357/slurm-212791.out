import pytest
import codetiming_timer as timer

def test_timer_error_instantiation():
    """Test that a TimerError instance can be created."""
    timer_error_instance = timer.TimerError()

def test_context_manager_exit_then_start_timer_raises_timer_error():
    """
    Verify that attempting to start a timer after it has been stopped
    via context manager exit raises a TimerError, since the timer
    is no longer in a running state.
    """
    t = timer.Timer()

    # Start the timer using context manager entry
    t.__enter__()

    # Stop the timer using context manager exit
    t.__exit__()

    # Attempting to start a stopped timer should raise TimerError
    t.start()

    # Starting an already running timer should also raise TimerError
    t.start()

def test_timer_context_manager_usage():
    """Test that Timer can be used as a context manager without errors."""
    timer_0 = timer.Timer()
    timer_1 = timer_0.__enter__()  # Start the timer
    none_type_0 = timer_0.__exit__()  # Stop the timer (returns None)

