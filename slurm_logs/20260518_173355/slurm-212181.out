        post_process_response:  def test_to_namedtuple_function():
    """" 
    This test case evaluates the to_namedtuple function. It calls this function
    with a list of tuples, and with the results of each application of this function.
    The function is also tested with a direct integer, expecting a ValueError to be raised.
    """

    s = "\x0cMv"
    empty_tuple = ()
    tuple_mapping = {s: empty_tuple, empty_tuple: s, empty_tuple: empty_tuple}
    tuple_1 = (s, tuple_mapping)
    list_with_tuple = [tuple_1]

    named_tuple_from_list = field_collection.to_namedtuple(list_with_tuple)
    named_tuple_from_nt = field_collection.to_namedtuple(named_tuple_from_list)
    named_tuple_from_nt2 = field_collection.to_namedtuple(named_tuple_from_nt)

    # Test function with direct integer
    int_val = 2

    with pytest.raises(ValueError):
        module_0.to_namedtuple(int_val)   


