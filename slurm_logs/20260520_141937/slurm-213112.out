```python
def test_immutable_list_reduce_with_to_list_result_as_both_arguments():
    """Test that reduce can be called on an ImmutableList using the result of to_list() as both arguments."""
    # Use True as a flag for both a positional value and the is_empty keyword argument
    is_empty_flag = True

    # An empty dict used as the tail of the first ImmutableList
    empty_dict_tail = {}

    # Construct an ImmutableList with a dict as its tail
    list_with_dict_tail = immutable_list.ImmutableList(tail=empty_dict_tail)

    # Construct an ImmutableList treating is_empty_flag as both the head value and the is_empty flag
    non_empty_immutable_list = immutable_list.ImmutableList(is_empty_flag, is_empty=is_empty_flag)

    # Convert the list to a plain Python list
    list_representation = non_empty_immutable_list.to_list()

    # Call reduce using the list representation as both the reducer function and the initial value
    non_empty_immutable_list.reduce(list_representation, list_representation)
```
</final_code>
