def test_timer_raises_error_when_started_while_already_running():
    """Test that starting an already-running timer (via context manager) raises a TimerError.

    The timer is entered as a context manager (which calls start internally),
    then explicitly exited, and then start() is called again on the inner
    reference to verify that double-starting raises an error.
    """
    # Create a new timer and enter the context manager (calls start internally)
    outer_timer = timer.Timer()
    inner_timer = outer_timer.__enter__()

    # Exit the context manager (calls stop internally)
    none_type_0 = outer_timer.__exit__()

    # Start the inner timer reference (which is the same object as outer_timer)
    none_type_1 = inner_timer.start()

    # Attempt to start the outer timer again while it is already running
    outer_timer.start()
```
