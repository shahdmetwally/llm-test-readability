import pyutils.moduleutils.maybe as m
import pyutils.moduleutils.either as e

def test_maybe_instance_created_correctly1():
    """Test the functionalities of the Maybe class"""
    
    # Set up
    none_input = None
    bool_input = True
    int_input = -1095
    maybe_instance_1 = m.Maybe(none_input, bool_input)
    set_0 = {bool_input}
    
    # Exercise
    var_0 = maybe_instance_1.map(set_0)
    maybe_instance_2 = m.Maybe(int_input, bool_input)
    var_1 = maybe_instance_2.to_either()
    
    # Verify
    assert var_0 == m.Maybe(None, False)
    assert var_1 == e.Left(int_input)   


