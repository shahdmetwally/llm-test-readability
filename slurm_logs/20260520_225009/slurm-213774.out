    """
    Test if a namedtuple results in the same namedtuple after conversion.
    """
    test_dict = {"a": 1, "b": 2}
    test_nt = collections_module.namedtuple("Test", ["a", "b"])(**test_dict)
    converted_nt = nt_utils.to_namedtuple(test_nt)
    assert converted_nt == test_nt   


