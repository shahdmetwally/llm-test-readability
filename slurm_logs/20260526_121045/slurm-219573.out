def test_maybe_equality_and_conversion_chain():
    """Test that a Maybe created with False values supports equality check
    and can be chained through to_try() and to_validation() without error."""

    # Create a Maybe wrapping two False values
    false_value = False
    maybe_instance = maybe.Maybe(false_value, false_value)

    # Verify equality of the Maybe instance with itself
    is_equal = maybe_instance.__eq__(maybe_instance)

    # Convert Maybe to Try, then to Validation
    try_instance = maybe_instance.to_try()
    try_instance.to_validation()
