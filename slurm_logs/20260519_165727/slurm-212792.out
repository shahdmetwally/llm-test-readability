import pytest
import codetiming_timer as timer

def test_TimerError_instantiation_without_arguments() -> None:
    """Test that TimerError can be created without arguments."""
    timer_error = timer.TimerError()

def test_timer_restart_after_context_manager_raises_timer_error():
    """Test that starting a timer after using it as a context manager raises TimerError."""
    # Create a timer and use it as a context manager
    timer_0 = timer.Timer()
    timer_1 = timer_0.__enter__()
    none_type_0 = timer_0.__exit__()
    
    # Attempt to start the timer again - should raise TimerError
    none_type_1 = timer_1.start()
    timer_0.start()

def test_timer_context_manager_enters_and_exits():
    """Test that entering and exiting a Timer context manager works without errors."""
    # Create a new Timer instance
    timer_0 = timer.Timer()
    # Start the timer using the context manager's __enter__ method
    timer_1 = timer_0.__enter__()
    # Stop the timer using the context manager's __exit__ method
    none_type_0 = timer_0.__exit__()

