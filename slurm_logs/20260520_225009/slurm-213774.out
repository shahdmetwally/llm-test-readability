    """Test that Codetiming Timer object's operations (i.e., start, stop, length) are performing correctly."""
    start_timer = Timer()
    create_empty_list = Timer()
    length = Timer()
    
    start_timer.start()
    create_empty_list.start()
    length.start()
    
    assert start_timer.start_time is not None, "Starting the timer does not set the start time correctly"
    
    start_timer.stop()
    create_empty_list.stop()
    length.stop()
    
    assert start_timer.start_time is None, "Stopping the timer does not set the start time back to None"
    
    assert start_timer.last is not None, "Stopping the timer does not calculate the elapsed time"   


