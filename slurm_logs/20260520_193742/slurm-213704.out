def test_immutable_list_reduce_with_converted_list_as_both_arguments():
    """
    Test that ImmutableList.reduce() can be called with the result of to_list()
    used as both the accumulator and the iterable arguments.
    A non-empty ImmutableList is constructed with a truthy 'is_empty' flag,
    and a separate ImmutableList is constructed with an empty dict as its tail.
    """
    is_empty_flag = True
    empty_tail = {}

    # Create an ImmutableList with an empty dict as its tail (head defaults to None)
    immutable_list_with_empty_tail = immutable_list.ImmutableList(tail=empty_tail)

    # Create an ImmutableList with a truthy value and is_empty=True
    non_empty_list = immutable_list.ImmutableList(is_empty_flag, is_empty=is_empty_flag)

    # Convert the non-empty list to a plain Python list
    converted_list = non_empty_list.to_list()

    # Call reduce using the converted list as both the initial accumulator and the sequence
    non_empty_list.reduce(converted_list, converted_list)
```
Stream finished.
