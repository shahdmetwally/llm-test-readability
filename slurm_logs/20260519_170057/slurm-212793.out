def test_to_namedtuple_with_nested_dicts_and_booleans():
    """Test that to_namedtuple handles nested conversions with dicts, tuples, booleans, and repeated keys."""
    # A long docstring about path normalization (used as a key/value in dict)
    path_docstring = "Normalize a given path.\n\n    The given ``path`` will be normalized in the following process.\n\n    #. :obj:`bytes` will be converted to a :obj:`str` using the encoding\n       given by :obj:`getfilesystemencoding() <sys.getfilesystemencoding>`.\n    #. :obj:`PosixPath <pathlib.PosixPath>` and\n       :obj:`WindowsPath <pathlib.WindowsPath>` will be converted\n       to a :obj:`str` using the :obj:`as_posix() <pathlib.PurePath.as_posix>`\n       method.\n    #. An initial component of ``~`` will be replaced by that user’s\n       home directory.\n    #. Any environment variables will be expanded.\n    #. Non absolute paths will have the current working directory from\n       :obj:`os.getcwd() <os.cwd>`prepended.  If needed, use\n       :obj:`os.chdir() <os.chdir>` to change the current working directory\n       before calling this function.\n    #. Redundant separators and up-level references will be normalized, so\n       that ``A//B``, ``A/B/``, ``A/./B`` and ``A/foo/../B`` all become\n       ``A/B``.\n\n    Args:\n        path (:obj:`str`, :obj:`bytes` or :obj:`Path <pathlib.Path>`):\n            The path to be normalized.\n\n    :rtype:\n        :obj:`Path <pathlib.Path>`\n\n        * :obj:`PosixPath <pathlib.PosixPath>` or\n          :obj:`WindowsPath <pathlib.WindowsPath>` depending on the system.\n\n        .. Note:: :obj:`Path <pathlib.Path>` objects are immutable. Therefore,\n           any given ``path`` of type :obj:`Path <pathlib.Path>` will not be\n           the same object returned.\n\n    Example:\n\n        >>> from flutils.pathutils import normalize_path\n        >>> normalize_path('~/tmp/foo/../bar')\n        PosixPath('/home/test_user/tmp/bar')\n\n    "
    # Create a dict with the same string used as both keys and values
    dict_with_repeated_string = {path_docstring: path_docstring, path_docstring: path_docstring, path_docstring: path_docstring}
    # Convert dict to namedtuple
    namedtuple_from_dict = namedtuple_utils.to_namedtuple(dict_with_repeated_string)
    # Another conversion from the same dict for comparison
    bool_false = False
    second_namedtuple_from_dict = namedtuple_utils.to_namedtuple(dict_with_repeated_string)
    # Wrap in a tuple and convert again
    tuple_wrapping_namedtuple = (second_namedtuple_from_dict,)
    namedtuple_from_tuple = namedtuple_utils.to_namedtuple(tuple_wrapping_namedtuple)
    # Create a dict with a namedtuple key and a boolean key, both pointing to a namedtuple value
    mixed_key_dict = {namedtuple_from_tuple: second_namedtuple_from_dict, bool_false: second_namedtuple_from_dict}
    namedtuple_from_mixed_dict = namedtuple_utils.to_namedtuple(mixed_key_dict)
    # Convert the namedtuple (from the mixed dict) itself into a namedtuple
    namedtuple_from_namedtuple = namedtuple_utils.to_namedtuple(namedtuple_from_mixed_dict)
    # Another conversion from the same source name
    bool_false_again = False
    another_namedtuple_from_namedtuple = namedtuple_utils.to_namedtuple(namedtuple_from_mixed_dict)
    # Convert a plain boolean (False) to a namedtuple
    namedtuple_utils.to_namedtuple(bool_false_again)
```
Stream finished.
