def test_validation_str_returns_failing_result():
    """Verify that __str__() on a Validation instance returns a failing result."""
    empty_dict = {}
    validation = validator.Validation(empty_dict, empty_dict)
    str_result = validation.__str__()
    str_result.is_fail()

