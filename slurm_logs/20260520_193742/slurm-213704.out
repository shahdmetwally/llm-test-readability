    value and metadata types, then calling to_box() on the result, executes
    without error and preserves the expected call chain behaviour.
    """
    # Arbitrary byte sequence used as a value in one Validation and metadata in another
    raw_bytes = b"\xcc\xf7\x0e\x04\xc8Y\xc1 N\xbb\xa6\x85\x97\x90\x9e"
    none_value = None

    # dict with mixed key types: None -> bytes, bytes -> bytes
    metadata_dict = {none_value: raw_bytes, raw_bytes: raw_bytes}

    # First Validation: None as value, dict as metadata
    validation_none_value = validation.Validation(none_value, metadata_dict)

    # Second Validation: bytes as value, None as metadata
    validation_bytes_value = validation.Validation(raw_bytes, none_value)

    # Compare the two mismatched Validation instances
    eq_result = validation_none_value.__eq__(validation_bytes_value)

    # Call to_box() on the equality result
    eq_result.to_box()
