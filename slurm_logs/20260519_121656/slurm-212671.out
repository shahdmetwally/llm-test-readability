    """Test transformation of a tuple into a namedtuple."""
    # Define Input Values
    float_0 = -67.0
    set_0 = {float_0, float_0, float_0, float_0}
    tuple_0 = (float_0, set_0)

    # Apply transformation using 'to_namedtuple' function
    var_0 = nt_utils.to_namedtuple(tuple_0)
    # Check namedtuple was created correctly
    assert isinstance(var_0, collections.namedtuple)
    assert var_0._fields == ('float', 'set')
    assert var_0.float == float_0
    assert var_0.set == set_0

    # Try transforming a set into a namedtuple
    with pytest.raises(TypeError):
        nt_utils.to_namedtuple(set_0)   


