```python
def test_maybe_monad_chained_operations_with_none_and_bytes_values():
    """Test that Maybe monad chained operations (ap, bind, to_validation, to_either, to_try, get_or_else) execute without error across Nothing-like and Just-like instances."""

    # --- Setup shared primitive values ---
    raw_bytes_value = b"\xdbC\xcf\xe7/"
    none_value = None
    true_flag = True

    # --- Build a Nothing-like Maybe (value is None) and chain ap operations ---
    maybe_nothing = maybe.Maybe(none_value, true_flag)
    ap_result_none = maybe_nothing.ap(none_value)          # apply None as function
    ap_result_bytes = ap_result_none.ap(raw_bytes_value)   # apply bytes as function
    validation_from_nothing = ap_result_bytes.to_validation()  # convert chain to Validation

    # --- Build a Just-like Maybe (value is bytes) ---
    maybe_just_bytes = maybe.Maybe(none_value, raw_bytes_value)

    # --- Exercise get_or_else, to_validation, and bind on the Just-like Maybe ---
    get_or_else_result = maybe_just_bytes.get_or_else(maybe_just_bytes)   # fallback to itself
    validation_from_just = maybe_just_bytes.to_validation()               # convert to Validation
    bind_result = maybe_just_bytes.bind(validation_from_just)             # bind using the Validation

    # --- Convert to Either and apply ap with self ---
    either_result = maybe_just_bytes.to_either()
    ap_maybe_on_maybe = maybe_just_bytes.ap(maybe_just_bytes)             # apply maybe to itself

    # --- Cross-type equality and bind on Either ---
    negative_int_value = -3289
    either_eq_validation = either_result.__eq__(validation_from_just)     # compare Either to Validation
    either_bind_result = either_result.bind(maybe_just_bytes)             # bind maybe into either

    # --- Convert to Try and verify equality with bind result ---
    try_result = maybe_just_bytes.to_try()
    maybe_eq_bind = maybe_just_bytes.__eq__(bind_result)                  # compare maybe to bind result
    bind_to_validation = bind_result.to_validation()                      # convert bind result to Validation

    # --- Apply a negative integer to the Try result ---
    try_result.ap(negative_int_value)
```
