def test_filter_on_none_value_maybe_returns_lazy_and_filters_again():
    """
    Test that filtering a Maybe wrapping None with a tuple value produces
    a lazy result, and that a second Maybe wrapping None can filter using
    that lazy result without error.
    """
    sentinel_int = -283
    filter_tuple = (sentinel_int, sentinel_int, sentinel_int)

    none_value = None
    flag_true = True

    # Create a Maybe wrapping None with a truthy flag, then filter with the tuple
    maybe_none_true = maybe.Maybe(none_value, flag_true)
    filter_result = maybe_none_true.filter(filter_tuple)

    # Convert the filter result to a lazy representation
    lazy_result = filter_result.to_lazy()

    none_value_2 = None

    # Create a second Maybe wrapping None (no flag), then filter using the lazy result
    maybe_none_none = maybe.Maybe(none_value_2, none_value_2)
    maybe_none_none.filter(lazy_result)
