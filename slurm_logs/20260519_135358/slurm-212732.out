    """
    Ensures Timer's enter and exit methods behave correctly
    """

    # Given
    timer = timer.Timer()  # create new timer

    # When
    enter_result = timer.__enter__()  # enter the timer
    exit_result = timer.__exit__()  # exit the timer

    # Then
    assert enter_result == timer  # check that the enter method returns itself
    assert exit_result is None  # check that the exit method returns nothing   


