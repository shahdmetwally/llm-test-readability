def test_maybe_chained_operations_with_string_value():
    """
    Test that a Maybe monad correctly handles chained operations
    (ap, map, filter, bind, to_validation, to_either) when constructed
    with a string value, verifying that derived Maybe instances behave
    consistently across equality checks and transformations.
    """
    input_value = "p4xa>bl^oP"

    # Create a Maybe wrapping the input string
    maybe_instance = maybe.Maybe(input_value, input_value)

    # Check equality of the Maybe with the raw string
    is_equal_to_str = maybe_instance.__eq__(input_value)

    # Apply ap, get_or_else, map, and filter on the initial Maybe
    ap_result = maybe_instance.ap(input_value)
    fallback_value = maybe_instance.get_or_else(input_value)
    mapped_result = maybe_instance.map(is_equal_to_str)
    filtered_result = maybe_instance.filter(is_equal_to_str)

    # Repeat map and ap to produce additional derived values
    mapped_result_2 = maybe_instance.map(is_equal_to_str)
    ap_result_2 = maybe_instance.ap(input_value)

    # Compare two ap results for equality
    ap_results_equal = ap_result.__eq__(ap_result_2)

    # Filter and get_or_else on derived ap results
    filtered_ap = ap_result.filter(fallback_value)
    ap_fallback = ap_result_2.get_or_else(input_value)

    # Create a second Maybe instance with the same input and convert to validation
    maybe_instance_2 = maybe.Maybe(input_value, input_value)
    validation = maybe_instance_2.to_validation()

    # Bind the validation result and convert to either
    bound_result = maybe_instance_2.bind(validation)
    either_result = bound_result.to_either()
```
Stream finished.
