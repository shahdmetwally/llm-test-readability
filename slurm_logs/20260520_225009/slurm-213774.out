    """Testing the timing functionality"""
    # Number of iterations for timewaste
    num_iteration = 939

    # Decorated timewaste function with codetiming
    timewaste_decorated = codetiming.eager(codetiming.Timer(num_iteration))

    # Assert that decorated timewaste works properly
    assert codetiming.debug(timewaste_decorated) is not None
    assert codetiming.debug(codetiming.eager(timewaste_decorated)) is None

    # Check that the Timer doesn't blow up for unsupported log level
    assert codetiming.warn(num_iteration) is None

    # Check that get_source has successfully been imported and calls the function
    assert "get_source" in codetiming.get_source(timewaste_decorated)   


