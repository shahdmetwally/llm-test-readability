def test_maybe_bind_map_then_invalid_method_on_set():
    """
    Tests that chaining bind and map on a Maybe works as expected,
    and that calling a non-existent method (to_box) on a plain set raises AttributeError.
    """
    # Create a Maybe wrapping True for both value and is_just flag
    is_just = True
    maybe_value = maybe.Maybe(is_just, is_just)

    # Bind a value through the Maybe monad
    bound_result = maybe_value.bind(is_just)

    # Map over the bound result
    mapped_result = bound_result.map(is_just)

    # Create a tuple to use as a wrapped value in a new Maybe
    tuple_value = (is_just, is_just, is_just, is_just)
    maybe_tuple = maybe.Maybe(tuple_value, is_just)

    # Attempt to call a non-existent method on a plain set, expected to raise AttributeError
    empty_set = set()
    empty_set.to_box()
```
Stream finished.
