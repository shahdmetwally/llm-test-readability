    # Create a Timer instance
    timer = timer_module.Timer()

    # Timer is not initially running
    assert timer.start_time is None

    # Enter and exit context manager for the Timer instance
    timer.__enter__()
    timer.__exit__()

    # After __exit__, the timer stops, causing start_time to become None
    assert timer.start_time is None

    # Start the timer
    timer.start()

    # Check if start_time is not None
    assert timer.start_time is not None   


