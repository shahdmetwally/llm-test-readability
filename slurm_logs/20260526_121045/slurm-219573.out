def test_maybe_map_with_none_value_and_to_either_conversion():
    """
    Test that Maybe.map() can be called with a set as the mapping argument
    when the wrapped value is None, and that Maybe.to_either() can be called
    on a Maybe wrapping an integer value.
    """
    # Create a Maybe wrapping None with is_some=True
    none_value = None
    is_some = True
    maybe_with_none = maybe.Maybe(none_value, is_some)

    # Attempt to map over the Maybe using a set as the mapping callable
    mapping_set = {is_some}
    map_result = maybe_with_none.map(mapping_set)

    # Create a Maybe wrapping an integer value with is_some=True
    int_value = -1095
    is_some_2 = True
    maybe_with_int = maybe.Maybe(int_value, is_some_2)

    # Convert the integer-wrapping Maybe to an Either type
    either_result = maybe_with_int.to_either()
```
