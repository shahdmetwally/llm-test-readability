def test_maybe_chained_ap_bind_and_conversions_with_none_and_bytes():
    """
    Tests chained operations on Maybe instances constructed with None and bytes values.
    Verifies that ap, bind, get_or_else, to_validation, to_either, and to_try
    behave correctly when the Maybe wraps None or a bytes payload.
    """
    raw_bytes = b"\xdbC\xcf\xe7/"
    none_value = None
    flag = True

    # Create a Maybe wrapping None with a True flag, then chain ap calls
    maybe_none_true = maybe.Maybe(none_value, flag)
    ap_none = maybe_none_true.ap(none_value)
    ap_bytes = ap_none.ap(raw_bytes)
    validation_from_ap_chain = ap_bytes.to_validation()

    # Create a Maybe wrapping None with a bytes value
    maybe_none_bytes = maybe.Maybe(none_value, raw_bytes)

    # Exercise get_or_else, to_validation, bind, to_either, and ap on maybe_none_bytes
    get_or_else_result = maybe_none_bytes.get_or_else(maybe_none_bytes)
    validation_from_none_bytes = maybe_none_bytes.to_validation()
    bind_result = maybe_none_bytes.bind(validation_from_none_bytes)
    either_result = maybe_none_bytes.to_either()
    ap_self_result = maybe_none_bytes.ap(maybe_none_bytes)

    # Exercise operations on the either and bind results
    negative_int = -3289
    eq_either_validation = either_result.__eq__(validation_from_none_bytes)
    bind_either_with_maybe = either_result.bind(maybe_none_bytes)
    try_result = maybe_none_bytes.to_try()
    eq_maybe_bind = maybe_none_bytes.__eq__(bind_result)
    validation_from_bind = bind_result.to_validation()

    # ap on the Try result with a negative integer
    try_result.ap(negative_int)
```
