        post_process_response:  def test_timer_start_stop():
    """
    This test case tests if the Timer.start() method starts recording.
    It uses Python's time.perf_counter() to measure the time taken and compares 
    it with the recorded time by the Timer.
    """
    timer = timer.Timer() # Create new instance of Timer
    timer.start() # Start timer

    waste_time = lambda n: list(i**2 for i in range(n))
    waste_time(1000) # Waste some time to ensure timer is running

    elapsed_time = timer.stop() # Stop timer and get elapsed time
    
    # Check if the timer is running
    assert timer._start_time is None, "Timer was not stopped"

    # Check if the elapsed time is close to the actual elapsed time
    time_taken_perf_counter = time.perf_counter() - timer._start_timer
    assert abs(elapsed_time - time_taken_perf_counter) < 0.001, "Elapsed time does not match with performance counter"

    # Check if Timer was recorded in timers dict
    assert timer.name in timer.timers, "Timer not recorded in timers dict"   


