def test_maybe_ap_with_none_chains_through_lazy_validation_and_either():
    """
    Test that a Maybe constructed with None and True correctly chains through
    ap, to_lazy, to_validation, filter, to_either, to_try, and to_box
    without raising errors, and that equality comparison with an ap result works.
    """
    raw_bytes = b"C\xcf\xe7/"
    none_value = None
    is_present = True

    # Create a Maybe wrapping None with a truthy flag
    maybe_instance = maybe.Maybe(none_value, is_present)

    # Apply None as an applicative — result is a Maybe with no function applied
    ap_result = maybe_instance.ap(none_value)

    # Convert the ap result to a lazy representation
    lazy_value = ap_result.to_lazy()

    # Convert the lazy value to a validation
    validation_value = lazy_value.to_validation()

    # Filter the original Maybe using the validation as the predicate
    filtered_maybe = maybe_instance.filter(validation_value)

    # Retrieve the value or fall back to the filtered Maybe itself
    unwrapped_or_default = filtered_maybe.get_or_else(filtered_maybe)

    # Convert the filtered Maybe to an Either
    either_value = filtered_maybe.to_either()

    # Convert the validation to a Try
    try_value = validation_value.to_try()

    # Check equality between the filtered Maybe and the ap result
    are_equal = filtered_maybe.__eq__(ap_result)

    # Wrap the unwrapped value in a Box
    boxed_value = unwrapped_or_default.to_box()

    # Apply raw bytes to the Try value
