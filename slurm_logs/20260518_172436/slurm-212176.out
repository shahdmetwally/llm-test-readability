def test_to_namedtuple_with_duplicate_keys_and_namedtuple_input():
    """Test that to_namedtuple handles a dict with duplicate keys and
    that passing the resulting namedtuple back into to_namedtuple works correctly."""

    # A dict with duplicate keys collapses to a single key "author"
    author_key = "author"
    author_dict = {author_key: author_key, author_key: author_key, author_key: author_key}

    # Convert the dict to a namedtuple
    namedtuple_from_dict = namedtupleutils.to_namedtuple(author_dict)

    # Convert the already-converted namedtuple back to a namedtuple (idempotent behaviour)
    namedtuple_from_namedtuple = namedtupleutils.to_namedtuple(namedtuple_from_dict)
```
Stream finished.
