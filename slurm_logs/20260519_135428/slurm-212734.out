    # Given that we have a Timer
    timer_1 = module_timer.Timer()
    # When we enter the context of the timer
    timer_1.__enter__()
    # And we call eq on this timer (which means checking if it is the same as the timer itself)
    timer_1_equals_self = timer_1.__eq__(timer_1)
    # And we exit this context, we get None
    exit_status = timer_1.__exit__()
    # Then we should have a Timer with an initial_text as timer_1 and a logger as timer_1_equals_self
    timer_2 = module_timer.Timer(initial_text=timer_1, logger=timer_1_equals_self)
    # And another timer with the same initial_text and logger
    timer_3 = module_timer.Timer(timer_1, initial_text=timer_2, logger=timer_1_equals_self)
