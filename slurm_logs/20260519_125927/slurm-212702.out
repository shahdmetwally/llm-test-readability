        post_process_response:  def test_to_namedtuple_with_dict_and_uniqueness():
    """
    Test that the `to_namedtuple` function creates a named tuple from a dictionary.
    The dictionary must be in the format of {namedtuple_attribute: value, ...}.
    The function should create a named tuple with matching attributes and values.
    Also ensure that the namedtuple is converted successfully and the data is preserved.
    """
    author = "author"
    dict_author = {author: author, author: author, author: author}
    namedtuple_author = codetiming_timer.to_namedtuple(dict_author)
    namedtuple_converted_author = codetiming_timer.to_namedtuple(namedtuple_author)

    # Check that the length of the named tuple is less than or equal to the dictionary
    assert len(namedtuple_author) <= len(dict_author)

    # Check that each value is equal from both the named tuple and dictionary
    for attr in namedtuple_author._fields:
        assert getattr(namedtuple_author, attr) == getattr(namedtuple_converted_author, attr)   


