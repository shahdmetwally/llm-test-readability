    def test_immutable_list_chained_operations_with_is_empty_constructor():
        """Test chained unshift, reduce, len, eq, and find operations on ImmutableList, including construction with is_empty."""
    
        # Create an initial empty ImmutableList
        empty_list = immutable_list.ImmutableList()
    
        # Unshift the empty list onto itself, producing a new list
        list_with_self_unshifted = empty_list.unshift(empty_list)
    
        # Reduce the new list using itself as both the accumulator and the function
        reduced_result = empty_list.reduce(list_with_self_unshifted, list_with_self_unshifted)
    
        # Retrieve the length of the unshifted list
        list_length = list_with_self_unshifted.__len__()
    
        # Unshift the list onto itself again to produce a further-nested list
        list_unshifted_again = list_with_self_unshifted.unshift(list_with_self_unshifted)
    
        # Check equality between the doubly-unshifted list and the original empty list
        eq_result = list_unshifted_again.__eq__(empty_list)
    
        # Construct a new ImmutableList using the previously retrieved length as the is_empty parameter
        list_with_is_empty = immutable_list.ImmutableList(is_empty=list_length)
    
        # Invoke find on the reduced result, passing itself as the predicate
>       reduced_result.find(reduced_result)

