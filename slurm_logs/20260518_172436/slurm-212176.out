    str_keyed_dict = {path_docstring: path_docstring}
    namedtuple_from_str_dict = namedtupleutils.to_namedtuple(str_keyed_dict)

    bool_false_0 = False

    # Convert the same dict again (repeated conversion should be stable)
    namedtuple_from_str_dict_again = namedtupleutils.to_namedtuple(str_keyed_dict)

    # Wrap the namedtuple in a tuple and convert that tuple to a namedtuple
    tuple_wrapping_namedtuple = (namedtuple_from_str_dict_again,)
    namedtuple_from_tuple = namedtupleutils.to_namedtuple(tuple_wrapping_namedtuple)

    # Build a dict using namedtuples and a bool as keys/values, then convert
    mixed_key_dict = {namedtuple_from_tuple: namedtuple_from_str_dict_again, bool_false_0: namedtuple_from_str_dict_again}
    namedtuple_from_mixed_dict = namedtupleutils.to_namedtuple(mixed_key_dict)

    # Convert an already-converted namedtuple (idempotency check)
    namedtuple_from_namedtuple = namedtupleutils.to_namedtuple(namedtuple_from_mixed_dict)

    bool_false_1 = False

    # Convert the mixed-key namedtuple a second time
    namedtuple_from_mixed_dict_again = namedtupleutils.to_namedtuple(namedtuple_from_mixed_dict)

    # Convert a plain boolean scalar (edge case: non-collection input)
    namedtupleutils.to_namedtuple(bool_false_1)

def test_to_namedtuple_with_nested_structures_and_repeated_conversion():
    """Test that to_namedtuple handles nested structures (list containing a tuple
    with a string key and dict value), repeated conversion of already-converted
    results, and a plain integer input without raising errors."""

    # Build a dict with mixed key types (string and tuple) mapping to various values
    key_str = "\x0cMv"
    empty_tuple = ()
    mixed_dict = {key_str: empty_tuple, empty_tuple: key_str, empty_tuple: empty_tuple}

    # Wrap the string and dict together in a tuple, then place it in a list
    nested_entry = (key_str, mixed_dict)
    input_list = [nested_entry]

    # Convert the nested list structure to a namedtuple
    converted_once = namedtupleutils.to_namedtuple(input_list)

    # Re-convert the already-converted result (idempotency check)
    converted_twice = namedtupleutils.to_namedtuple(converted_once)

    # Re-convert a third time to further verify stability
    converted_thrice = namedtupleutils.to_namedtuple(converted_twice)

    # Verify that a plain integer is also handled without error
    plain_int = 2
    namedtupleutils.to_namedtuple(plain_int)

def test_to_namedtuple_with_duplicate_bytes_keys():
    """Test that to_namedtuple handles a dict with repeated bytes keys without error."""
    # A bytes object used as the sole (repeated) key and value in the dict
    bytes_key = b"F\xdb\xfdf\x8a\xe4\n\xa2\x1d[\xdc*\xa3\xba\xf6s}"

    # Dict with duplicate keys (Python retains only one entry); all map bytes -> bytes
    bytes_keyed_dict = {bytes_key: bytes_key, bytes_key: bytes_key, bytes_key: bytes_key}

    # Convert the dict to a namedtuple; verifies no exception is raised
    namedtupleutils.to_namedtuple(bytes_keyed_dict)
