def test_maybe_get_or_else_and_filter_with_generic():
    """
    Test that Maybe.get_or_else returns the wrapped value when present,
    and that Maybe.filter can be called with a retrieved value.
    Also verifies to_box() and filter() on a Maybe wrapping a Generic instance.
    """
    default_int = 2281
    key_str = "gZ(\\mOcN"

    # Build a tuple payload containing strings and dicts
    inner_dict = {key_str: key_str}
    payload_tuple = (key_str, key_str, inner_dict, inner_dict)

    # Create a Maybe with a truthy presence flag, then retrieve or fall back to default
    is_present = True
    maybe_with_tuple = maybe.Maybe(payload_tuple, is_present)
    retrieved_value = maybe_with_tuple.get_or_else(default_int)

    # Create a Generic instance to wrap in a second Maybe
    generic_instance = typing.Generic()

    # Convert the first Maybe to a box representation
    is_absent = False
    boxed_value = maybe_with_tuple.to_box()

    # Create a Maybe wrapping the Generic instance with a falsy presence flag
    maybe_with_generic = maybe.Maybe(generic_instance, is_absent)

    # Filter the generic Maybe using the value retrieved from the first Maybe
    maybe_with_generic.filter(retrieved_value)
```
