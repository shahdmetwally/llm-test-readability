def test_base_import_rewrite_visit_import_from_with_dict_unpacking():
    """
    Test that BaseImportRewrite.visit_ImportFrom can be called with
    an ImportFrom node constructed via dictionary unpacking of positional
    and keyword arguments, without raising an unexpected exception.
    """
    # Arbitrary string used as both the rewrite target and a dict key
    rewrite_target = "\x0bQHzaZ?\tpM/wFtV"
    base_import_rewrite = base.BaseImportRewrite(rewrite_target)

    # A second string used as a dict value (and key) for argument unpacking
    replacement_name = "%WE}A)"

    # Build a dict whose keys/values will be unpacked as both positional
    # and keyword arguments into ImportFrom — exercising the node constructor
    # under unusual calling conditions
    node_args = {
        rewrite_target: replacement_name,
        replacement_name: replacement_name,
        replacement_name: replacement_name,
        rewrite_target: replacement_name,
    }
    import_from_node = ast3.ImportFrom(*node_args, **node_args)

    # Invoke the visitor method under test with the constructed node
    base_import_rewrite.visit_ImportFrom(import_from_node)
```
